////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 sound(local_attack,0.4);
 play(attack,33);
 react(f,1);
 scenario(template_attack_splash_small);
 wait(0.95);
 scenario(global_smoke_med_legs);
}

$attack_left {
 sound(local_attack_left,0.6);
 play(attack_left,10);
 react(r,1);
 scenario(template_attack_splash_med);
 wait(1.1);
 scenario(global_smoke_med_leg_r);
}

$attack_right {
 sound(local_attack_right,0.4);
 play(attack_right,20);
 react(l,1);
 scenario(template_attack_splash_med);
 scenario(global_smoke_med_legs);
}

$attack_uppercot {
 sound(local_attack_uppercut,0.4);
 play(attack_uppercot);
 react(u,1);
 scenario(template_attack_splash_big);
 scenario(global_smoke_med_legs);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
  	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 light(0,1.5);
 scenario(global_snd_mob2_direct);
 scenario(global_magic_direct_prestart_crystal);
 play(magic,25);
 react(f,0);
 wait(0.5);
 scenario(global_magic_direct_start_crystal);
 wait(0.15);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_crystal);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_crystal);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 light(0,1.5);
 scenario(global_snd_mob2_aoe);
 scenario(global_magic_aoe_prestart_crystal);
 play(magic_aoe,20);
 scenario(global_magic_aoe_start_crystal);
 wait(0.4);
 react(f,0);
 wait(0.5);
 scenario(global_magic_aoe_wave_crystal);
 wait(0.2);
 scenario(global_magic_direct_expsmall_crystal);
 light(1,1,0.3);
}

$magic_baf {
 light(0,1.5);
 scenario(global_snd_mob2_baf);
 scenario(global_magic_aoe_prestart_crystal);
 play(magic_baf,25);
 scenario(global_magic_baf_crystal);
 light(1,1,0.3);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 scenario(global_snd_mob2_block);
 play(block,20);
 vibration(1,2,0);
 scenario(global_react_block_sov);
}

$react_dodge {
 reactfx();
 scenario(global_snd_mob2_dodge);
 sound(local_dodge_steps,1.1);
 play(dodge,22);
 scenario(global_smoke_med_legs);
 wait(1.2);
 scenario(global_smoke_small_legs);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage);
}

$react_dmgf {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 wait(0.4);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(0.7);
 scenario(global_smoke_med_legs_crystal);
 wait(1.85);
 scenario(global_smoke_med_legs);
}

$react_dmgl {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 step(0,-1,0,3);
 wait(0.4);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(0.7);
 scenario(global_smoke_med_legs_crystal);
 wait(0.6);
 enemyscenario(ifx_step_r);
 wait(1.25);
 scenario(global_smoke_med_legs);
}

$react_dmgr {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 step(0,1,0,3);
 wait(0.4);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(0.7);
 scenario(global_smoke_med_legs_crystal);
 wait(0.6);
 enemyscenario(ifx_step_l);
 wait(1.25);
 scenario(global_smoke_med_legs);
}

$react_dmgu {scenario(react_dmgf);}

$react_death  { 
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 play(death);
 wait(1.6);
 scenario(global_smoke_small_arms);
 wait(1.5);
 scenario(global_smoke_big_torso);
 wait(0.5);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,0,0,0); 
}

$react_deathf {
 wait(0.45);
 reactfx();
 scenario(global_snd_mob2_death_force);
 play(death_force);
 scenario(global_smoke_fly);
 wait(0.4);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(0.5);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,-0.3,0,0);
}

$react_deathl {scenario(react_deathf);}
$react_deathr {scenario(react_deathf);}
$react_deathu {scenario(react_deathf);}

