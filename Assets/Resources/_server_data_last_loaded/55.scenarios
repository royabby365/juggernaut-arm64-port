////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

scenario(global_shai_ground_fx);

$attack {
 sound(local_attack,0.7);
 scenario(global_revun_ground_destroy);
 play(attack,40);
 react(f,1);
 scenario(template_attack_splash_small);
 wait(0.7);
 scenario(global_revun_ground);
 wait(0.1);
 scenario(global_revun_ground_fx_legs);
}

$attack_left {
 sound(local_attack_left,0.7);
 scenario(global_revun_ground_destroy);
 play(attack_left,25);
 react(r,1);
 scenario(global_smoke_small_arms);
 scenario(global_smoke_small_legs);
 scenario(template_attack_splash_med);
 wait(0.7);
 scenario(global_revun_ground);
 wait(0.4);
 scenario(global_revun_ground_fx_legs);
}

$attack_right {
 sound(local_attack_right,1.4);
 scenario(global_revun_ground_destroy);
 play(attack_right,40);
 react(l,1);
 scenario(template_attack_splash_med);
 wait(1);
 scenario(global_revun_ground);
 wait(0.15);
 scenario(global_revun_ground_fx_legs);
}

$attack_uppercot {
 scenario(global_snd_mob2_attack_uppercot);
 scenario(global_revun_ground_destroy);
 scenario(global_revun_ground_fx_legs);
 play(attack_uppercot,30);
 scenario(global_smoke_fly);
 react(l,1);
 scenario(template_attack_splash_big);
 wait(0.55);
 scenario(global_smoke_big_torso);
 wait(0.5);
 scenario(global_revun_ground);
 wait(0.25);
 scenario(global_revun_ground_fx_legs);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
  	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 light(0,1.5);
 scenario(global_snd_mob2_direct);
 scenario(global_magic_baf_revun_start);
 scenario(global_revun_ground_destroy);
 scenario(global_revun_ground_fx_legs);
 play(magic,45);
 react(f,0);
 wait(0.26);
 scenario(global_magic_direct_fly_revun);
 scenario(global_revun_ground);
 wait(0.1);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_revun);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_revun);
 ifnotreact#;
 wait(0.8);
 scenario(global_revun_ground_fx_legs);
 light(1,1,0.3);
}

$magic_aoe {
 light(0,2);
 scenario(global_snd_mob2_aoe);
 scenario(global_magic_baf_revun_start);
 scenario(global_revun_ground_destroy);
 play(magic_aoe,30);
 scenario(global_magic_aoe_revun_start);
 wait(0.4);
 react(f,0);
 wait(0.4);
 scenario(global_magic_aoe_wave_revun);
 wait(0.2);
 scenario(global_magic_aoe_exp_revun);
 wait(0.85);
 scenario(global_revun_ground);
 scenario(global_revun_ground_fx_legs);
 light(1,0.5,0);
}

$magic_baf {
 light(0,1.5);
 scenario(global_snd_mob2_baf);
 scenario(global_magic_baf_revun_start);
 scenario(global_revun_ground_destroy);
 play(magic_baf,34);
 scenario(global_magic_baf_revun);
 scenario(global_revun_ground_fx_legs);
 wait(1.2);
 scenario(global_revun_ground_fx_legs);
 wait(0.25);
 scenario(global_revun_ground);
 light(1,0.5,0);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 sound(local_block,0.5);
 play(block,25);
 vibration(1,2,0);
 scenario(global_react_block);
 scenario(global_revun_ground_fx_head);
 wait(0.7);
 scenario(global_revun_ground_fx_head);
}

$react_dodge {
 scenario(global_revun_ground_destroy);
 reactfx();
 scenario(global_snd_mob2_dodge);
 play(dodge);
 scenario(global_revun_ground);
 wait(0.4);
 scenario(global_revun_ground_fx_legs);
 wait(1.45);
 scenario(global_revun_ground_fx_head);
 wait(0.18);
 scenario(global_revun_ground_fx_head);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage,45);
 scenario(global_smoke_little_arms);
 wait(0.05);
 scenario(global_smoke_med_leg_l);
}

$react_dmgf {
 scenario(global_revun_ground_destroy);
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 scenario(global_revun_ground_fx_legs);
 wait(0.5);
 vibration(1,2,0);
 wait(0.05);
 scenario(global_revun_ground_fx_spine);
 wait(1.15);
 scenario(global_revun_ground);
}

$react_dmgl {
 scenario(global_revun_ground_destroy);
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 scenario(global_revun_ground_fx_legs);
 wait(0.1);
 step(0,-1,0,3);
 wait(0.2);
 vibration(1,2,0);
 wait(0.05);
 scenario(global_revun_ground_fx_spine);
 wait(1.45);
 scenario(global_revun_ground);
 enemyscenario(ifx_step_r);
}

$react_dmgr {
 scenario(global_revun_ground_destroy);
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 scenario(global_revun_ground_fx_legs);
 wait(0.1);
 step(0,1,0,3);
 wait(0.2);
 vibration(1,2,0);
 wait(0.05);
 scenario(global_revun_ground_fx_spine);
 wait(1.45);
 scenario(global_revun_ground);
 enemyscenario(ifx_step_l);
}

$react_dmgu {scenario(react_dmgf);}

$react_death {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 play(death);
 scenario(global_smoke_fly);
 scenario(global_revun_ground_fx_spine);
 wait(0.3);
 scenario(global_smoke_big_torso);
 scenario(global_revun_ground_destroy);
 wait(2.3);
 scenario(global_smoke_big_torso);
 scenario(global_revun_ground_fx_spine);
 wait(0.2);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,0,0,0);
}

$react_deathf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 play(death_force);
 scenario(global_smoke_fly);
 scenario(global_revun_ground_fx_legs);
 wait(1);
 scenario(global_revun_ground_destroy);
 wait(1.7);
 scenario(global_smoke_big_torso);
 wait(0.5);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,-0.3,0,0);
}

$react_deathl {scenario(react_death);}
$react_deathr {scenario(react_death);}
$react_deathu {scenario(react_death);}

////////////////////////////////////////////////////////////////////
// INDIVIDUAL EFFECTS
////////////////////////////////////////////////////////////////////

$ifx_step_r {
  step(1,-1,1);
}

$ifx_step_l {
  step(-1,1,1);
}

$ifx_blood {
 scenario(global_react_blood_beatle);
}

$ifx_blood_small {
 scenario(global_react_blood_small_beatle);
}

$ifx_blood_down_splash {
 fx(0,fx_blooddownsplat_Fl,pos_toe_r);
 wait(0.1);
 fx(0,fx_blooddownsplat_Fl,pos_toe_l);
}

$ifx_fatality_blood_splash {
 fx(0,fx_bloodsplat_Fl,pos_spinecenter);
 fx(fbs1,sfx_flesh_Fl,bottom);           fxpos(fbs1,0,1.55,0,1);
 wait(0.5);
 fx(0,fx_bloodsplat_Fl_2,bottom);
}

$ifx_blood_splash {
 fx(0,fx_bloodsplat_Fl,pos_spinecenter);
}

$ifx_blood_fontan {
 fx(0,fx_sizeblood_fl1,pos_head,1);
 fx(0,fx_sizeblood_fl1,pos_spinecenter,1);
 fx(0,fx_sizeblood_fl1,pos_hand_r,1);
 fx(0,fx_sizeblood_fl1,pos_hand_l,1);
 fx(0,fx_sizeblood_fl1,pos_toe_r,1);
 fx(0,fx_sizeblood_fl1,pos_toe_l,1);
}

$ifx_blood_screen {
 #random(25); fx(0,fx_bloodekran_Fl_L);  random#;
 #random(25); fx(0,fx_bloodekran_Fl_R);  random#;
 #random(50); fx(0,fx_bloodekran_Fl_RD); random#;
 #random(50); wait(0.05);                random#;
 #random(50); fx(0,fx_bloodekran_Fl_LD); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Fl_RU); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Fl_LU); random#;
}

$ifx_fatality_damage {
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
}

$ifx_fatality_fly {
 moveto(0,3,0.5,1);
 playpart(damage,0.65,0,20);
 playpart(damage,0.65,0,20);
 moveto(0,-3,-0.5,0.1); 
 playpart(death,1,10,100);
}

$ifx_fatality_down_blood {
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
}

//////////////////////////////
// TRIGGERS AND OTHER
//////////////////////////////

$onshow {
 scenario(global_onshow);
 scenario(global_revun_ground);
}

$onstart {
 scenario(global_revun_ground);
}

$onidle {
 wait(0.6);
 scenario(global_snd_mob2_idle);
}

$onhide {
 scenario(global_onhide);
 scenario(global_revun_ground_destroy);
}