////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 light(0,1.5);
 scenario(global_snd_mob2_direct);
 scenario(global_magic_baf_scolop_start);
 play(magic);
 wait(1.2);
 scenario(global_magic_direct_fly_jivoglot);
 react(f,0);
 wait(0.5);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_scolop);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_scolop);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 light(0,2);
 scenario(global_snd_mob2_aoe);
 scenario(global_magic_baf_scolop_start);
 play(magic_aoe,15);
 wait(0.35);
 react(f,0);
 wait(0.35);
 scenario(global_magic_aoe_wave_scolop);
 wait(0.2);
 scenario(global_magic_aoe_exp_scolop);
 light(1,0.5,0);
}

$magic_baf {
 light(0,2.5);
 scenario(global_snd_mob2_baf);
 scenario(global_magic_baf_scolop_start);
 play(magic_baf,35);
 scenario(global_magic_baf_scolop);
 wait(1);
 light(1,0.5,0);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 sound(local_block,0.2);
 play(block,35);
 vibration(1,2,0);
 scenario(global_react_block);
}

$react_dodge {
 reactfx();
 scenario(global_snd_mob2_dodge );
 scenario(global_smoke_fly);
 play(dodge,8);
 scenario(global_smoke_med_legs);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage);
}

$react_dmgf {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 scenario(global_smoke_fly);
 play(damage_force);
 wait(0.2);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
}

$react_dmgl {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 scenario(global_smoke_fly);
 play(damage_force);
 step(0,-1,0,3);
 wait(0.2);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(1);
 enemyscenario(ifx_step_r);
}

$react_dmgr {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 scenario(global_smoke_fly);
 play(damage_force);
 step(0,1,0,3);
 wait(0.2);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(1);
 enemyscenario(ifx_step_l);
}

$react_dmgu {scenario(react_dmgf);}

$react_death  { 
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 play(death);
 wait(0.4);
 scenario(global_smoke_big_torso);
 wait(1);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter); fxpos(dfp1,0,-0.35,0,0);
}

$react_deathf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 play(death_force);
 wait(0.3);
 scenario(global_smoke_big_torso);
 wait(0.1);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(0.8);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter); fxpos(dfp1,0,-0.3,0,0);
}

$react_deathl {scenario(react_deathf);}
$react_deathr {scenario(react_deathf);}
$react_deathu {scenario(react_deathf);}

