		"SovHeader": {
			"id": 730,
			"code": "SovHeader",
			"text": "Sovering Demon of Grief"
		},
		"SovText": {
			"id": 731,
			"code": "SovText",
			"text": "A terrible demon that had terrorized the residents of Haradan in times gone by, and\nwas defeated only at the cost of countless lives. Today, by\nsomeone's evil design, Sovering has awoken and is again gathering strength.\nYour duty is to stop the terrible spawn of darkness before it\nturns the lands of Radway and Dorheim into a nightmarish kingdom."
		},
		"StarUpgradeHelp": {
			"id": 1195,
			"code": "StarUpgradeHelp",
			"text": "Specify the epic item that you would like to upgrade to legendary."
		},
		"Tut1_1": {
			"id": 812,
			"code": "Tut1_1",
			"text": "To attack a monster, select a direction by tapping one of the green sectors under the monster. ^^ \nThe red sector shows the direction of the monster's gaze. The enemy will block or dodge an attack in that direction."
		},
		"Tut1_2": {
			"id": 824,
			"code": "Tut1_2",
			"text": "Tap the green sector to attack the monster"
		},
		"Tut2_1": {
			"id": 814,
			"code": "Tut2_1",
			"text": "The combo-blow button is on the right. By consistently delivering blows in the directions indicated, you can perform a super blow."
		},
		"Tut2_2": {
			"id": 825,
			"code": "Tut2_2",
			"text": "Wait until the enemy is not watching in the direction of your attack and tap the combo-blow button"
		},
		"Tut4_1": {
			"id": 815,
			"code": "Tut4_1",
			"text": "During the fight there is a chance of beating blue clots of mana from the enemy. You can collect these to cast magic spells."
		},
		"Tut4_1_1": {
			"id": 827,
			"code": "Tut4_1_1",
			"text": "Tap on the blue clot to gain mana"
		},
		"Tut4_2": {
			"id": 816,
			"code": "Tut4_2",
			"text": "On the left side of the screen there is a spell panel. You can cast a spell when you accumulate enough blue mana."
		},
		"Tut4_2_2": {
			"id": 828,
			"code": "Tut4_2_2",
			"text": "Tap on the magic button"
		},
		"Tut6_1": {
			"id": 817,
			"code": "Tut6_1",
			"text": "During enemy attacks, there is a chance that red clots of fury will appear next to you. Collect them, they are required to activate certain abilities."
		},
		"Tut6_1_2": {
			"id": 829,
			"code": "Tut6_1_2",
			"text": "Tap the scarlet clot to gain fury"
		},
		"TutAchievmentButton": {
			"id": 1033,
			"code": "TutAchievmentButton",
			"text": "You have earned one of the game achievements. You can take a look at all your current achievements, and compare your success with other players by tapping here."
		},
		"TutBagExp": {
			"id": 927,
			"code": "TutBagExp",
			"text": "You have received an artefact that gives an \"Experience\" bonus. This bonus determines how much additional experience you receive after victory in combat."
		},
		"TutBagMagic": {
			"id": 929,
			"code": "TutBagMagic",
			"text": "You have received an artifact that gives a bonus to one of the types of magic. This bonus determines the % increase in the destructive force of spells with this type of magic."
		},
		"TutBagMana": {
			"id": 926,
			"code": "TutBagMana",
			"text": "You have received an artefact that gives a \"Mana\" bonus. This bonus determines how many additional clots of mana you can receive. If the bonus is equal to 2 - this means that you are highly likely to receive from 1 to 2 additional clots of mana."
		},
		"TutBagMoney": {
			"id": 928,
			"code": "TutBagMoney",
			"text": "You have received an artefact that gives a \"Money\" bonus. This bonus determines how much additional gold you receive after victory in combat."
		},
		"TutBagRage": {
			"id": 925,
			"code": "TutBagRage",
			"text": "You have received an artefact that gives an \"Anger\" bonus. This bonus determines how many additional clots of fury you can receive in combat. If the bonus is equal to 1 - this means that you are highly likely to receive 1 additional clot of fury."
		},
		"TutBattleTurn": {
			"id": 915,
			"code": "TutBattleTurn",
			"text": "Combat in the game is turn-based. First you strike, then the enemy strikes back. You have several seconds for each move. In the upper part of the screen there is a red strip indicating the time remaining for your move."
		},
		"TutEndChests": {
			"id": 916,
			"code": "TutEndChests",
			"text": "You have dug up all the treasure hidden here. You can find new treasure in other liberated territories."
		},
		"TutEpicItemPuton": {
			"id": 1201,
			"code": "TutEpicItemPuton",
			"text": "You have received an epic item, which you can upgrade to legendary. To do this you should apply the required number of legendary status points to it."
		},
		"TutEye": {
			"id": 818,
			"code": "TutEye",
			"text": "The Fury you have accumulated is attracting the Eye of Chaos, which feeds on it. The more Fury you accumulate, the more often it will appear. You should destroy the Eye of Chaos before it manages to devour your Fury."
		},
		"TutEye_2": {
			"id": 823,
			"code": "TutEye_2",
			"text": "To destroy the Eye of Chaos, tap on it until it explodes."
		},
		"TutFallingStarPhrase1": {
			"id": 1244,
			"code": "TutFallingStarPhrase1",
			"text": "Sometime during combat, you will see a falling star. Try to catch it, and you will receive bonus legendary status points at the end of the fight."
		},
		"TutFallingStarPhrase2": {
			"id": 1245,
			"code": "TutFallingStarPhrase2",
			"text": "Tap on the star to receive your bonus at the end of the fight"
		},
		"TutFirstMagicBook": {
			"id": 948,
			"code": "TutFirstMagicBook",
			"text": "In this magic book, you can learn new spells and also improve the ones you already know. For this you will need magical skulls and a certain amount of magic skill. You can increase this by using magic in combat."
		},
		"TutFirstMobAttack": {
			"id": 947,
			"code": "TutFirstMobAttack",
			"text": "This territory has been attacked by an aggressive monster. You should destroy it as soon as possible. Otherwise it will kill the locals."
		},
		"TutFirstMoneyPile": {
			"id": 922,
			"code": "TutFirstMoneyPile",
			"text": "In liberated territory the local people will collect gold for you. The bigger the population, the more money they will bring you. The population will grow of its own accord with time. Return to the liberated territories periodically to get the gold that has been collected for you."
		},
		"TutGotLevel": {
			"id": 934,
			"code": "TutGotLevel",
			"text": "You have leveled up and you now have access to three new items. Call in to the shop and buy a belt, bracer and cuirass, these items will make you stronger. You have a fight with Boss ahead, and these items will help you."
		},
		"TutImmBattle": {
			"id": 907,
			"code": "TutImmBattle",
			"text": "You have just used magic to which the enemy is immune. Use an alternative spell. The enemy's magical immunity is shown beside their name before the fight."
		},
		"TutImmZ": {
			"id": 908,
			"code": "TutImmZ",
			"text": "You have encountered an enemy that is immune to a certain type of magic. This is indicated by a magic sign to the right of the monster's name. When fighting, try to use a different type of magic. If you have not learned different magic, you can do so in your Magic Book."
		},
		"TutLocationScarab": {
			"id": 924,
			"code": "TutLocationScarab",
			"text": "After freeing a territory of monsters, you can search for hidden treasure chests. In these treasure chests you can find magical amulets, rings, earrings and other extremely useful items. Tap to search for treasure."
		},
		"TutMagicBookButton": {
			"id": 990,
			"code": "TutMagicBookButton",
			"text": "Upon receiving the \"Sorcery\" skill, you received access to the Book of Magic."
		},
		"TutPlayerDefeat": {
			"id": 923,
			"code": "TutPlayerDefeat",
			"text": "When you lose a fight you can easily try again. If you don't manage to defeat the enemy, finish the fight and visit the shop. Here you can buy armor and ammunition to strengthen your character."
		},
		"TutResurrection": {
			"id": 834,
			"code": "TutResurrection",
			"text": "With combo-blows you might acquire the soul of the enemy, which is contained in a special item - an Ankh. After victory the Ankh is automatically used to resurrect the enemy and to subject them to a \nbloody execution\n"
		},
		"TutSearchTreasure": {
			"id": 837,
			"code": "TutSearchTreasure",
			"text": "You can search for treasure by using scarabs: To do this, place the scarab in the location and watch closely how it glows. The closer it is to the treasure, the stronger the light will be. When it is over the treasure, it will start to flutter its wings. You should dig in this spot."
		},
		"TutShop": {
			"id": 914,
			"code": "TutShop",
			"text": "In the shop you can spend the gold you have accumulated. In the main section - \"Recommended\" - you can find the armour available for your level that is better than your current armour. Here you can also buy Ammunition, which you can use to win even the toughest of fights."
		},
		"TutShopFilter2": {
			"id": 930,
			"code": "TutShopFilter2",
			"text": "This section contains all the armour available in the game"
		},
		"TutShopFilter3": {
