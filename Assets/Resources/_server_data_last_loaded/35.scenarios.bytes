////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 scenario(global_snd_mob_attack);
 play(attack_uppercot,35);
 react(f,1);
 scenario(global_snd_mob_attack_damage);
 scenario(template_attack_splash_med);
 wait(0.9);
 scenario(global_smoke_small_legs);
}

$attack_left {
 scenario(global_snd_mob_attack);
 play(attack_left,17);
 react(r,1);
 scenario(global_snd_mob_attack_damage);
 scenario(template_attack_splash_big);
 wait(1.1);
 scenario(global_smoke_small_legs);
}

$attack_right {
 scenario(global_snd_mob_attack);
 play(attack_right,25);
 react(l,1);
 scenario(global_snd_mob_attack_damage);
 scenario(template_attack_splash_big);
 wait(0.8);
 scenario(global_smoke_small_legs);
}

$attack_uppercot {
 scenario(global_snd_mob_attack);
 play(attack_uppercot,35);
 react(f,1);
 scenario(global_snd_mob_attack_damage);
 scenario(template_attack_splash_big);
 wait(0.9);
 scenario(global_smoke_small_legs);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
  	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 light(0,1.5);
 play(magic,10);
 scenario(global_snd_mob_magic_direct);
 scenario(global_magic_direct_start_zombie);
 wait(0.3);
 react(f,0);
 wait(0.4);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_zombie);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_zombie);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 light(0,2);
 fx(0,fx_zombieaoestart0,pos_head,1);
 play(magic_aoe,10);
 scenario(global_magic_aoe_prestart_zombie);
 wait(0.55);
 react(f,0);
 wait(0.25);
 scenario(global_snd_mob_magic_aoe);
 scenario(global_magic_aoe_start_zombie);
 scenario(global_magic_aoe_wave_zombie);
 wait(0.2);
 scenario(global_magic_aoe_exp_zombie);
 light(1,0.5,0);
}

$magic_baf {
 play(magic_baf,10);
 scenario(global_snd_mob_magic_baf);
 scenario(global_magic_baf_zombie); 
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 play(block,20);
 scenario(global_snd_mob_block);
 vibration(1,2,0);
 scenario(global_react_block);
}

$react_dodge {
 reactfx();
 play(dodge);
 scenario(global_snd_mob_dodge);
 wait(0.4);
 scenario(global_smoke_small_legs);
 wait(2.2);
 scenario(global_smoke_small_legs);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 play(damage);
 scenario(global_snd_mob_damage_rnd);
}

$react_dmgf {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_medium_torso);
}

$react_dmgl {
 wait(0.45);
 reactfx();
 scenario(global_snd_mob_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 step(0,-1,0,3);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_medium_torso);
 wait(1);
 enemyscenario(ifx_step_r);
}

$react_dmgr {
 wait(0.45);
 reactfx();
 scenario(global_snd_mob_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 step(0,1,0,3);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_medium_torso);
 wait(1);
 enemyscenario(ifx_step_l);
}

$react_dmgu {scenario(react_dmgf);}

$react_death  { 
 wait(0.5);
 reactfx();
 scenario(global_snd_mob_death);
 play(death);
 wait(1.8);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,0,0,0);
}

$react_deathf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob_death_force);
 play(death_force);
 scenario(global_smoke_fly);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_medium_torso);
 wait(1);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,-0.1,0,0);
}

$react_deathl {scenario(react_deathf);}
$react_deathr {scenario(react_deathf);}
$react_deathu {scenario(react_deathf);}

////////////////////////////////////////////////////////////////////
// INDIVIDUAL EFFECTS
////////////////////////////////////////////////////////////////////

$ifx_step_r {
  step(1,-1,1);
}

$ifx_step_l {
  step(1,1,1);
}

$ifx_blood {
 scenario(global_react_blood_green);
}

$ifx_blood_small {
 scenario(global_react_blood_small_green);
}

$ifx_blood_down_splash {
 fx(0,fx_blooddownsplat_Gr,pos_toe_r);
 wait(0.1);
 fx(0,fx_blooddownsplat_Gr,pos_toe_l);
}

$ifx_fatality_blood_splash {
 fx(0,fx_bloodsplat_Gr,pos_spinecenter);
 fx(fbs1,sfx_flesh_Gr,bottom);           fxpos(fbs1,0,1.55,0,1);
 wait(0.5);
 fx(0,fx_bloodsplat_Gr_2,bottom);
}

$ifx_blood_splash {
 fx(0,fx_bloodsplat_Gr,pos_spinecenter);
}

$ifx_blood_fontan {
 fx(0,fx_sizeblood_gr1,pos_head,1);
 fx(0,fx_sizeblood_gr1,pos_spinecenter,1);
 fx(0,fx_sizeblood_gr1,pos_hand_r,1);
 fx(0,fx_sizeblood_gr1,pos_hand_l,1);
 fx(0,fx_sizeblood_gr1,pos_toe_r,1);
 fx(0,fx_sizeblood_gr1,pos_toe_l,1);
}

$ifx_blood_screen {
 #random(25); fx(0,fx_bloodekran_Gr_L);  random#;
 #random(25); fx(0,fx_bloodekran_Gr_R);  random#;
 #random(50); fx(0,fx_bloodekran_Gr_RD); random#;
 #random(50); wait(0.05);                random#;
 #random(50); fx(0,fx_bloodekran_Gr_LD); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Gr_RU); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Gr_LU); random#;
}

$ifx_fatality_damage {
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
}

$ifx_fatality_fly {
 moveto(0,3,0,1);
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
 moveto(0,-3,0,0.1); 
 playpart(death,1,50,100);
}

$ifx_fatality_down_blood {
 playpart(damage,0.75,10,30);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,10,30);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,10,30);
 scenario(ifx_blood_down_splash);
}

//////////////////////////////
// TRIGGERS AND OTHER
//////////////////////////////

$onshow {
 scenario(global_onshow);
}

$onidle {
 scenario(global_snd_mob_death);
 wait(0.6);
 fx(0,fx_zombieidle2splash1,pos_hand_r);
 wait(0.6);
 fx(0,fx_zombieidle2splash1,pos_hand_r);
}

$onhide {
 scenario(global_onhide);
}