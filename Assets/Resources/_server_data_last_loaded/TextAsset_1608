		"TutFirstMobAttack": {
			"id": 947,
			"code": "TutFirstMobAttack",
			"text": "Un agresivo monstruo ha atacado este territorio. Debes acabar con él cuanto antes, ¡de lo contrario matará a los habitantes locales!"
		},
		"TutFirstMoneyPile": {
			"id": 922,
			"code": "TutFirstMoneyPile",
			"text": "Los habitantes de los territorios liberados recaudarán oro para ti. La población aumentará con el tiempo y, cuanto mayor sea, más oro te proporcionará. Regresa periódicamente a los territorios liberados para recoger el oro que hayan reunido para ti."
		},
		"TutGotLevel": {
			"id": 934,
			"code": "TutGotLevel",
			"text": "Has subido de nivel y ahora tienes acceso a tres nuevos objetos. Ve a la tienda y compra un cinturón, brazales y un arnés para hacerte más fuerte. Te espera una pelea con un jefe, y esos objetos te ayudarán."
		},
		"TutImmBattle": {
			"id": 907,
			"code": "TutImmBattle",
			"text": "Has usado un tipo de magia a la que el enemigo es inmune; puedes ver la inmunidad mágica del enemigo junto a su nombre antes del combate. Usa un hechizo alternativo."
		},
		"TutImmZ": {
			"id": 908,
			"code": "TutImmZ",
			"text": "Has encontrado un monstruo inmune ante un cierto tipo de magia. Esto se indica con un signo a la derecha de su nombre. Cuando luches contra él, debes usar otros tipos de magia. Si aún no los has aprendido, puedes hacerlo en el Libro de Magia."
		},
		"TutLocationScarab": {
			"id": 924,
			"code": "TutLocationScarab",
			"text": "Tras liberar de monstruos un territorio puedes buscar en él cofres de tesoros escondidos, en los que encontrarás amuletos mágicos, anillos, pendientes y otros objetos útiles. Toca la pantalla para buscar tesoros."
		},
		"TutMagicBookButton": {
			"id": 990,
			"code": "TutMagicBookButton",
			"text": "Junto con la habilidad \"Hechicería\" recibiste acceso al Libro de Magia."
		},
		"TutPlayerDefeat": {
			"id": 923,
			"code": "TutPlayerDefeat",
			"text": "Si pierdes una pelea, puedes repetirla fácilmente. Si no consigues vencer al enemigo, termina el combate y ve a la tienda. Allí podrás adquirir armadura y munición para fortalecer a tu personaje."
		},
		"TutResurrection": {
			"id": 834,
			"code": "TutResurrection",
			"text": "Asestando golpes-combo puedes hacerte con el alma del enemigo, contenida en un Ankh. Tras ganar, el Ankh se usa automáticamente para resucitar al enemigo y someterlo a una \nsangrienta ejecución\n"
		},
		"TutSearchTreasure": {
			"id": 837,
			"code": "TutSearchTreasure",
			"text": "Puedes buscar tesoros usando escarabajos: coloca uno en la ubicación y observa cómo brilla. Cuanto más se acerque al tesoro, más intensa será la luz, y cuando se encuentre sobre el tesoro comenzará a aletear. Ese es el punto en el que debes cavar."
		},
		"TutShop": {
			"id": 914,
			"code": "TutShop",
			"text": "En la tienda puedes usar el oro que hayas acumulado. En la sección \"Recomendado\" encontrarás las piezas de armadura que estén disponibles para tu nivel y sean mejores que las que ya tienes. Aquí también puedes comprar munición para los combates."
		},
		"TutShopFilter2": {
			"id": 930,
			"code": "TutShopFilter2",
			"text": "Esta sección contiene toda la armadura existente en el juego"
		},
		"TutShopFilter3": {
			"id": 931,
			"code": "TutShopFilter3",
			"text": "En esta sección encontrarás escarabajos (necesarios para buscar tesoros), calaveras mágicas (necesarias para mejorar hechizos), y ganzúas (que te ayudarán a abrir los cofres con tesoros)."
		},
		"TutShopFilter4": {
			"id": 932,
			"code": "TutShopFilter4",
			"text": "En la sección \"Premium\" hay conjuntos con descuento y artefactos especiales."
		},
		"TutShopFilter5": {
			"id": 933,
			"code": "TutShopFilter5",
			"text": "En la sección \"Reliquias\" verás objetos que no pueden comprarse, sino solo recibirse a cambio de servicios o similares."
		},
		"TutSliceAttack1": {
			"id": 995,
			"code": "TutSliceAttack1",
			"text": "Puedes atacar a un enemigo no solo tocando el sector, sino también deslizando el dedo en esa dirección."
		},
		"TutSliceAttack2": {
			"id": 996,
			"code": "TutSliceAttack2",
			"text": "Desliza el dedo de izquierda a derecha para atacar al enemigo por la izquierda."
		},
		"TutSliceAttack3": {
			"id": 997,
			"code": "TutSliceAttack3",
			"text": "Para consolidar tu posición, golpea al enemigo por el lado adecuado"
		},
		"TutStrongMagic": {
			"id": 819,
			"code": "TutStrongMagic",
			"text": "Para esquivar los ataques mágicos, repite la secuencia de pasos indicada"
		},
		"WeakMagicMessage": {
			"id": 585,
			"code": "WeakMagicMessage",
			"text": "Atrapa todo el maná negro del monstruo para esquivar su ataque mágico."
