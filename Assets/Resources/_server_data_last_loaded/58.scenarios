////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 scenario(global_snd_mob2_attack);
 scenario(global_attack_flylizard_prestart);
 play(attack,30);
 react(f,0);
 wait(0.4);
 scenario(global_attack_fly_flylizard);
 wait(0.2);
 scenario(global_magic_direct_expsmall_flylizard);
}

$attack_left {
 sound(local_attack_left,1);
 play(attack_left,32);
 react(r,1);
 scenario(template_attack_splash_med);
}

$attack_right {
 sound(local_attack_right,0.6);
 play(attack_right,20);
 react(l,1);
 scenario(template_attack_splash_med);
}

$attack_uppercot {
 sound(local_attack_uppercut,0.4);
 play(attack_uppercot,15);
 react(l,1);
 scenario(template_attack_splash_big);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
  	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 fxdestroy(fx_ringsmoke1_1,0);
 light(0,1.5);
 scenario(global_snd_mob2_direct);
 scenario(global_magic_aoe_flylizard_prestart);
 play(magic,25); 
 wait(0.2);
 react(f,0);
 wait(0.4);
 scenario(global_magic_direct_fly_flylizard);
 wait(0.2);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_flylizard);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_flylizard);
 ifnotreact#;
 light(1,1,0.3);
 wait(0.3);
 fx(0,fx_ringsmoke1_1,bottom,1,-1);
}

$magic_aoe {
 light(0,2);
 scenario(global_snd_mob2_aoe);
 scenario(global_magic_aoe_flylizard_prestart);
 play(magic_aoe,50);
 scenario(global_magic_aoe_flylizard_start);
 react(f,0);
 wait(0.35);
 scenario(global_magic_aoe_wave_flylizard);
 wait(0.2);
 scenario(global_magic_direct_exp_flylizard);
 light(1,0.5,0);
}

$magic_baf {
 light(0,1.5);
 scenario(global_snd_mob2_baf);
 scenario(global_magic_baf_flylizard_start);
 play(magic_baf,35);
 scenario(global_magic_baf_flylizard);
 light(1,0.5,0);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 sound(local_block,0.5);
 fxdestroy(fx_ringsmoke1_1,0);
 play(block,30);
 vibration(1,2,0);
 scenario(global_react_block);
 wait(1);
 fx(0,fx_ringsmoke1_1,bottom,1,-1);
}

$react_dodge {
 reactfx();
 scenario(global_snd_mob2_dodge);
 play(dodge);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage);
}

$react_dmgf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 fxdestroy(fx_ringsmoke1_1,0);
 play(damage_force);
 scenario(global_smoke_fly);
 wait(0.7);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(2.6);
 fx(0,fx_ringsmoke1_1,bottom,1,-1);
}

$react_dmgl {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 fxdestroy(fx_ringsmoke1_1,0);
 play(damage_force);
 scenario(global_smoke_fly);
 wait(0.2);
 step(0,-1,0,3);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(2);
 enemyscenario(ifx_step_r);
 wait(0.6);
 fx(0,fx_ringsmoke1_1,bottom,1,-1);
}

$react_dmgr {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 fxdestroy(fx_ringsmoke1_1,0);
 play(damage_force);
 scenario(global_smoke_fly);
 wait(0.2);
 step(0,1,0,3);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(2);
 enemyscenario(ifx_step_l);
 wait(0.6);
 fx(0,fx_ringsmoke1_1,bottom,1,-1);
}

$react_dmgu {scenario(react_dmgf);}

$react_death {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 fxdestroy(fx_ringsmoke1_1,0);
 play(death);
 wait(2.5);
 scenario(global_smoke_big_torso);
 wait(0.5);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,-0.25,0,0);
}

$react_deathf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death_force);
 fxdestroy(fx_ringsmoke1_1,0);
 play(death_force);
 scenario(global_smoke_fly);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(2);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,0,0,0);
}

$react_deathl {scenario(react_deathf);}
$react_deathr {scenario(react_deathf);}
$react_deathu {scenario(react_deathf);}

////////////////////////////////////////////////////////////////////
// INDIVIDUAL EFFECTS
////////////////////////////////////////////////////////////////////

$ifx_step_r {
  step(1,-1,1);
}

$ifx_step_l {
  step(-1,1,1);
}

$ifx_blood {
 scenario(global_react_blood_fiolet);
}

$ifx_blood_small {
 scenario(global_react_blood_small_fiolet);
}

$ifx_blood_down_splash {
 fx(0,fx_blooddownsplat_Fl,pos_toe_r);
 wait(0.1);
 fx(0,fx_blooddownsplat_Fl,pos_toe_l);
}

$ifx_fatality_blood_splash {
 fxdestroy(fx_ringsmoke1_1,0);
 fx(0,fx_bloodsplat_Fl,pos_spinecenter);
 fx(fbs1,sfx_flesh_Fl,bottom);           fxpos(fbs1,0,1.55,0,1);
 wait(0.5);
 fx(0,fx_bloodsplat_Fl_2,bottom);
}

$ifx_blood_splash {
 fxdestroy(fx_ringsmoke1_1,0);
 fx(0,fx_bloodsplat_Fl,pos_spinecenter);
}

$ifx_blood_fontan {
 fx(0,fx_sizeblood_fl1,pos_head,1);
 fx(0,fx_sizeblood_fl1,pos_spinecenter,1);
 fx(0,fx_sizeblood_fl1,pos_hand_r,1);
 fx(0,fx_sizeblood_fl1,pos_hand_l,1);
 fx(0,fx_sizeblood_fl1,pos_toe_r,1);
 fx(0,fx_sizeblood_fl1,pos_toe_l,1);
}

$ifx_blood_screen {
 fxdestroy(fx_ringsmoke1_1,0);
 #random(25); fx(0,fx_bloodekran_Fl_L);  random#;
 #random(25); fx(0,fx_bloodekran_Fl_R);  random#;
 #random(50); fx(0,fx_bloodekran_Fl_RD); random#;
 #random(50); wait(0.05);                random#;
 #random(50); fx(0,fx_bloodekran_Fl_LD); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Fl_RU); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Fl_LU); random#;
}

$ifx_fatality_damage {
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
}

$ifx_fatality_fly {
 fxdestroy(fx_ringsmoke1_1,0);
 moveto(0,3,0.5,1);
 playpart(damage,0.65,0,20);
 playpart(damage,0.65,0,20);
 moveto(0,-3,-0.5,0.1); 
 playpart(death,1,10,100);
}

$ifx_fatality_down_blood {
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
}

//////////////////////////////
// TRIGGERS AND OTHER
//////////////////////////////

$onshow {
 scenario(global_onshow);
 fx(0,fx_ringsmoke1_1,bottom,1,-1);
}

$onstart {
 fx(0,fx_ringsmoke1_1,bottom,1,-1);
}

$onidle {
 play(idle2);
 scenario(global_snd_mob2_idle);
}

$onhide {
 scenario(global_onhide);
 fxdestroy(fx_ringsmoke1_1,0);
}