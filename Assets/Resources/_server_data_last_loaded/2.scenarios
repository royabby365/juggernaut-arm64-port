////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----BERSERK-----//

$berserk1 {
 fxberserk(1);
}

$berserk2 {
 fxberserk(2);
}

$berserk3 {
 fxberserk(2);
 scenario(global_snd_magic_baf_berserk);
 scenario(global_berserk);
 size(1.2,1);
}

//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 scenario(global_snd_attack);
 #ifweapon(1);
  scenario(global_snd_attack_kick);
  #random(50, matk, 1);
   play(hand_front,11);
   scenario(global_smoke_little_legs);
   react(f,1);
   scenario(template_attack_splash_small);
   scenario(global_smoke_little_legs);
   wait(0.63);
   scenario(global_smoke_small_arms);
   wait(0.53);
   scenario(global_smoke_little_legs);
  random#; 
  #random(100, matk);
   play(foot_front,10);
   scenario(global_smoke_little_legs);
   react(f,1);
   scenario(template_attack_splash_med);
   wait(0.25);
   scenario(global_smoke_medium_torso);
   wait(1);
   scenario(global_smoke_little_legs);
  random#;
 ifweapon#;

 #ifweapon(0,1);
  #random(30, ohatk, 1);
   play(attack_uppercot,19);
   scenario(global_smoke_little_legs);
   react(u,1);
   scenario(template_attack_splash_big);
   scenario(global_smoke_small_legs);
  random#;
  #random(100, ohatk);
   play(attack);
   react(f,1);
   scenario(template_attack_splash_med);
   scenario(global_smoke_small_legs);
   wait(0.8);
   scenario(global_smoke_little_legs);
  random#;
 ifweapon#;

 #ifweapon(0,0,1);
  #random(30, ohatk, 1);
   play(attack_uppercot,10);
   scenario(global_smoke_little_legs);
   react(u,1);
   scenario(template_attack_splash_big);
   scenario(global_smoke_small_legs);
  random#;
  #random(100, ohatk);
   play(attack,10);
   react(f,1);
   scenario(template_attack_splash_med);
   scenario(global_smoke_small_legs);
  random#;
 ifweapon#;

 #ifweapon(0,0,0,1);
  #random(30, ohatk, 1);
   play(attack_uppercot,20);
   scenario(global_smoke_little_legs);
   react(u,1);
   scenario(template_attack_splash_big);
   scenario(global_smoke_small_legs);
  random#;
  #random(100, ohatk);
   play(attack,22);
   react(f,1);
   scenario(template_attack_splash_med);
   scenario(global_smoke_small_legs);
  random#;
 ifweapon#;

 #ifweapon(0,0,0,0,1);
  #random(30, ohatk2, 1);
   scenario(global_smoke_little_legs);
   play(attack_uppercot,10);
   react(u,1);
   scenario(template_attack_splash_big);
   scenario(global_smoke_small_legs);
   wait(1.65);
   scenario(global_smoke_small_legs);
  random#;
  #random(100, ohatk2);
   play(attack,10);
   react(f,1);
   scenario(template_attack_splash_med);
   scenario(global_smoke_small_legs);
   wait(1.5);
   scenario(global_smoke_small_legs);
  random#;
 ifweapon#;
}

