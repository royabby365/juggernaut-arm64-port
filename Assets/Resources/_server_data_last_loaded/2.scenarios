$attack_super {
 scenario(global_snd_attack_super);
 #ifweapon(1);
   play(attack_super,30);
   scenario(global_smoke_small_legs);
   wait(0.2);
   react(u,1);
   scenario(template_attack_splash_big);
   enemyscenario(global_smoke_exp);
   wait(0.1);
   scenario(global_smoke_small_legs);
   wait(0.95);
   scenario(global_smoke_small_legs);
 ifweapon#;
 
