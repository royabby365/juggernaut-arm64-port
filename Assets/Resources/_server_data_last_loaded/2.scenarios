$ifx_step_r {
 #ifweapon(1,1,1,0,1);
  step(1,-1,1);
 ifweapon#;
 #ifweapon(0,0,0,1);
  step(-1,-1,1);
 ifweapon#;
}

$ifx_step_l {
 #ifweapon(1,1,1,0,1);
  step(-1,1,1);
 ifweapon#;
 #ifweapon(0,0,0,1);
  step(1,1,1);
 ifweapon#;
}

