////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 scenario(global_snd_block);
 reactfx();
 play(block,25);
 vibration(1,2,0);
 scenario(global_react_block);
} 

$react_dodge {
  wait(0.1);
  scenario(global_snd_dodge);
  reactfx();
  play(dodge);
  scenario(global_dodge_trail);
 #ifweapon(1,1); 
  wait(0.8);
  scenario(global_smoke_little_legs);
  wait(0.1);
  fx(ddg1,fx_dodgetrail1,pos_spinecenter,1);
  wait(0.6);
  scenario(global_smoke_little_legs);
 ifweapon#;
 #ifweapon(0,0,1);
  scenario(global_snd_dodge_react);
  wait(0.8);
