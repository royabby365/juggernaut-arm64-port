			"bot": "284_486_38",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "Żywy człowiek? Na tych przeklętych ziemiach? I brzuch nie rozpruty, i jakby nie opętany...",
					"femaleText": "Żywa dziewczyna? Na tych przeklętych ziemiach? I brzuch nie rozpruty, i jakby nie opętana...",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "To człowiek, bez wątpienia. Myśleliśmy, że z śmiertelników można tu spotkać tylko Tego, co chowa twarz. Być może spotkałeś go po drodze, nieznajomy?",
					"femaleText": "Żywa, bez wątpienia. Myśleliśmy, że z śmiertelników można tu spotkać tylko Tego, co chowa twarz. Być może spotkałaś go po drodze, nieznajoma?",
