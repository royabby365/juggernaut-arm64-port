		"1587": {
			"id": 1587,
			"bot": "282_414_31",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Zły las. Mama się denerwuje. Nie wolno mi iść dalej, ale ty idź. Ja poczekam tutaj, na krańcu lasu. Będę grzeczna, obiecuję!",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Będziesz za mną tęsknić? Ja też. Wrócisz, żeby się ze mną pobawić? Nauczę cię zabawy w śmierć i życie.",
