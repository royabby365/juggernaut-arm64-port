		"1320": {
			"id": 1320,
			"bot": "276_124_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ty tak śmiesznie walczysz, machasz bronią, jakbyś tańczył! Szkoda, że mam na razie nie pozwala nauczyć Cię tego, co wiemy o bitwach...",
					"location": "left"
