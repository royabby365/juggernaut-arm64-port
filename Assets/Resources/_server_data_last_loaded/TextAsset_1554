				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1156": {
			"id": 1156,
			"bot": "236_240_9",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Nie powinnam pewnie mówić o tym, co się wydarzyło wtedy we wsi. Poszłam bez pytania do lasu na jagody. I kiedy wróciłam, wszyscy ludzi byli już źli. Bardzo źli.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Nie byli podobni do siebie. Dosłownie jakby ktoś udawał człowieka, jak ten wilk z bajki. Zakrzyczałam, ale nikt nie odpowiedział.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Ludzie we wsi zmienili się... Rzucili się na mnie, ledwo uszłam z życiem.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Kiedy o tym myślę, tulę się do mojego misia i gorzko płaczę...",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1157": {
			"id": 1157,
			"bot": "236_241_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Pytasz, gdzie moja mama? Tutaj jest, ale rozmawia tylko ze mną. Jeśli chcesz jej coś powiedzieć, przekażę twoje słowa.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Co tak na mnie patrzysz? Nie lubię, kiedy na mnie tak patrzą... Może stać się coś strasznego!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1158": {
			"id": 1158,
			"bot": "236_49_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Czekaj! Słyszysz? Jęczy bagienny człowiek... Mama mi go pokazała. Kiedyś był jak inni, ale potem utonął w bagnie i się zmienił. Straszny jest i chce nas zabić...",
					"location": "left"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1159": {
			"id": 1159,
			"bot": "275_398_14",
			"dialogs": {
				"1": {
					"npc": "1271",
					"maleText": "Dawaj tu swoje rzeczy! Drugi raz nie powtórzę! Oddasz po dobroci - pójdziesz swoją drogą. Będziesz zwlekać - pójdziesz na czworaka. Uprzesz się - zaśniesz tu na wieki!",
					"location": "right"
				},
				"2": {
					"location": ""
