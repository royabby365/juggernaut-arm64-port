			"bot": "1862_1864_14",
			"dialogs": {
				"1": {
					"npc": "1869",
					"maleText": "Po co przylazłeś na naszą ziemię? Kiedyś nikt się na bagna nie zapędzał, tylko my, topry - mieszkańcy trzęsawiska - tutaj rządziliśmy.",
