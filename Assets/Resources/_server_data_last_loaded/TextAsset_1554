		"1572": {
			"id": 1572,
			"bot": "1182_1190_49",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Mama mówi, że jesteś tym, kto zbawi nasz świat. Tylko że nawet takim jak ty potrzebny jest trening. Jeśli chcesz, pobawimy się jeszcze. Pokażę ci coś nowego.",
					"femaleText": "Mama mówi, że jesteś tą, kto zbawi nasz świat. Tylko że nawet takim jak ty potrzebny jest trening. Jeśli chcesz, pobawimy się jeszcze. Pokażę ci coś nowego.",
					"location": "right"
				},
				"2": {
					"npc": "1153",
					"maleText": "Pytasz, czy moja mama, o której tak dużo mówię, żyje? Nie. Ale nie ma jej też wśród zmarłych.",
