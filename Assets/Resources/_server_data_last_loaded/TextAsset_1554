			"minVersion": null,
			"maxVersion": null
		},
		"1325": {
			"id": 1325,
			"bot": "276_493_15",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Idzie za nami. Słyszysz jego kroki? Ja słyszę. Czuję go. Jest mu źle. Cierpi...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Cierpi z głodu. Przywykł jeść ludzi, ale od dana nikogo nie widział, tylko same pająki i nietoperze. Zje nas... Zje!",
					"location": "left"
				},
				"3": {
