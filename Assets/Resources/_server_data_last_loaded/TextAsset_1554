			"id": 1745,
			"bot": "284_490_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Prawie wszystkie moje siostry stały się opętane, podobnie jak ja do spotkania z tobą, zbawco. Szlachetne wojowniczki zamieniły się w krwiożercze potwory. Jaki straszny koniec dla naszego plemiona!",
					"femaleText": "Prawie wszystkie moje są opętane, podobnie jak ja do spotkania z tobą, zbawczyni. Jaki straszny koniec dla naszego plemiona!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "To jedna z nich... Biedaczka! Walcz z nią, być może wyleczy się jak ja. Albo przynajmniej zakończą się jej cierpienia. Tylko bądź ostrożny! Amazonki są silne i sprytne, a w tej do tego demon siedzi!",
					"femaleText": "To jedna z nich... Biedaczka! Walcz z nią, może też wyleczy. Albo przynajmniej zakończą się jej cierpienia.",
