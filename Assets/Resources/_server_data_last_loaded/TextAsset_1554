		"1155": {
			"id": 1155,
			"bot": "236_239_8",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Wiedziałam, że przyjdziesz. Mama powiedziała, że będę miała jeszcze przyjaciół... Nazywam się Una. Pochodzę ze wsi, która znajduje się niedaleko stąd... Nigdy więcej tam nie wrócę. Pójdę z tobą.",
					"femaleText": "Wiedziałam, że przyjdziesz. Mama powiedziała, że będę miała jeszcze przyjaciółki... Nazywam się Una. Pochodzę ze wsi, która znajduje się niedaleko stąd... Nigdy więcej tam nie wrócę. Pójdę z tobą.",
					"location": "left"
				},
				"2": {
