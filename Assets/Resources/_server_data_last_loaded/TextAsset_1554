		"1579": {
			"id": 1579,
			"bot": "1182_1191_53",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Chcę, żebyś pokonał Seweringa. Naprawdę strasznie, strasznie chcę! Jeśli sobie też teraz ze mną poradzisz, dam ci mojego misia, a on ci pomoże!",
					"femaleText": "Chcę, żebyś pokonała Seweringa. Naprawdę strasznie, strasznie chcę! Jeśli sobie też teraz ze mną poradzisz, dam ci mojego misia, a on ci pomoże!",
