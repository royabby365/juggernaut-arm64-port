		"1378": {
			"id": 1378,
			"bot": "275_399_14",
			"dialogs": {
				"1": {
					"npc": "1272",
					"maleText": "Myślisz, że skoro pokonałeś innych, to poradzisz sobie ze mną? Wiesz, ile dusz żywych zgubiłem? Takiego wielkiego cmentarza nie ma na świecie, żeby je pochować!",
					"femaleText": "Myślisz, że skoro pokonałaś innych, to poradzisz sobie ze mną? Wiesz, ile dusz żywych zgubiłem? Takiego wielkiego cmentarza nie ma na świecie, żeby je pochować!",
					"location": "right"
				},
				"2": {
					"npc": "1272",
					"maleText": "Zaraz cię na kawałki porąbię! Z czaszki czaszę zrobię, z zębów naszyjnik, a z kości flety! ",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
