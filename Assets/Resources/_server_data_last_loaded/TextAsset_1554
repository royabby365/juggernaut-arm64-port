		"1738": {
			"id": 1738,
			"bot": "284_488_39",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Cykloparki... Nienawidzę! To zaklęty wróg amazonek. Jak długo tu żyjemy, tak długo walczymy z tym podłym narodem.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Uderzają ukradkiem, napadają hurmem, kradną wszystko, co luzem leży. A z ust ich sypią się same przekleństwa! Jestem pewna, że pokażesz im ich miejsce, bohaterze!",
					"femaleText": "Uderzają ukradkiem, napadają hurmem, kradną wszystko, co luzem leży. A z ust ich sypią się same przekleństwa! Jestem pewna, że pokażesz im ich miejsce, zbawczyni!",
					"location": "left"
				},
				"3": {
					"npc": "1270",
					"maleText": "Zobacz, nowa ofiara! - Widzę, walczę najpierw! - Nie, ja! - To walczmy razem! - Koniec z tobą, człowieku, koniec!",
