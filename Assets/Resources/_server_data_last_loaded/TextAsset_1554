		"1388": {
			"id": 1388,
			"bot": "277_401_17",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Nie chwytaj tak śpiesznie za broń, słynny wojowniku! Wróciłam, żeby ci podziękować, a nie znowu atakować! Kiedy pokonałeś mnie w walce, wygnałeś ze mnie demoniczną istotę Seweringa!",
					"femaleText": "Nie chwytaj tak śpiesznie za broń, wojowniczko! Wróciłam, żeby ci podziękować, a nie znowu atakować! Kiedy pokonałaś mnie w walce, wygnałaś ze mnie demoniczną istotę Seweringa!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Mam na imię Ariana, zawdzięczam Ci życie! Zgodnie z prawem plemienia amazonek będę Ci służyć do końca moich dni. Daj mi trochę czasu na zaleczenie ran, a pójdę za Tobą na koniec świata!",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1391": {
			"id": 1391,
			"bot": "277_402_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Nie podoba mi się ta kobieta, którą wziąłeś z sobą. Amazonka. Przegoń ją. Błagam! Słyszysz? Przegoń, przegoń, przegoń!",
					"femaleText": "Nie podoba mi się ta kobieta, którą wzięłaś z sobą. Amazonka. Przegoń ją. Błagam! Słyszysz? Przegoń, przegoń, przegoń!",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
