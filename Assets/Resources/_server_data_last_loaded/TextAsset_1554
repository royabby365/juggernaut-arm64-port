		"1383": {
			"id": 1383,
			"bot": "277_400_16",
			"dialogs": {
				"1": {
					"npc": "1187",
					"maleText": "Na kolana przed Seweringiem, marna istoto!",
					"femaleText": "Na kolana przed Seweringiem, marna istoto!",
					"location": "right"
				},
				"2": {
					"npc": "1187",
					"maleText": "Przez moje oczy pan widzi cię i pragnie, żebyś natychmiast padł przed nim! Jeśli będziesz się opierać, tchnie we mnie wielką siłę i rozerwę cię na strzępy!",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
