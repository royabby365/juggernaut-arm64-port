		"1606": {
			"id": 1606,
			"bot": "282_477_33",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Rozumiem, dlaczego Una postanowiła zostać... Im dalej idziemy, tym silniej czuję ciemną wolę Seweringa. Demon mógłby zbudzić tę siłę, która tkwi w dziewczynce i obrócić ją przeciwko nam.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Una wiedziała to i czeka na skraju, żeby nam nie zaszkodzić. Przeczucie mówi mi, że spotkasz jeszcze tę dziewczynkę, bohaterze.",
					"femaleText": "Una wiedziała to i czeka na skraju, żeby nam nie zaszkodzić. Przeczucie mówi mi, że spotkasz jeszcze tę dziewczynkę, moja droga.",
