			},
			"minVersion": null,
			"maxVersion": null
		},
		"1398": {
			"id": 1398,
			"bot": "277_403_18",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Wybacz, mój zbawco, nie chciałam o tym mówić, ale nie mogę więcej milczeć. Ta... Hm... Dziewczyna, która z nami idzie... W Brangard wszyscy drżeli na myśl o niej! Jest opętana demonem!",
					"femaleText": "Wybacz, moja zbawczyni, nie chciałam o tym mówić, ale nie mogę więcej milczeć. Ta... Hm... Dziewczyna, która z nami idzie... W Brangardzie wszyscy drżeli na myśl o niej! Jest opętana demonem!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Mówiła ci, że uciekła ze swojej wioski? Nie wierz jej! Ta bestia zabiła swoją rodzinę i teraz ostrzy sobie pazury na ciebie!",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Dlaczego ona tak mówi? Ty też myślisz, że zrobiłam źle? Same kłamstwa! Dobrze się sprawowałam, naprawdę!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1407": {
			"id": 1407,
			"bot": "277_404_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Una jest zła, Una - kłamczucha. Moi rodzice, moja wioska... Skłamałam. Tak naprawdę to stamtąd nie uciekłam wtedy...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Ale oni pierwsi się na mnie rzucili! Nie chciałam, przyrzekam! Po prostu się przestraszyłam... Jak nigdy... I stało się.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "A potem oni spalili się i umarli. Wszyscy umarli. Cała nasza rodzina, cała wioska... Źle zrobiłam... Ale mama mówi, że tak musiało być.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "To dlatego, że inaczej by mnie zabili... Wszyscy stali się źli z powodu Seweringa. Gonili mnie. Teraz będę płakać. Błagam, nie przeganiaj mnie...",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1414": {
			"id": 1414,
			"bot": "277_405_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Płaczę dzisiaj cały dzień... Wybaczysz mi przecież to, co zrobiłam w wiosce, co? Błagam, wybacz i pozwól iść z tobą...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Jesteś moim jedynym przyjacielem. Tylko mój miś i mama chronią mnie...",
					"femaleText": "Jesteś moim jedyną przyjaciółką. Tylko mój miś i mama chronią mnie...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Zrobiło mi się żal tej dziewczynki. Być może nie jest tak straszna, jak mi się zdawało... Pozwól jej zostać, mój bohaterze. Być może pomoże ci ona w twojej nielekkiej wyprawie.",
					"femaleText": "Zrobiło mi się żal tej dziewczynki. Być może nie jest tak straszna, jak mi się zdawało... Pozwól jej zostać, moja droga. Być może pomoże ci ona w twojej nielekkiej wyprawie.",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1425": {
			"id": 1425,
			"bot": "277_469_20",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Czekaj... Wiem, że nie masz innego wyjścia, musisz iść naprzód, ale ja tak się boję o ciebie, mój opiekunie! Stracić ciebie - nie ma nic gorszego...",
					"femaleText": "Czekaj... Wiem, że nie masz innego wyjścia, musisz iść naprzód, ale ja tak się boję o ciebie, moja opiekunko! Stracić ciebie - nie ma nic gorszego...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Dlaczego jestem tak niespokojna? Uwierz, mam swoje powody. Zmierza tu Krępacz Jednorogi - notoryczny czempion turniejów, w których brali udział najlepsi wojownicy za czasów, kiedy nie wiedzieliśmy jeszcze o istnieniu Seweringa...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Krępacz Jednorogi jest tak silny, że bez trudu walczy mieczem długości człowieka!",
					"location": "left"
				},
				"4": {
					"npc": "1186",
					"maleText": "Ten miecz może przeciąć na pół jeźdźca wraz z koniem! Nie mówiłabym ci, gdybym nie widziała na własne oczy!",
					"location": "left"
				},
				"5": {
					"npc": "1186",
					"maleText": "Krępacz mógł zabić każdego jednym ciosem, kiedy był zwykłym człowiekiem. Teraz jest opętany Seweringiem i tryska demoniczną mocą. Proszę cię o jedno - bądź ostrożny. Dla Radwy. Dla mnie...",
					"femaleText": "Krępacz mógł zabić każdego jednym ciosem, kiedy był zwykłym człowiekiem. Teraz jest opętany Seweringiem i tryska demoniczną mocą. Proszę cię o jedno - bądź ostrożna. Dla Radwy. Dla mnie...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1430": {
			"id": 1430,
			"bot": "278_413_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Przyśnił mi się straszny sen. Obudziłam się i trzęsłam się ze strachu do samego rana.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "We śnie widziałam stworzenia stare jak świat i potężne jak góry... Ich kryształowego ciała nie ruszy broń... Mama mówi, że to nie był tylko sen.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1435": {
			"id": 1435,
			"bot": "278_409_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Teraz czuję Ich siłę... Ludzie są tacy słabi w porównaniu z Nimi...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Oni są tam, z przodu... Istoty z kryształów... Nie mają duszy, ale są źli, bo Ich zbudzili... Są bardzo, bardzo źli... Nie boisz się? Na darmo.",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1444": {
			"id": 1444,
			"bot": "278_407_23",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Moje serce znowu boli na myśl o nieszczęściu! Tak się o ciebie niepokoję, bohaterze.",
					"femaleText": "Moje serce znowu boli na myśl o nieszczęściu! Tak się o ciebie niepokoję, opiekunko.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Widziałam w przyszłości istotę, jakiej nigdy dotąd nie spotykałam. Ale pamiętam legendy o podobnych stworach. Nazywają ich krysztalonami i powiadają, że żyły one przed wieloma wiekami, a potem usnęły...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Błagam, uważaj na siebie! Bo tylko ty zdołasz uratować naszą nieszczęsną Radwę!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1452": {
			"id": 1452,
			"bot": "278_411_25",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Tak wspaniale walczysz, mój dobroczyńco! Wiedz, że coraz częściej myślę o tym, ile nieszczęść spadło na te ziemie... Najpierw demon Sewering, teraz te kamienne olbrzymy...",
					"femaleText": "Tak wspaniale walczysz, mój dobrodziejko! Wiedz, że coraz częściej myślę o tym, ile nieszczęść spadło na te ziemie... Najpierw demon Sewering, teraz te kamienne olbrzymy...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Wątpię, że to czysty przypadek... Za wszystkimi tymi dramatami ukrywa się ktoś... Czyjaś zła ręka zbudziła i demonów, i olbrzymów... Musi być jednocześnie mistrzowskim czarnym magiem i elementalistą...",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1457": {
			"id": 1457,
			"bot": "278_412_25",
			"dialogs": {
				"1": {
