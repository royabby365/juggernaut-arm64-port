		"1317": {
			"id": 1317,
			"bot": "276_369_12",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Podoba mi się, że idę tak z tobą. Jakbyśmy na spacer poszli, a była zwykłym dzieckiem.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Mama mówi, że się mnie boisz. Powiedz, czy naprawdę można się przestraszyć małej dziewczynki?",
					"femaleText": "Mama mówi, że się mnie boisz. Powiedz, czy naprawdę można się przestraszyć małej dziewczynki?",
					"location": "left"
