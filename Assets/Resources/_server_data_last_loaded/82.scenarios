///////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 scenario(global_snd_mob2_attack);
 fx(0,fx_matkabaf1,pos_hand_l,1);
 fx(0,fx_matkabolt1,pos_hand_l,1,2);
 play(attack,15);
 wait(0.8);
 react(f,1);
 scenario(template_attack_splash_big);
 scenario(global_attack_exp_matka);
}

$attack_left {
 sound(local_attack_left,0.3);
 fx(0,fx_matkabaf1,pos_hand_l,1);
 fx(0,fx_matkabolt1,pos_hand_l,1,2);
 play(attack_left,15);
 wait(0.5);
 react(f,1);
 scenario(template_attack_splash_big);
 scenario(global_attack_exp_matka);
}

$attack_right {
 scenario(global_snd_mob2_attack_right);
 fx(0,fx_matkabaf1,pos_hand_r,1);
 fx(0,fx_matkabolt1,pos_hand_r,1,2);
 play(attack_right,15);
 wait(0.7);
 react(f,1);
 scenario(template_attack_splash_big);
 scenario(global_attack_exp_matka);
}

$attack_uppercot {
 scenario(global_snd_mob2_attack_uppercot);
 fx(0,fx_matkabaf1,pos_hand_r,1);
 fx(0,fx_matkabolt1,pos_hand_r,1,2);
 fx(0,fx_matkabaf1,pos_hand_l,1);
 fx(0,fx_matkabolt1,pos_hand_l,1,2);
 play(attack_uppercot,15);
 wait(0.7);
 react(f,1);
 scenario(template_attack_splash_big);
 scenario(global_attack_exp_matka);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
	 enemyscenario(ifx_blood);
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 enemyscenario(ifx_blood);
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 enemyscenario(ifx_blood);
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 light(0,1.5);
 scenario(global_snd_mob2_direct);
 scenario(global_magic_baf_matka);
 play(magic,22);
 react(f,0);
 wait(0.25);
 scenario(global_magic_direct_fly_matka);
 wait(0.25);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_matka);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_matka);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 light(0,2);
 scenario(global_snd_mob2_aoe);
 play(magic_aoe);
 scenario(global_magic_baf_matka);
 wait(0.7);
 react(f,0);
 wait(0.5);
 scenario(global_magic_aoe_wave_matka);
 wait(0.2);
 scenario(global_magic_aoe_exp_matka);
 light(1,0.5,0);
}

$magic_baf {
 light(0,3);
 scenario(global_snd_mob2_baf);
 play(magic_baf,20); 
 scenario(global_magic_baf_matka);
 wait(1);
 light(1,1,0);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 sound(local_block,0.3);
 play(block,20);
 vibration(1,2,0);
 scenario(global_react_block);
 scenario(global_smoke_med_legs);
}

$react_dodge {
 reactfx();
 scenario(global_snd_mob2_dodge);
 play(dodge,10);
 scenario(global_smoke_med_legs);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage,45);
}

$react_dmgf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_med_legs);
 wait(0.5);
 vibration(1,2,0);
}

$react_dmgl {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_med_legs);
 step(0,-1,0,3);
 wait(0.5);
 vibration(1,2,0);
 enemyscenario(ifx_step_r);
}

$react_dmgr {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_med_legs);
 step(0,1,0,3);
 wait(0.5);
 vibration(1,2,0);
 enemyscenario(ifx_step_l);
}

$react_dmgu {scenario(react_dmgf);}

$react_death {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 play(death);
 wait(1.5);
 scenario(global_smoke_big_torso);
 wait(0.7);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,-0.55,0,0);
}

$react_deathf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death_force);
 scenario(global_smoke_med_legs);
 play(death_force);
 wait(0.5);
 scenario(global_smoke_big_torso);
 wait(1.5);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,-0.45,0,0);
}

$react_deathl {scenario(react_death);}
$react_deathr {scenario(react_death);}
$react_deathu {scenario(react_death);}

////////////////////////////////////////////////////////////////////
// INDIVIDUAL EFFECTS
////////////////////////////////////////////////////////////////////

$ifx_step_r {
  step(1,-1,1);
}

$ifx_step_l {
  step(-1,1,1);
}

$ifx_blood {
 scenario(global_react_blood);
}

$ifx_blood_small {
 scenario(global_react_blood_small);
}

$ifx_blood_down_splash {
 fx(0,fx_blooddownsplat_Gr,pos_toe_r);
 wait(0.1);
 fx(0,fx_blooddownsplat_Gr,pos_toe_l);
}

$ifx_fatality_blood_splash {
 fx(0,fx_bloodsplat_Gr,pos_spinecenter);
 fx(fbs1,sfx_flesh_Gr,bottom);           fxpos(fbs1,0,1.55,0,1);
 wait(0.5);
 fx(0,fx_bloodsplat_Gr_2,bottom);
}

$ifx_blood_splash {
 fx(0,fx_bloodsplat_Gr,pos_spinecenter);
}

$ifx_blood_fontan {
 fx(0,fx_sizeblood_gr1,pos_head,1);
 fx(0,fx_sizeblood_gr1,pos_spinecenter,1);
 fx(0,fx_sizeblood_gr1,pos_hand_r,1);
 fx(0,fx_sizeblood_gr1,pos_hand_l,1);
 fx(0,fx_sizeblood_gr1,pos_toe_r,1);
 fx(0,fx_sizeblood_gr1,pos_toe_l,1);
}

$ifx_blood_screen {
 #random(25); fx(0,fx_bloodekran_Gr_L);  random#;
 #random(25); fx(0,fx_bloodekran_Gr_R);  random#;
 #random(50); fx(0,fx_bloodekran_Gr_RD); random#;
 #random(50); wait(0.05);                random#;
 #random(50); fx(0,fx_bloodekran_Gr_LD); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Gr_RU); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Gr_LU); random#;
}

$ifx_fatality_damage {
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
}

$ifx_fatality_fly {
 moveto(0,3,0.5,1);
 playpart(damage,0.65,0,20);
 playpart(damage,0.65,0,20);
 moveto(0,-3,-0.5,0.1); 
 playpart(death,1,10,100);
}

$ifx_fatality_down_blood {
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,0,20);
 scenario(ifx_blood_down_splash);
}

//////////////////////////////
// TRIGGERS AND OTHER
//////////////////////////////

$onshow {
 scenario(global_onshow);
}

$onidle {
 wait(0.3);
 scenario(global_snd_mob2_idle);
}

$onhide {
 scenario(global_onhide);
}