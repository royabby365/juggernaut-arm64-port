 #ifweapon(1,1,0,1);
  scenario(global_magic_baf_block);
  play(magic_baf,35);
 ifweapon#;
 #ifweapon(0,0,1);
  scenario(global_magic_baf_block);
  play(magic_baf,15);
 ifweapon#;
 #ifweapon(0,0,0,0,1);
  scenario(global_magic_baf_block);
  play(magic_baf,38);
 ifweapon#;
 light(1,1,0.3);
}

