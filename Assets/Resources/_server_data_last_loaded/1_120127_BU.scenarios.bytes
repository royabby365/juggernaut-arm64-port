$magic_baf_attack_fire {
 light(0,1.5);
 #ifweapon(1,1,0,1);
  scenario(global_magic_baf_fire_hand_1);
  play(magic_baf,35);
  scenario(global_snd_baf_fire);
  scenario(global_magic_baf_fire_hand_2);
  enemyscenario(global_magic_dot_fire_buff);
  wait(0.2);
  enemyscenario(global_magic_dot_fire_start);
	react(f,0);
 ifweapon#;
 #ifweapon(0,0,1);
  scenario(global_magic_baf_fire_hand_1);
  play(magic_baf,15);
  scenario(global_snd_baf_fire);
  scenario(global_magic_baf_fire_hand_2); 
  enemyscenario(global_magic_dot_fire_buff);
  wait(0.2);
  enemyscenario(global_magic_dot_fire_start);
	react(f,0);
 ifweapon#;
 #ifweapon(0,0,0,0,1);
  scenario(global_magic_baf_fire_hand_1);
  play(magic_baf,38);
  scenario(global_snd_baf_fire);
  scenario(global_magic_baf_fire_hand_2); 
  enemyscenario(global_magic_dot_fire_buff);
  wait(0.2);
  enemyscenario(global_magic_dot_fire_start);
	react(f,0);
 ifweapon#;
 wait(1);
 light(1,1,0.3);
}

