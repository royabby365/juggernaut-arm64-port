$attack {
 #ifweapon(1);
  scenario(global_snd_attack_kick);
  #random(50, matk, 1);
   play(foot_front,6);
   scenario(global_smoke_little_legs);
   react(f,1);
   #ifnotreact(0,1);
    scenario(global_snd_damage_kick);
   ifnotreact#;
   scenario(template_attack_splash_med);
   scenario(global_smoke_small_legs);
  random#;
  #random(100, matk);
   play(hand_front,5);
   scenario(global_smoke_little_legs);
   react(f,1);
   #ifnotreact(0,1);
    scenario(global_snd_damage_kick);
   ifnotreact#;
   scenario(template_attack_splash_small);
   wait(0.1);
   scenario(global_smoke_small_legs);
  random#;
 ifweapon#;

 #ifweapon(0,1);
  scenario(global_snd_attack_weapon);
  #random(30, ohatk, 1);
   play(attack_uppercot,19);
   scenario(global_smoke_little_legs);
   react(u,1);
   #ifnotreact(0,1);
    scenario(global_snd_damage_weapon);
   ifnotreact#;
   scenario(template_attack_splash_big);
   scenario(global_smoke_small_legs);
  random#;
  #random(100, ohatk);
   play(attack,17);
   react(f,1);
   #ifnotreact(0,1);
    scenario(global_snd_damage_weapon);
   ifnotreact#;
   scenario(template_attack_splash_med);
   scenario(global_smoke_small_legs);
  random#;
 ifweapon#;

 #ifweapon(0,0,1);
  scenario(global_snd_attack_weapon);
  #random(30, thatk, 1);
   play(attack_uppercot,10);
   scenario(global_smoke_little_legs);
