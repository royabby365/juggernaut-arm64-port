$react_block {
 wait(0.1);
 reactfx();
 play(block,20);
 scenario(global_snd_block_react);
 vibration(1,2,0);
 scenario(global_react_block);
}

$react_dodge {
 #ifweapon(1,1); 
  wait(0.1);
  reactfx();
  play(dodge);
  scenario(global_snd_dodge_react);
  scenario(global_dodge_trail);
  wait(0.3);
  scenario(global_smoke_little_legs);
  wait(1.1);
  scenario(global_smoke_little_legs);
 ifweapon#;
 #ifweapon(0,0,1);
  wait(0.1);
  reactfx();
  play(dodge);
  scenario(global_snd_dodge_react);
  scenario(global_dodge_trail);
  wait(0.3);
  scenario(global_smoke_little_legs);
  wait(0.6);
  scenario(global_smoke_little_legs);
 ifweapon#;
 #ifweapon(0,0,0,1);
  wait(0.1);
  reactfx();
  play(dodge);
  scenario(global_snd_dodge_react);
  scenario(global_dodge_trail);
  wait(0.5);
  scenario(global_smoke_little_legs);
  wait(0.6);
  scenario(global_smoke_little_legs);
 ifweapon#;
 #ifweapon(0,0,0,0,1);
  wait(0.1);
  reactfx();
  play(dodge);
  scenario(global_snd_dodge_react);
  scenario(global_dodge_trail);
  wait(0.3);
  scenario(global_smoke_little_legs);
  wait(0.85);
  scenario(global_smoke_little_legs);
 ifweapon#;
}

