		},
		"1528": {
			"id": 1528,
			"bot": "280_419_30",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Мой покровитель, ты справишься, я не сомневаюсь в тебе!",
					"femaleText": "Моя покровительница, ты справишься, я не сомневаюсь в тебе!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Что? Я всегда говорю так, когда появляется большая опасность? Прости, но я ведь должна тебя как-то ободрить!",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Ты прав, впереди вновь грозный враг... Взгляни на то, как вздымается песок вдали. Под ним движется громадный хищный червь! Столь огромный, что мог бы проглотить убитого тобой недавно Огра целиком!",
					"femaleText": "Ты права, впереди вновь грозный враг... Взгляни на то, как вздымается песок вдали. Под ним движется громадный хищный червь! Столь огромный, что мог бы проглотить убитого тобой недавно Огра целиком!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				},
				"6": {
					"location": ""
				},
				"7": {
					"location": ""
				},
				"8": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1535": {
			"id": 1535,
			"bot": "1182_1188_31",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Я так рада, так рада снова видеть тебя! Мне тут было одиноко. Я всё думала про то, каким плохим стало всё вокруг. И еще про то, как я могу помочь тебе... Мама подсказала мне.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Тебе нужно будет драться с самым сильным демоном, с Соверингом. Может, победив сначала меня, ты будешь лучше готов к встрече с ним. ",
					"femaleText": "Тебе нужно будет драться с самым сильным демоном, с Соверингом. Может, победив сначала меня, ты будешь лучше готова к встрече с ним. ",
					"location": "left"
				},
				"3": {
					"npc": "1153",
					"maleText": "Хочешь потренироваться со мной? Я стану другой, сильной, как тогда, в деревне... Но если я сделаю тебе больно, не обижайся! Поиграем? Ты готов? ",
					"location": "right"
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1540": {
			"id": 1540,
			"bot": "1182_1188_34",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Что, еле справился с ребёнком? А я только разыгралась! Готов еще раз?!",
					"femaleText": "Что, еле справилась с ребёнком? А я только разыгралась! Готова еще раз?!",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1547": {
			"id": 1547,
			"bot": "1182_1188_38",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Мама говорит, что твои силы растут. Но и мои тоже. Хочешь сыграть ещё раз?",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1556": {
			"id": 1556,
			"bot": "1182_1190_41",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Ты сильный. Но мама говорит, что это не всё, на что я способна. Давай еще раз?",
					"femaleText": "Ты сильная. Но мама говорит, что это не всё, на что я способна. Давай еще раз?",
					"location": "right"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1567": {
			"id": 1567,
			"bot": "1182_1190_46",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Ты бьёшь сильно, иногда мама даже беспокоится за меня. Но нам нельзя останавливаться! Скоро я покажу тебе всё, на что способна.",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1572": {
			"id": 1572,
			"bot": "1182_1190_49",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Мама говорит, что ты тот, кто спасет наш мир. Но даже таким, как ты, нужна тренировка. Если хочешь, мы продолжим нашу игру. Я покажу тебе кое-что новое.",
					"femaleText": "Мама говорит, что ты та кто спасет наш мир. Но даже таким, как ты, нужна тренировка. Если хочешь, мы продолжим нашу игру. Я покажу тебе кое-что новое.",
					"location": "right"
				},
				"2": {
					"npc": "1153",
					"maleText": "Ты спрашиваешь, жива ли моя мама, о которой я так много говорю? Нет. Но её нет и среди умерших.",
					"location": "right"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1579": {
			"id": 1579,
			"bot": "1182_1191_53",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Я хочу, чтобы ты победил Соверинга. Правда, очень-очень хочу!  Если ты справишься со мной и сейчас, я подарю тебе своего медвежонка, он поможет тебе!",
					"femaleText": "Я хочу, чтобы ты победила Соверинга. Правда, очень-очень хочу!  Если ты справишься со мной и сейчас, я подарю тебе своего медвежонка, он поможет тебе!",
					"location": "right"
				},
				"2": {
					"npc": "1153",
					"maleText": "Не смотри на меня так... Он правда поможет! Ты просто еще не знаешь, на что он способен. Его подарила мне мама.",
					"location": "right"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1582": {
			"id": 1582,
			"bot": "281_423_42",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Даже в наших джунглях вздрагивают, когда слышат имя демона Шергергори! Обычный воин с ним ни за что не справится, но в тебя я верю!",
					"location": "left"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1587": {
			"id": 1587,
			"bot": "282_414_31",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Плохой лес. Мама волнуется. Мне дальше нельзя, а ты иди. Я тут подожду, на опушке. Я буду хорошо себя вести, честно-честно!",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Ты же будешь скучать? Я тоже. Ты вернёшься поиграть со мной? Я научу тебя игре в жизнь и смерть.",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1594": {
			"id": 1594,
			"bot": "282_476_32",
			"dialogs": {
				"1": {
					"npc": "1268",
					"maleText": "Глупый чуловек! Куда твоя пришла? Здесь зверга живёт, здесь зверги земля. Уходи скорей!",
					"location": "right"
				},
				"2": {
					"npc": "1268",
					"maleText": "Твоя не будет уходить? Осквернил нашу землю - смерть тебе! Убивать тебя буду! Есть тебя буду!",
					"location": "right"
				},
				"3": {
					"npc": "1186",
					"maleText": "Проклятые зверги! Однажды пытались выкрасть одну из моих сестёр - мы её еле отбили. Выглядят почти людьми, а на самом деле гадкие животные. Хуже обычных мужчин. Да ещё и такие некрасивые!",
					"femaleText": "Проклятые зверги! Однажды пытались выкрасть одну из моих сестёр - еле отбили. Животные неотёсанные... И не моются никогда. Хуже обычных мужчин! Покажи им женскую силу, сестрица!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1606": {
			"id": 1606,
			"bot": "282_477_33",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Я понимаю, почему Уна решила остаться... Чем дальше мы идем, тем сильнее я чувствую темную волю Соверинга. Демон мог пробудить ту силу, что живёт в девочке, и обратить её против нас.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Уна это поняла и осталась ждать у опушки, чтобы не навредить нам. Предчувствие говорит мне, что ты ещё встретишь эту девочку, мой герой.",
					"femaleText": "Уна это поняла и осталась ждать у опушки, чтобы не навредить нам. Предчувствие говорит мне, что ты ещё встретишь эту девочку, моя госпожа.",
					"location": "left"
				},
				"3": {
					"location": ""
