		},
		"1465": {
			"id": 1465,
			"bot": "279_414_29",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Я слышала, в этих краях очень злобные и опасные кабаны. Впрочем, в пивных Бранендаля мне еще не такие свиньи попадались!",
					"location": "left"
