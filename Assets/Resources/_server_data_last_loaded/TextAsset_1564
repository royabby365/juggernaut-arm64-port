		"1619": {
			"id": 1619,
			"bot": "282_478_34",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "Ты что удумал, смертный? С Соверингом тягаться? Твоя наглость ведёт тебя к гибели. К мучительной гибели! Остановись, пока не поздно!",
					"femaleText": "Ты что удумала, смертная? С Соверингом тягаться? Твоя наглость ведёт тебя к гибели. К мучительной гибели! Остановись, пока не поздно!",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "Глупец, твоё оружие тебе не поможет. Ты выступил против сил, которые сметут тебя, как ураган - пушинку. Упорствуешь? Дело твоё...",
					"femaleText": "Глупая женщина, твоё оружие тебе не поможет. Ты выступила против сил, которые сметут тебя, как ураган - пушинку. Упорствуешь? Дело твоё...",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				},
				"6": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1702": {
			"id": 1702,
			"bot": "282_482_35",
			"dialogs": {
				"1": {
					"npc": "1269",
					"maleText": "Пришёл на наша земля, убивал наши зверги - духи очень злые! Не простят тебя! Духи меня совсем сильным сделали - жертва из тебя делать буду!",
					"location": "right"
				},
				"2": {
					"npc": "1186",
					"maleText": "Страшнее обычных звергов только их шаманы! Говорят, каждый день они кого-то в жертву приносят на своём гнусном алтаре. А за это злые духи придают им невиданных сил.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1705": {
			"id": 1705,
			"bot": "283_625_47",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "В этих краях, в тайном месте, скрывается Зверомать, прародительница всех звергов. Мы, амазонки, почитаем женщин, но это наверняка какая-то невообразимая мерзость!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1708": {
			"id": 1708,
			"bot": "284_483_36",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Эти прекрасные джунгли - моя родина! Больше нигде в мире не благоухают так сладко цветы и не поют так заливисто птицы. И таких сладких плодов тебе не найти ни в одной земле!",
					"femaleText": "Эти прекрасные джунгли - моя родина! Больше нигде в мире нет таких красивых цветов и певучих птиц.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Здесь всё нам принадлежало, амазонкам! А мужчин брали в плен - для утех всяких и чтоб работали.",
					"femaleText": "Здесь всё нам принадлежало, амазонкам! А мужчин брали в плен - для утех всяких и чтоб работали. Славная жизнь, правда, госпожа?",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1713": {
			"id": 1713,
			"bot": "284_484_36",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "Я смотрю, ты пропустил мои слова мимо ушей. Напрасно. Костями тебе подобных устлана эта земля. Хочешь к ним присоединиться? ",
					"femaleText": "Я смотрю, ты пропустила мои слова мимо ушей. Напрасно. Костями тебе подобных устлана эта земля. Хочешь к ним присоединиться? ",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "Ты зашёл так далеко, что уже не отделаешься лёгкой смертью - твоим страданиям ужаснутся даже демоны преисподней!",
					"femaleText": "Ты зашла так далеко, что уже не отделаешься лёгкой смертью - твоим страданиям ужаснутся даже демоны преисподней!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1720": {
			"id": 1720,
			"bot": "284_485_37",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "Ты ещё жив, безумец? Твоё удивительное везение не продлится долго! Послушай, я ведь тебе добра желаю - поворачивай назад.",
					"femaleText": "Ты ещё жива, обезумевшая? Твоё удивительное везение не продлится долго! Послушай, я ведь тебе добра желаю - поворачивай назад.",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "Отступишь - сможешь ещё не раз встретить восход. Пойдёшь дальше - окажешься в вечной полуночи. Одумайся, смертный!",
					"femaleText": "Отступишь - сможешь ещё не раз встретить восход. Пойдёшь дальше - окажешься в вечной полуночи. Одумайся, женщина!",
					"location": "left"
				},
				"3": {
					"npc": "1154",
					"maleText": "Спрашиваешь, кто я? Зачем тебе это на том свете... А если чудом выживешь - ещё со мной встретишься. Со мной и моими братьями...",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1731": {
			"id": 1731,
			"bot": "284_486_38",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "Живой человек? В этих проклятых краях? И брюхо не вспорото, и вроде не одержимый... ",
					"femaleText": "Живая дева? В этих проклятых краях? И брюхо не вспорото, и вроде не одержимая... ",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "Это человек, нет сомнений. Мы думали, из смертных тут можно встретить только Того, кто скрывает лицо. Может, ты видел его по пути, незнакомец?",
					"femaleText": "Живая, нет сомнений. Мы думали, из смертных тут можно встретить только Того, кто скрывает лицо. Может, ты видела его по пути, незнакомка?",
					"location": "left"
				},
				"3": {
					"npc": "1145",
					"maleText": "Точно, это он тебе попадался, путник! Думает, что сможет уйти от нас! Да ещё чуть-чуть, и я накину ему петлю на шею. Ответит за всё, что здесь творится! ",
					"femaleText": "Точно, это он тебе попадался, путница! Думает, что сможет уйти от нас! Да ещё чуть-чуть, и я накину ему петлю на шею. Ответит за всё, что здесь творится!",
					"location": "left"
				},
				"4": {
					"npc": "1146",
					"maleText": "Мой напарник в запале говорит лишнее, а нам нужно торопиться. Тебя мы тоже не задерживаем - иди дальше, если жизнь не дорога.",
					"location": "left"
				},
				"5": {
					"location": ""
				},
				"6": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1738": {
			"id": 1738,
			"bot": "284_488_39",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Циклопарики... Ненавижу! Они - заклятые враги амазонок. Сколько мы здесь живём, столько и сражаемся с этим подлым народцем.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Бьют исподтишка, нападают скопом, крадут всё, что плохо лежит. А из уст у них одно сквернословие сыплется! Уверена, ты поставишь их на место, мой герой!",
					"femaleText": "Бьют исподтишка, нападают скопом, крадут всё, что плохо лежит. А из уст у них одно сквернословие сыплется! Поставь их на место, спасительница!",
					"location": "left"
				},
				"3": {
					"npc": "1270",
					"maleText": "Гляди, новая добыча! - Вижу, бью первым! - Нет, я! - Давайте вместе! - Конец тебе, человек, конец!",
					"location": "right"
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1745": {
			"id": 1745,
			"bot": "284_490_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Почти все мои сестры стали одержимыми, как я до встречи с тобой, избавитель. Благородные воительницы превратились в кровожадных чудовищ. Какой страшный конец для нашего племени!",
					"femaleText": "Почти все мои сестры стали одержимыми и превратились в чудовищ, как я до встречи с тобой, избавительница. Какой страшный конец для нашего племени!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Это одна из них... Бедняжка! Сразись с ней, может быть, она излечится, как я. Или хотя бы закончатся её мучения. Но будь осторожен! Амазонки сильны и хитры, а в этой еще и демон сидит! ",
					"femaleText": "Это одна из них... Бедняжка! Сразись с ней, может быть, она тоже излечится. Или хотя бы закончатся её мучения. ",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1748": {
			"id": 1748,
			"bot": "284_489_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Там впереди чудовище с громадными клешнями!.. Такими громадными, что человека пополам перекусить может! Одолеть чудище в бою под силу только тебе, мой герой, и никому больше!",
					"femaleText": "Там впереди чудовище с громадными клешнями!.. Оно ими человека пополам перекусить может! Только тебе удастся победить чудовище, повелительница!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1753": {
			"id": 1753,
			"bot": "285_498_41",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Мне становится дурно от одного вида здешних мест... Какое тяжкое проклятье лежит на этих землях! Древнее зло здесь воцарилось, воистину великое зло...",
					"location": "left"
				},
				"2": {
					"npc": "1185",
					"maleText": "Я жда-а-ал так до-о-олго... В горле ссохло-о-ось... Скоре-е-е выпить твоей кро-о-ови... Утолить жа-а-ажду...",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1762": {
			"id": 1762,
			"bot": "285_497_42",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Смотри, там еще один... Больше всего на свете боюсь оживших мертвецов! Кажется, умру от отвращения, если эта гниль хотя бы коснётся меня своей осклизлой лапой...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Хорошо, что я с тобой, мой благодетель... Ты защитишь меня и спасёшь весь мир, я верю!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1769": {
			"id": 1769,
			"bot": "285_375_43",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "По-прежнему жив? Видно, ты любимец богов, если до сих пор твой труп не расклевали стервятники! Или и впрямь неплохо сражаешься... ",
					"femaleText": "По-прежнему жива? Видно, ты любимица богов, если до сих пор твой труп не расклевали стервятники! Или и впрямь неплохо сражаешься... ",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "Действительно, я чувствую большую силу в тебе, воин. Быть может, ты когда-нибудь нам пригодишься. Но пока мы должны спешить - наша охота ещё не закончена.",
					"femaleText": "Действительно, я чувствую большую силу в тебе, воительница. Быть может, ты когда-нибудь нам пригодишься. Но пока мы должны спешить - наша охота ещё не закончена.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1772": {
			"id": 1772,
			"bot": "285_495_45",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Скелеты не выглядят так противно, как полусгнившие мертвецы, но в бою они даже опасней. Проклятый Соверинг, наверное, поднял их своим чёрным дыханием нам на погибель...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1777": {
			"id": 1777,
			"bot": "285_494_45",
			"dialogs": {
				"1": {
					"npc": "1184",
					"maleText": "Куда ты направляешься с мечом в руке, человек? Здесь владения моего господина, Соверинга, и смертный должен ползти к нему на коленях, посыпая голову песком.",
					"location": "right"
				},
				"2": {
					"npc": "1184",
					"maleText": "Хотя и это тебя не спасёт, наглец. Я не дам тебе потревожить покой моего господина! Он бы превратил тебя в пепел одним взглядом, но покончу с тобой ещё раньше!",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1782": {
			"id": 1782,
			"bot": "286_492_55",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Сердце моё трепещет! Тебе предстоит сразиться с самим Соверингом! Победишь - мир избавится от проклятья, проиграешь - мы все погибнем! Молю богов, чтобы помогли! Да не оставят тебя силы!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1856": {
			"id": 1856,
			"bot": "1181_373_20",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Плохое место. Давай уйдем.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Слышишь? Как будто кости хрустят. Всё ближе...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1858": {
			"id": 1858,
			"bot": "1181_1189_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Пахнет странно... Как та кошка, утонувшая в реке.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1872": {
			"id": 1872,
			"bot": "1862_1863_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Мама говорит, нам тут не рады. Болотные люди не любят гостей.",
					"location": "left"
				},
				"2": {
					"npc": "1868",
					"maleText": "Человек в наших болотах? Нечего тебе здесь делать! Духи трясины, ждите моего подношения!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1876": {
			"id": 1876,
			"bot": "1862_1864_14",
			"dialogs": {
				"1": {
					"npc": "1869",
					"maleText": "Зачем пришёл на нашу землю? Раньше на болота никто не зарился - только мы, Топры, жители трясин, здесь властвовали.",
					"location": "right"
				},
				"2": {
					"npc": "1869",
					"maleText": "Смерть здесь свою найдёшь! Из тины саван тебе будет, лягушки на твоих похоронах - плакальщицами, кочка - могильным холмом!",
					"location": "right"
				},
				"3": {
					"npc": "1869",
					"maleText": "Не уходишь по-хорошему? Сейчас мой воин отправит тебя на корм слизням, готовься!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1880": {
			"id": 1880,
			"bot": "1862_1865_16",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Взрослые говорили, что если я буду плохо себя вести, то стану топром... Думаешь, все они - непослушные дети?",
					"location": "left"
				},
				"2": {
					"npc": "1869",
					"maleText": "Как ты смеешь идти по моему царству и убивать моих воинов? Они все - мои дети! Горько пожалеешь!",
					"location": "right"
				},
				"3": {
					"npc": "1869",
					"maleText": "Один у тебя выход в живых остаться – стать моим слугой навеки! Это лучшая участь для человека. Нет? Тогда умри!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1883": {
			"id": 1883,
			"bot": "1862_1866_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Они очень хитрые. Кто-то близко. Болотная женщина там прячется. Думает, никто её не увидит. Но мама всех видит.",
					"location": "left"
				},
