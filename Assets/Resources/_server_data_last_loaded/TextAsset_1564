				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1515": {
			"id": 1515,
			"bot": "280_426_29",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Мой герой, я должна признаться, что была несправедлива к этой девочке... К Уне. Она добра в душе и очень мудра для своего возраста. Из неё бы получилась отличная амазонка!",
					"femaleText": "Моя покровительница, я должна признаться, что была несправедлива к этой девочке... К Уне. Она добра в душе и очень мудра для своего возраста. Из неё бы получилась отличная амазонка!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Но в ней прячется тёмная сила... Чем ближе мы к логову Соверинга, тем сильнее Уна будет меняться... В худшую сторону. ",
					"femaleText": "Но в ней прячется тёмная сила... Чем ближе мы к логову Соверинга, тем сильнее Уна будет меняться... В худшую сторону, покровительница! ",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
