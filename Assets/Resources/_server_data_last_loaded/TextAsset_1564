		"1474": {
			"id": 1474,
			"bot": "279_415_30",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Хороший бой, мой герой. Смотри, там еще один кабан. Странный, никогда не видела таких...",
					"femaleText": "Хороший бой, защитница. Смотри, там еще один кабан. Странный, никогда не видела таких...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Во всём виноваты жёлуди с дуба, что растет тут. Дуб плохой, он корнями пророс до самого ада... А хрюши поели желудей, упавших с него...",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Поэтому они тоже плохие... Очень-очень злые! Давай спрячемся куда-нибудь!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1481": {
			"id": 1481,
			"bot": "279_417_32",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ты бьешь кабанов и прогоняешь плохих духов из них... Но духи здесь... Я вижу их. Они рядом и они сердятся на нас за то, что мы тревожим их.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Духи движутся...  Они... Они все вместе вселились в одного кабана! Мама говорит, что тут становится слишком опасно! Бежим!",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
