		},
		"1457": {
			"id": 1457,
			"bot": "278_412_25",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Земля дрожит... Это землетрясение?",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Это не землетрясение... Это... шаги! Шаги кого-то очень большого... Он приближается. Я даже боюсь взглянуть в ту сторону... О, Небеса!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
