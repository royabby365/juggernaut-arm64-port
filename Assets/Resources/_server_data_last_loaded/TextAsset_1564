			"minVersion": null,
			"maxVersion": null
		},
		"1490": {
			"id": 1490,
			"bot": "280_418_26",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Мы достигли пустыни, мой прославленный воитель. Здесь так жарко, что хочется скинуть одежды!",
					"femaleText": "Мы достигли пустыни, моя прославленная воительница. Здесь так жарко, что хочется скинуть одежды!",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Я умею видеть дальние места... Такие, где течёт лава и бродят рогатые чудища... Но даже там не так жарко, как в этой ужасной пустыне...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "В пустыне совсем нет воды и земля высохла на многие футы вглубь... Поэтому здешние растения питаются не соками почвы, а путешественниками... Кажется, на горизонте сорняк-людоед!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				},
				"6": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1497": {
			"id": 1497,
			"bot": "280_425_26",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Уже который час я не могу отвести взгляда от земли... Я помню рассказы о том, что в пустынях водятся песчаные акулы... Они могут плыть сквозь песок, будто рыбы в морской воде...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Как ужасно не заметить подобное создание вовремя... Я постоянно начеку и... О нет, кажется, я что-то вижу!..",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1506": {
			"id": 1506,
			"bot": "280_422_28",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Я боюсь. Нет, не чудовищ... Я боюсь себя. Что-то может случиться. Мама, она волнуется. Это похоже на то, что было в деревне. Тогда все умерли. Не хочу больше так. ",
					"location": "left"
				},
				"2": {
