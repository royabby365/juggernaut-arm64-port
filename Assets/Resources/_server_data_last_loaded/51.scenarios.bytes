////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$attack {
 play(attack,15);
 react(f,1);
 scenario(global_sound_attack);
 scenario(template_attack_splash_small);
 scenario(global_shai_ground_fx);
}

$attack_left {
 play(attack_right,12);
 react(r,1);
 scenario(global_sound_attack);
 scenario(template_attack_splash_med);
 scenario(global_shai_ground_fx);
}

$attack_right {
 play(attack_left,25);
 react(l,1);
 scenario(global_sound_attack);
 scenario(template_attack_splash_med);
 scenario(global_shai_ground_fx);
}

$attack_uppercot {
 play(attack_uppercot,25);
 react(u,1);
 scenario(global_sound_attack);
 scenario(template_attack_splash_big);
 scenario(global_shai_ground_fx);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
  	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 light(0,1.5);
 scenario(global_magic_baf_shaiworm_start);
 play(magic,50);
 react(f,0);
 wait(0.2);
 scenario(global_sound_attack);
 scenario(global_magic_direct_fly_shaiworm);
 wait(0.3);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_shaiworm);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_shaiworm);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 light(0,1.5);
 scenario(global_magic_baf_shaiworm_start);
 play(magic_aoe,30);
 scenario(global_magic_aoe_shaiworm_start);
 react(f,0);
 wait(0.2);
 fx(0,fx_snakeleg1,pos_toe_l,1,0.7);
 wait(0.15);
 scenario(global_sound_attack);
 scenario(global_magic_aoe_wave_shaiworm);
 wait(0.2);
 scenario(global_magic_direct_exp_shaiworm);
 light(1,1,0.3);
}

$magic_baf {
 light(0,1.5);
 scenario(global_magic_baf_shaiworm_start);
 play(magic_baf,50);
 scenario(global_magic_baf_shaiworm);
 light(1,1,0.3);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 play(block,35);
 scenario(global_sound_attack);
 vibration(1,2,0);
 scenario(global_react_block);
}

$react_dodge {
 reactfx();
 play(dodge,20);
 fx(0,fx_ground_02,bottom);
 sound(local_dodge);
 wait(1.2);
 scenario(global_smoke_small_legs);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_sound_damage);
 play(damage);
}

$react_dmgf {scenario(react_dmg);}
$react_dmgl {scenario(react_dmg);}
$react_dmgr {scenario(react_dmg);}
$react_dmgu {scenario(react_dmg);}

$react_death  { 
 wait(0.5);
 reactfx();
 sound(local_death);
 play(death);
 fx(0,fx_shaibafstart2,pos_head,1);
 wait(3);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter);    fxpos(dfp1,0,-0.2,0,0);
}

$react_deathf {scenario(react_death);}
$react_deathl {scenario(react_death);}
$react_deathr {scenario(react_death);}
$react_deathu {scenario(react_death);}

////////////////////////////////////////////////////////////////////
// INDIVIDUAL EFFECTS
////////////////////////////////////////////////////////////////////

$ifx_step_r {
  step(1,-1,1);
}

$ifx_step_l {
  step(-1,1,1);
}

$ifx_blood {
 scenario(global_react_blood_green);
}

$ifx_blood_small {
 scenario(global_react_blood_small_green);
}

$ifx_blood_down_splash {
 fx(0,fx_blooddownsplat_Gr,pos_toe_r);
 wait(0.1);
 fx(0,fx_blooddownsplat_Gr,pos_toe_l);
}

$ifx_fatality_blood_splash {
 fx(0,fx_bloodsplat_Gr,pos_spinecenter);
 fx(fbs1,sfx_flesh_Gr,bottom);           fxpos(fbs1,0,1.55,0,1);
 wait(0.5);
 fx(0,fx_bloodsplat_Gr_2,bottom);
}

$ifx_blood_splash {
 fx(0,fx_bloodsplat_Gr,pos_spinecenter);
}

$ifx_blood_fontan {
 fx(0,fx_sizeblood_gr1,pos_head,1);
 fx(0,fx_sizeblood_gr1,pos_spinecenter,1);
 fx(0,fx_sizeblood_gr1,pos_hand_r,1);
 fx(0,fx_sizeblood_gr1,pos_hand_l,1);
 fx(0,fx_sizeblood_gr1,pos_toe_r,1);
 fx(0,fx_sizeblood_gr1,pos_toe_l,1);
}

$ifx_blood_screen {
 #random(25); fx(0,fx_bloodekran_Gr_L);  random#;
 #random(25); fx(0,fx_bloodekran_Gr_R);  random#;
 #random(50); fx(0,fx_bloodekran_Gr_RD); random#;
 #random(50); wait(0.05);                random#;
 #random(50); fx(0,fx_bloodekran_Gr_LD); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Gr_RU); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Gr_LU); random#;
}

$ifx_fatality_damage {
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
}

$ifx_fatality_fly {
 moveto(0,3,0,1);
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
 moveto(0,-3,0,0.1); 
 playpart(death,1,45,100);
}

$ifx_fatality_down_blood {
 playpart(damage,0.75,10,30);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,10,30);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,10,30);
 scenario(ifx_blood_down_splash);
}

//////////////////////////////
// TRIGGERS AND OTHER
//////////////////////////////

$onshow {
 scenario(global_onshow);
 fx(0,fx_ground_01,bottom,1,-1);
}

$onidle {
 wait(0.4);
 sound(local_idle);
}

$onhide {
 scenario(global_onhide);
}