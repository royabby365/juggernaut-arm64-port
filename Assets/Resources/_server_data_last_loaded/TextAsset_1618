		"1528": {
			"id": 1528,
			"bot": "280_419_30",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "My protector, you will succeed, I have faith in you!",
					"femaleText": "My protector, you will succeed, I have faith in you!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "What? Do I always say that when there is great danger? I'm sorry, but I have to encourage you somehow!",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "You are right, there is another menacing enemy ahead... Look how the sand is being whipped up in the distance. An enormous predatory worm is slithering underneath it! It is so huge that it could swallow the Ogre that you recently killed in one mouthful!",
					"femaleText": "You are right, there is another menacing enemy ahead... Look how the sand is being whipped up in the distance. An enormous predatory worm is slithering underneath it! It is so huge that it could swallow the Ogre that you recently killed in one mouthful!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				},
				"6": {
