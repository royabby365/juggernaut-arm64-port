			"minVersion": null,
			"maxVersion": null
		},
		"1535": {
			"id": 1535,
			"bot": "1182_1188_31",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I am so happy to see you again! I was lonely here alone. I kept thinking about how bad things have become. But I also thought about how I can help you... Mama suggested it to me.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "You will have to fight against the strongest demon of all - against Sovering. Maybe if you defeat me first, you will be better prepared to fight against him.",
					"femaleText": "You will have to fight against the strongest demon of all - against Sovering. Maybe if you defeat me first, you will be better prepared to fight against him.",
					"location": "left"
				},
				"3": {
					"npc": "1153",
					"maleText": "Do you want to train with me? I will change, become strong like I was in the village... But if I hurt you, don't be offended. Shall we do it? Are you ready?",
					"location": "right"
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1540": {
			"id": 1540,
			"bot": "1182_1188_34",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "What, you barely managed to overcome a child? But I was only getting warmed up! Are you ready for another go?!",
					"femaleText": "What, you barely managed to overcome a child? But I was only getting warmed up! Are you ready for another go?!",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1547": {
			"id": 1547,
			"bot": "1182_1188_38",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Mama says that your powers are growing. So are mine. Do you want to go again?",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1556": {
			"id": 1556,
			"bot": "1182_1190_41",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "You are strong. But mama says that I am capable of more. Shall we do it again?",
					"femaleText": "You are strong. But mama says that I am capable of more. Shall we do it again?",
					"location": "right"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1567": {
			"id": 1567,
			"bot": "1182_1190_46",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "You hit hard, sometimes mama is even worried about me. But we cannot stop! Soon I will show you all that I am capable of.",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1572": {
			"id": 1572,
			"bot": "1182_1190_49",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Mama says that you are the one who will save our world. But even someone like you needs training. If you want, we can continue our game. I will show you something new.",
					"femaleText": "Mama says that you are the one who will save our world. But even someone like you needs training. If you want, we can continue our game. I will show you something new.",
					"location": "right"
				},
				"2": {
					"npc": "1153",
					"maleText": "You ask if my mama, who I speak of so often, is still alive? No. But neither is she among the dead.",
					"location": "right"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1579": {
			"id": 1579,
			"bot": "1182_1191_53",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "I want you to defeat Sovering. I really, truly want that! If you defeat me again now, I will give your my teddy, he will help you.",
					"femaleText": "I want you to defeat Sovering. I really, truly want that! If you defeat me again now, I will give your my teddy, he will help you.",
					"location": "right"
				},
				"2": {
					"npc": "1153",
					"maleText": "Stop looking at me like that... He really will help. You just don't know what he is capable of. Mama gave him to me.",
					"location": "right"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1582": {
			"id": 1582,
			"bot": "281_423_42",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Even in our jungles, people shiver when they hear the name of the demon Sovering! No ordinary warrior could overcome him, but I have faith in you!",
					"location": "left"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1587": {
			"id": 1587,
			"bot": "282_414_31",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "This is a bad forest. Mama is worried. I cannot go any further, but you go. I will wait here, on the edge. I will behave myself, I promise!",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Will you miss me? I'll miss you. Will you come back to play with me? I will teach you the game of life and death.",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1594": {
			"id": 1594,
			"bot": "282_476_32",
			"dialogs": {
				"1": {
					"npc": "1268",
					"maleText": "Stupid human! What you do here? Here Zvergs live, here Zverg land. Go!",
					"location": "right"
				},
				"2": {
					"npc": "1268",
					"maleText": "You will not go? You defile our land - you die! I kill you! I eat you!",
					"location": "right"
				},
				"3": {
					"npc": "1186",
					"maleText": "Cursed Zvergs! Once they tried to kidnap one of my sisters - we only barely managed to get her back. They look almost human, but in fact they are vile beasts. They are even worse than ordinary men. And they are ugly too!",
					"femaleText": "Cursed Zvergs! Once they tried to kidnap one of my sisters - we only barely managed to get her back... And they never wash. They are even worse than ordinary men. Show them what a woman is capable of, sister!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1606": {
			"id": 1606,
			"bot": "282_477_33",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "I understand why Una decided to stay... The further we go, the more I can sense the dark will of Sovering. The demon might have awoken the power that lurks within the girl and turned it against you.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Una understood this and stayed at the edge, so as not to harm us. I have a feeling that you will meet this girl again, my hero.",
					"femaleText": "Una understood this and stayed at the edge, so as not to harm us. I have a feeling that you will meet this girl again, my lady.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1619": {
			"id": 1619,
			"bot": "282_478_34",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "What are you planning, mortal? To take on Sovering. Your impudence will be your ruin. Your death will be torturous! Stop before it is too late!",
					"femaleText": "What are you planning, mortal? To take on Sovering. Your impudence will be your ruin. Your death will be torturous! Stop before it is too late!",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "Fool, your weapon will not help you. You are taking on a power that will crush you like an insect. You are determined? It is your loss...",
					"femaleText": "Stupid woman, your weapon will not help you. You are taking on a power that will crush you like an insect. You are still determined? It's your loss...",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				},
				"6": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1702": {
			"id": 1702,
			"bot": "282_482_35",
			"dialogs": {
				"1": {
					"npc": "1269",
					"maleText": "You come to our land, kill our Zvergs - the spirits are angry! They will not forgive you! The spirits have made me strong - I will make you into a sacrifice!",
					"location": "right"
				},
				"2": {
					"npc": "1186",
					"maleText": "The only thing more terrible than a regular Zverg are their Shamans! They say that every day they bring a victim to sacrifice on their vile altar. In exchange the evil spirits give them unheard of powers.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1705": {
			"id": 1705,
			"bot": "283_625_47",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "In these lands, in this secret place, lives the Matriarch, the mother of all Zvergs. We Amazons respect women, but this one must be an unimaginably vile creature.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1708": {
			"id": 1708,
			"bot": "284_483_36",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "These beautiful jungles are my native land! Nowhere else in the world do the flowers smell so sweet and the birds sing so merrily. And you will not find tastier fruit in any other land!",
					"femaleText": "These beautiful jungles are my native land! Nowhere else in the world will you find such beautiful flowers and melodious birds.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Everything here belonged to us Amazons. We took men captive - for pleasure and to perform work.",
					"femaleText": "Everything here belonged to us Amazons. We took men captive - for pleasure and to perform work. A wonderful life, don't you think, my lady?",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1713": {
			"id": 1713,
			"bot": "284_484_36",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "I see that you ignored what I said. You shouldn't have. Many bones like yours are buried in this land. Do you want yours to join them?",
					"femaleText": "I see that you ignored what I said. You shouldn't have. Many bones like yours are buried in this land. Do you want your to join them?",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "You have gone so far that you will not escape with an easy death - your suffering will make even the demons of the underworld wince!",
					"femaleText": "You have gone so far that you will not escape with an easy death - your suffering will make even the demons of the underworld wince!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1720": {
			"id": 1720,
			"bot": "284_485_37",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "You are still alive, madman? Your surprising determination will not last much longer! Listen, I tell you for your own sake - turn back.",
					"femaleText": "You are still alive, madwoman? Your surprising determination will not last much longer! Listen, I tell you for your own sake - turn back.",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "Retreat and you may live to see another dawn. Continue on and you will be plunged into eternal dusk. Think hard, mortal!",
					"femaleText": "Retreat and you may live to see another dawn. Continue on and you will be plunged into eternal dusk. Think hard, woman!",
					"location": "left"
				},
				"3": {
					"npc": "1154",
					"maleText": "You ask who I am? You won't need to know in the next world... And if by some miracle your survive - you will meet me again. Me and my brothers...",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1731": {
			"id": 1731,
			"bot": "284_486_38",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "A living man? In these cursed lands? Your stomach is not ripped open, you don't seem to be possessed...",
					"femaleText": "A living woman? In these cursed lands? Your stomach is not ripped open, you don't seem to be possessed...",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "It is a man, no doubt about it. We thought that the only mortal that we would encounter here is the One who hides his face. Perhaps you saw him on your way, stranger?",
					"femaleText": "Alive, no doubt about it. We thought that the only mortal that we would encounter here is the One who hides his face. Perhaps you saw him on your way, stranger?",
					"location": "left"
				},
				"3": {
					"npc": "1145",
					"maleText": "You have met him for sure, traveller! He thinks that he can get away from us! Pretty soon I will get a noose around his neck. He will pay for everything that is happening here.",
					"femaleText": "You have met him for sure, traveller! he thinks that he can get away from us! Pretty soon I will get a noose around his neck. He will pay for everything that is happening here.",
					"location": "left"
				},
				"4": {
					"npc": "1146",
					"maleText": "My companion has said too much in his anger, but we must hurry. We won't detain you any further - go on your way, if you value your life.",
					"location": "left"
				},
				"5": {
					"location": ""
				},
				"6": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1738": {
			"id": 1738,
			"bot": "284_488_39",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Cyclopticuses - I hate them! They are the cursed enemies of the Amazons. We have been fighting these vile creatures for as long as we have lived here.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "They ambush you, attack in packs and steal everything that isn't nailed down. And only profanities issue from their mouths. I am certain that you will put them in their place, my hero!",
					"femaleText": "They ambush you, attack in packs and steal everything that isn't nailed down. And only profanities issue from their mouths. Put them in their place, my saviour!",
					"location": "left"
				},
				"3": {
					"npc": "1270",
					"maleText": "Look, new prey! - I get to strike first! No, me! Let's do it together! Prepare to die, human, die!",
					"location": "right"
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1745": {
			"id": 1745,
			"bot": "284_490_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Almost all my sisters have become possessed, like I was before I met you, my redeemer. Noble warriors transformed into bloodthirsty monsters. What a terrible end for our tribe!",
					"femaleText": "Almost all my sisters have become possessed and have transformed into monsters, like I was before I met you, my redeemer. What a terrible end for our tribe!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "That's one of them - The poor thing! Fight her, perhaps she can be healed like me. Or at least you will end her suffering. But be careful! Amazons are cunning and strong, and this one has a demon inside her!",
					"femaleText": "That's one of them - The poor thing! Fight her, perhaps she can be healed like me. Or at least you will end her suffering.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1748": {
			"id": 1748,
			"bot": "284_489_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Ahead there is a monster with huge claws!... So huge that they could snap a person in half! Only you and nobody else can defeat this monster, my hero!",
					"femaleText": "Ahead there is a monster with huge claws!... It could snap a person in half with them! Only you can defeat this monster, my protector!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1753": {
			"id": 1753,
			"bot": "285_498_41",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "The very appearance of this place sickens me... There is some terrible curse hanging over these lands! An ancient evil reigns here, a truly great evil...",
					"location": "left"
				},
				"2": {
					"npc": "1185",
					"maleText": "I have waited for so long.... My throat is dry. I want to drink your blood.... To quench my thirst...",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1762": {
			"id": 1762,
			"bot": "285_497_42",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Look, there's another one.... More than anything I am afraid of Resurrected Corpses! I think I will die of disgust if that vile creature even touches me with one of its putrid fingers...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "It is good that you are here, my benefactor... You will defend me and save the world, I am sure of it!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1769": {
			"id": 1769,
			"bot": "285_375_43",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "Still alive? The gods must favour you if your corpse has not yet been ripped apart by vultures! Or perhaps you really do fight well...",
					"femaleText": "Still alive? The gods must favour you if your corpse has not yet been ripped apart by vultures! Or perhaps you really do fight well...",
					"location": "left"
				},
				"2": {
					"npc": "1146",
