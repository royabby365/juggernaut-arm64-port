			"minVersion": null,
			"maxVersion": null
		},
		"1515": {
			"id": 1515,
			"bot": "280_426_29",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "My hero, I have to say I was unfair to that girl... To Una. She is kind-hearted and very wise for her age. She would make an excellent Amazon!",
					"femaleText": "My protector, I have to say I was unfair to that girl... To Una. She is kind-hearted and very wise for her age. She would make an excellent Amazon!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "But there are dark forces hidden within her... The closer we get to Sovering's lair, the more Una will change... For the worse.",
					"femaleText": "But there are dark forces hidden within her... The closer we get to Sovering's lair, the more Una will change... For the worse.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
