{
	"dialogs": {
		"1147": {
			"id": 1147,
			"bot": "52_125_5",
			"dialogs": {
				"1": {
					"npc": "1270",
					"maleText": "Cyclopticuses: What fun, what fun! A living, breathing person! I will bite your leg! I will spit in your eye! I will rip off your ear! What fun, what fun! You are for it now!",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1155": {
			"id": 1155,
			"bot": "236_239_8",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I knew that you would come. Mama told me that I would have some friends.... I am Una. I am from the nearby village... I will never go back there. I am coming with you.",
					"femaleText": "I knew that you would come. Mama told me that I would have some friends.... I am Una. I am from the nearby village... I will never go back there. I am coming with you.",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1156": {
			"id": 1156,
			"bot": "236_240_9",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I probably shouldn't say what happened in the village. I ran off without permission, to pick berries in the forest. And when I returned, the people had become bad. Very bad.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "They were not like themselves at all. They were like something pretending to be human, like the wolf in the fairy tale. I called out, but nobody answered me.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "The people in the village changed... They rushed at me, I barely managed to escape.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "When I think of it, I cling to my teddy and I cry bitterly... You won't hurt me, will you? I am so happy I met you. Mama also says that it is good.",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1157": {
			"id": 1157,
			"bot": "236_241_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "You ask where my mama is? She is here, she talks to me. If you want to say something to her, I will pass on your words.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Why are you looking at me like that? I don't like it when people look at me like that... Terrible things can happen!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1158": {
			"id": 1158,
			"bot": "236_49_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Stop? Do you hear? The swamp man is moaning... Mama showed him to me. At one time he was like everyone else, but then he drowned in the swamp and he changed. He is terrible, and he wants to kill us...",
					"location": "left"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1159": {
			"id": 1159,
			"bot": "275_398_14",
			"dialogs": {
				"1": {
					"npc": "1271",
					"maleText": "Hand over your things! I won't ask you twice! If you hand them over, I will let you walk out of here. If you delay, you will crawl away on all fours. And if you refuse, this is where you will meet your maker!",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1317": {
			"id": 1317,
			"bot": "276_369_12",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I like going with you like this. It's as if we are just having a walk, and I am an ordinary child.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Mama says that I scare you. Are you really scared of a little girl?",
					"femaleText": "Mama says that I scare you. Are you really scared of a little girl?",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1320": {
			"id": 1320,
			"bot": "276_124_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "You fight so funny, waving your sword as if you were dancing! It's a pity that mama won't let me teach you yet what we know about fighting...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1325": {
			"id": 1325,
			"bot": "276_493_15",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "He is following us. Can you hear his footsteps? I can hear them. I sense his presence. He is unwell. He is suffering.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "He is starving. He is used to eating people. But he hasn't met anybody in a long time, only spiders and bats. He will eat us.... For sure!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1328": {
			"id": 1328,
			"bot": "1181_498_19",
			"dialogs": {
				"1": {
					"npc": "1185",
					"maleText": "Living meat... Warm.... Down below, I hungered for warm food.... You are just in time, mortal.... I will feed on your flesh...",
					"location": "right"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1378": {
			"id": 1378,
			"bot": "275_399_14",
			"dialogs": {
				"1": {
					"npc": "1272",
					"maleText": "You think that because you dealt with the others, you can handle me? Do you know how many people I have killed? There is no graveyard in existence that could hold them all!",
					"femaleText": "You think that because you dealt with the others, you can handle me? Do you know how many people I have killed? There is no graveyard in existence that could hold them all!",
					"location": "right"
				},
				"2": {
					"npc": "1272",
					"maleText": "I will rip you to shreds! I'll make a goblet from your skull, a necklace from your teeth and flutes from your bones!",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1383": {
			"id": 1383,
			"bot": "277_400_16",
			"dialogs": {
				"1": {
					"npc": "1187",
					"maleText": "Fall to your knees before Sovering, you miserable creature!",
					"femaleText": "Fall to your knees before Sovering, you miserable creature!",
					"location": "right"
				},
				"2": {
					"npc": "1187",
					"maleText": "The lord can see you through my eyes, and he wants you to fall to your knees! If you resist, he will fill me with great strength, and I will rip you to shreds!",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1388": {
			"id": 1388,
			"bot": "277_401_17",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Don't rush for your weapon, great warrior! I have returned to thank you, not to attack you again! By defeating me in combat you drove the demonic spirit of Sovering from inside me!",
					"femaleText": "Don't rush for your weapon, great warrior! I have returned to thank you, not to attack you again! By defeating me in combat you drove the demonic spirit of Sovering from inside me!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "My name is Ariana, and I owe you my life! According to the laws of the Amazon tribe, I will serve you from now until the end of my days. Give me a little time to heal my wounds, and I will follow you to the ends of the world!",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1391": {
			"id": 1391,
			"bot": "277_402_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I don't like this woman that you have taken along with you. The Amazon. Get rid of her. Please. You hear? Get rid of her, get rid of her, get rid of her!",
					"femaleText": "I don't like this woman that you have taken along with you. The Amazon. Get rid of her. Please. You hear? Get rid of her, get rid of her, get rid of her!",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1398": {
			"id": 1398,
			"bot": "277_403_18",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Forgive me, my saviour, I didn't mean to speak of this, but I cannot hold my tongue any longer. This... erm... girl that is travelling with us.... In Branendal people tremble at the very thought of her! She is possessed by a demon!",
					"femaleText": "Forgive me, my saviour, I didn't mean to speak of this, but I cannot hold my tongue any longer. This... erm... girl that is travelling with us.... In Branendal people tremble at the very thought of her! She is possessed by a demon!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Did she tell you that she escaped from her village? Don't believe her! The brat killed her people, and now she wants to get her claws into us!",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Why is she saying that?... Do you also think that I did something wrong? It's not true. I have behaved myself, honestly!..",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1407": {
			"id": 1407,
			"bot": "277_404_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Una is bad, Una is a liar. My people, my village.... I lied. In truth, I did not run off....",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "But they attacked me first! I didn't mean it, honestly! I was just more scared than I had ever been.... And something happened.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "And then they all burned and died. They all died. All our family, neighbours, the whole village... I did bad. But mama says that it had to be done.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Because otherwise they would have killed me... They all became bad because of Sovering. They chased after me. I am going to start crying. Please don't chase me away...",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1414": {
			"id": 1414,
			"bot": "277_405_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I have been crying all day... You will forgive me for what I did in the village, won't you? Please, forgive me and let me come with you...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Apart from you, I have no friends. I only have my teddy and mama to look after me...",
					"femaleText": "Apart from you, I have no friends. I only have my teddy and mama to look after me...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "I am beginning to feel sorry for this girl. Perhaps she is not so terrible as I thought... Allow her to stay, my hero. Perhaps she can even help you on your perilous journey.",
					"femaleText": "I am beginning to feel sorry for this girl. Perhaps she is not so terrible as I thought... Allow her to stay, my lady. Perhaps she can even help you on your perilous journey.",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1425": {
			"id": 1425,
			"bot": "277_469_20",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Wait... I know that you have no choice but to go forward, but I am so scared for you, my protector!.. Nothing could be worse than losing you....",
					"femaleText": "Wait... I know that you have no choice but to go forward, but I am so scared for you, my protector!.. Nothing could be worse than losing you....",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Why am I so worried? Believe me, I have reason to be. Horned Koren is on his way here, he was the undisputed champion of the warrior tournaments that were held before we had ever heard of Sovering...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Horned Koren is so powerful that he can wield a sword as long as a person as if it were a feather!",
					"location": "left"
				},
				"4": {
					"npc": "1186",
					"maleText": "This sword can slice a horseman in two, along with his horse! I wouldn't say this if I hadn't seen it with my own eyes!",
					"location": "left"
				},
				"5": {
					"npc": "1186",
					"maleText": "Koren was able to kill anybody with a single blow when he was human. Now he is possessed by Sovering and full of demonic power. All I ask is that you be careful. For the sake of Radway, for my sake....",
					"femaleText": "Koren was able to kill anybody with a single blow when he was human. Now he is possessed by Sovering and full of demonic power. All I ask is that you be careful. For the sake of Radway, for my sake....",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1430": {
			"id": 1430,
			"bot": "278_413_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I had a terrible dream. I awoke and trembled with fear until morning.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "In the dream I saw creatures as old as time, and as powerful as the mountains... Weapons cannot pierce their crystal bodies... Mama says that it was just a dream.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1435": {
			"id": 1435,
			"bot": "278_409_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Now I can feel Their power... People are so puny compared to Them...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "They are there, ahead of us... The crystal creatures... They have no souls, but They are angry that They have been awoken... Very, very angry... Aren't you afraid? You should be!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1444": {
			"id": 1444,
			"bot": "278_407_23",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "In my heart I sense that there is misfortune to come! I am so worried for you, my hero.",
					"femaleText": "In my heart I sense that there is misfortune to come! I am so worried for you, my protector.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Ahead I saw a creature that I have never seen before. But I remember some legends about creatures like this. They are called Crystallides, it is said that they lived many centuries ago, then they fell asleep...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Please, take care of yourself! After all, you are the only one that can save our poor Radway!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1452": {
			"id": 1452,
			"bot": "278_411_25",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "You fight brilliantly, my benefactor! You know, I have been thinking about how much misfortune has befallen the world... First the demon Sovering, now these stone giants....",
					"femaleText": "You fight brilliantly, my benefactor! You know, I have been thinking about how much misfortune has befallen the world... First the demon Sovering, now these stone giants....",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "It can't be just a coincidence... Somebody is behind all this villainy... Someone's evil hand awoke both the demon and the giants... Somebody that is both a skilled black magician and an elementalist at the same time...",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1457": {
			"id": 1457,
			"bot": "278_412_25",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "The ground is trembling... Is it an earthquake?",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "It is not an earthquake... It is... footsteps! The footsteps of someone very big... They are getting closer. I am afraid to even look... O, mercy!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1465": {
			"id": 1465,
			"bot": "279_414_29",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "I have heard that there are some very fierce and dangerous boars in these parts. However, I have had to deal with worse pigs in the pubs in Branendal!",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1474": {
			"id": 1474,
			"bot": "279_415_30",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "A good fight, my hero. Look, there's another boar. It's strange, I have never seen anything like it...",
					"femaleText": "A good fight, my protector. Look, there's another boar. It's strange, I have never seen anything like it...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "It's all because of the acorns from the oak that grows over there. It's an evil oak, it's roots stretch down to hell itself... The pigs eat the acorns that fall from it...",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "So they are bad too... Very, very bad! Let's hide somewhere!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1481": {
			"id": 1481,
			"bot": "279_417_32",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "You kill the boars and expel the evil spirits from them... But the spirits are here... I can see them. They are beside us, and they are angry that we have disturbed them.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "The spirits are moving... They... They have all entered the body of one boar! Mama says that it's about to get very dangerous here! Run!",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1490": {
			"id": 1490,
			"bot": "280_418_26",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "We have reached the desert, my brave warrior. It is so hot here that you want to peel off layers of clothing!",
					"femaleText": "We have reached the desert, my brave warrior. It is so hot here that you want to peel off layers of clothing!",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "I am able to see distant lands... Lands where lava flows and horned monsters roam... But even there it is not as hot as in this terrible desert...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "In the desert there is no water, and the land has dried out several foot deep... As a result, the plants that grow here do not feed on liquid from the soil, but on travellers... I think I can see a cannibal weed on the horizon!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				},
				"6": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1497": {
			"id": 1497,
			"bot": "280_425_26",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "I haven't been able to tear my gaze away from the land for hours.... I remember tales about sand sharks that roam the desert... They can swim through the sand, like fish in the sea....",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "How terrible it would be if a creature like that sneaked up on us... I will stand guard and... Oh no! I think I see something!",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1506": {
			"id": 1506,
			"bot": "280_422_28",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I am afraid. No, not of the monster... I am afraid of myself. Something may happen. Mama is worried. It is like that happened in the village. When they all died. I can't go on like this.",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				},
				"4": {
