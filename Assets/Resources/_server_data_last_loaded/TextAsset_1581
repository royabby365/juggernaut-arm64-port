//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 sound(local_attack,0.1);
 play(attack,30);
 react(f,1);
 scenario(template_attack_splash_med);
}

$attack_left {
 sound(local_attack_left,0.2);
 play(attack_left,45);
 react(r,1);
 scenario(template_attack_splash_big);
}

$attack_right {
 sound(local_attack_right,0.5);
 play(attack_right,45);
 react(l,1);
 scenario(template_attack_splash_big);
}

$attack_uppercot {
 sound(local_attack_uppercut,0.2);
 play(attack_uppercot,30);
 react(l,1);
 scenario(template_attack_splash_big);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
  	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 sound(local_magic_attack,0.2);
 light(0,1.5);
 scenario(global_magic_baf_cyclopariki_prestart);
 play(magic,20);
 scenario(global_magic_direct_fly_cyclopariki);
 react(f,0);
 wait(0.5);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_tiger);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_tiger);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 sound(local_magic_aoe,0.2);
 light(0,2);
 scenario(global_magic_baf_cyclopariki_prestart);
 play(magic_aoe,10);
 scenario(global_magic_aoe_demongirl_start);
 wait(0.3);
 scenario(global_magic_aoe_demongirl_start);
 wait(0.3);
 scenario(global_magic_aoe_demongirl_start);
 wait(0.3);
 scenario(global_magic_aoe_demongirl_start);
 react(f,0);
 wait(0.5);
 scenario(global_magic_aoe_wave_demongirl);
 wait(0.2);
 scenario(global_magic_direct_exp_tiger);
 light(1,0.5,0);
}

$magic_baf {
 sound(local_magic_buff,0.2);
 light(0,1.5);
 scenario(global_magic_baf_cyclopariki_prestart);
 play(magic_baf,40);
 scenario(global_magic_baf_cyclopariki_prestart);
 wait(1.2);
 scenario(global_magic_baf_demongirl);
 light(1,1,0.3);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 sound(local_block,0.2);
 play(block,30);
 vibration(1,2,0);
 scenario(global_react_block);
}

$react_dodge {
 reactfx();
 scenario(global_snd_mob2_dodge );
 play(dodge);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage);
}

$react_dmgf {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 scenario(global_smoke_fly);
 play(damage_force);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
}

$react_dmgl {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 scenario(global_smoke_fly);
 play(damage_force);
 step(0,-1,0,3);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(1);
 enemyscenario(ifx_step_r);
}

$react_dmgr {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 scenario(global_smoke_fly);
 play(damage_force);
 step(0,1,0,3);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(1);
 enemyscenario(ifx_step_l);
}

$react_dmgu {scenario(react_dmgf);}

$react_death  { 
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death );
 play(death);
 wait(0.3);
 scenario(global_smoke_big_torso);
 wait(1);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter); fxpos(dfp1,0,0.1,0,0);
}

$react_deathf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death_force);
 play(death_force);
 wait(0.5);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(0.8);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter); fxpos(dfp1,0,-0.1,0,0);
}

$react_deathl {scenario(react_deathf);}
$react_deathr {scenario(react_deathf);}
$react_deathu {scenario(react_deathf);}

