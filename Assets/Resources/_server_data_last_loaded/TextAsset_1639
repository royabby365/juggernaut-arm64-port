		},
		"TutBagMoney": {
			"id": 928,
			"code": "TutBagMoney",
			"text": "Zdobyłeś artefakt, dający Ci bonus \"pieniądze\". Bonus ten określa, ile dodatkowego złota dostaniesz po zwycięskich walkach."
		},
		"TutBagRage": {
			"id": 925,
			"code": "TutBagRage",
			"text": "Zdobyłeś artefakt, dający Ci bonus \"gniew\". Bonus ten określa, ile dodatkowych grudek wściekłości możesz zdobyć w walce. Jeśli wartość bonusu wynosi 1, oznacza to, że z dużym prawdopodobieństwem zdobędziesz 1 dodatkową grudkę wściekłości."
		},
		"TutBattleTurn": {
			"id": 915,
			"code": "TutBattleTurn",
			"text": "Zwróć uwagę na to, że walka w grze odbywa się ruchami. Najpierw uderzasz Ty, kolejny ruch należy do przeciwnika. Na każdy ruch masz kilka sekund. W górnej części ekranu znajduje się czerwony pasek, pokazujący czas, jaki został do końca ruchu."
		},
		"TutEndChests": {
			"id": 916,
			"code": "TutEndChests",
			"text": "Wykopałeś już wszystkie schowane tutaj skarby. Nowe znajdziesz na innych wyzwolonych terytoriach."
		},
		"TutEpicItemPuton": {
			"id": 1201,
			"code": "TutEpicItemPuton",
			"text": "Pojawiła się u Ciebie epicka rzecz, którą możesz ulepszyć do legendarnej. Musisz w tym celu włożyć do niej punkty legendarności, które otrzymujesz za każdą walkę, zgodnie z rankingiem."
		},
		"TutEye": {
			"id": 818,
			"code": "TutEye",
			"text": "Zgromadzona przez Ciebie wściekłość przyciąga Oko Chaosu, które się nią żywi. Im więcej zebrałeś wściekłości, tym częściej pojawi się Oko. Musisz unicestwić Oko Chaosu, zanim zdąży pochłonąć Twoją wściekłość."
		},
		"TutEye_2": {
			"id": 823,
			"code": "TutEye_2",
			"text": "Aby zniszczyć Oko Chaosu, naciskaj na nie tak długo, aż eksploduje"
		},
		"TutFallingStarPhrase1": {
			"id": 1244,
			"code": "TutFallingStarPhrase1",
			"text": "Czasami podczas walki ujrzysz spadającą gwiazdę. Złap ją szybko, żeby otrzymać premiowy punkt legendarności na końcu walki."
		},
		"TutFallingStarPhrase2": {
			"id": 1245,
			"code": "TutFallingStarPhrase2",
			"text": "Naciśnij na gwiazdę, żeby otrzymać bonus na końcu walki"
		},
		"TutFirstMagicBook": {
			"id": 948,
			"code": "TutFirstMagicBook",
			"text": "W tej magicznej księdze możesz uczyć się nowych zaklęć oraz doskonalić już opanowane. Potrzebne są Ci w tym celu magiczne czaszki i określone magiczne mistrzostwo. Zwiększyć ostatnie możesz, stosując w walce magię."
		},
		"TutFirstMobAttack": {
			"id": 947,
			"code": "TutFirstMobAttack",
			"text": "Na to terytorium napadł agresywny potwór. Musisz jak najszybciej go zabić, w przeciwnym razie będzie on siać śmierć wśród miejscowej ludności. "
		},
		"TutFirstMoneyPile": {
			"id": 922,
			"code": "TutFirstMoneyPile",
			"text": "Na wyzwolonych terytoriach miejscowy lud zbiera dla Ciebie złoto. Im więcej ludności, tym więcej materialnych korzyści. Zaludnienie rośnie automatycznie wraz z upływem czasu. Wracaj co jakiś czas na wyzwolone ziemie, żeby zabrać zebrane dla Ciebie złoto."
		},
		"TutGotLevel": {
			"id": 934,
			"code": "TutGotLevel",
			"text": "Przeszedłeś na nowy poziom, dostępne stały się dla Ciebie trzy nowe rzeczy. Idź do sklepu i kup pas, naręczak oraz kirys, dzięki którym nabierzesz siły. Czeka Cię walka z bossem, te rzeczy Ci w niej pomogą."
		},
		"TutImmBattle": {
			"id": 907,
			"code": "TutImmBattle",
			"text": "Zastosowałeś magię, na którą przeciwnik ma immunitet. Rzuć alternatywne zaklęcia. Magiczny immunitet przeciwnika wyświetla się przed walką obok jego nazwy."
		},
		"TutImmZ": {
			"id": 908,
			"code": "TutImmZ",
			"text": "Masz do czynienia z wrogiem, który ma immunitet na określone rodzaje magii. Wyświetla się on w postaci symbolu magii po prawej stronie nazwy potwora. W walce z nim staraj się użyć innej magii. Jeśli nie jest Ci takowa znana, możesz nadrobić zaległości w magicznej księdze."
		},
		"TutLocationScarab": {
			"id": 924,
			"code": "TutLocationScarab",
			"text": "Po wyzwoleniu terytorium z potworów możesz poświęcić się szukaniu ukrytych tam skrzyni ze skarbami. Wśród skarbów można znaleźć magiczne amulety, pierścienie, kolczyki i inne nader przydatne przedmioty. W celu poszukiwań skarbów naciśnij ten przycisk."
		},
		"TutMagicBookButton": {
			"id": 990,
			"code": "TutMagicBookButton",
			"text": "Wraz z umiejętnością czary\" zdobyłeś dostęp do księgi magii.\""
		},
		"TutPlayerDefeat": {
			"id": 923,
			"code": "TutPlayerDefeat",
			"text": "Za przegraną walkę nie czeka Cię żadna kara i możesz ponownie do niej przystąpić. Jeśli nie uda Ci się pokonać wroga, zakończ walkę i zajrzyj do sklepu. Kup dostępne części uzbrojenia i amunicję, żeby wzmocnić swoją postać."
		},
		"TutResurrection": {
			"id": 834,
			"code": "TutResurrection",
			"text": "Przy ciosach kombo istnieje prawdopodobieństwo przyswojenia duszy wroga, która mieści się w specjalnym przedmiocie - Ankh. Po pokonaniu przeciwnika Ankh automatycznie wskrzesza go i przeprowadza nad nim\nkrwawą egzekucję."
		},
		"TutSearchTreasure": {
			"id": 837,
			"code": "TutSearchTreasure",
			"text": "Skarbów możesz szukać przy pomocy skarabeusza, którego musisz przesuwać po okolicy, obserwując, jak świeci. Im bliżej skarbu, tym skarabeusz mocniej świeci. Kiedy znajdzie się nad skarbem, zacznie machać skrzydłami. Kop śmiało w tym miejscu."
		},
		"TutShop": {
			"id": 914,
			"code": "TutShop",
			"text": "W sklepie możesz wydać zapasy złota. W głównym dziale - \"Zalecane\" znajdziesz pasujące poziomem uzbrojenie, które jest lepsze od tego, jakie masz na sobie. W sprzedaży dostępna jest też amunicja, która pozwoli Ci wygrać nawet bardzo ciężkie walki."
		},
		"TutShopFilter2": {
			"id": 930,
			"code": "TutShopFilter2",
			"text": "Tutaj znajdziesz wszystkie dostępne w grze części uzbrojenia."
		},
		"TutShopFilter3": {
			"id": 931,
			"code": "TutShopFilter3",
			"text": "Tutaj zawsze znajdziesz skarabeusze, niezbędne w szukaniu skarbów, magiczne czaszki, nieodzowne w doskonaleniu Twoich zaklęć oraz wytrychy, przy pomocy których otworzysz znalezione skrzynie ze skarbami."
		},
		"TutShopFilter4": {
			"id": 932,
			"code": "TutShopFilter4",
			"text": "W dziale Premium\" możesz nabyć zestawy ze zniżką oraz specjalne artefakty.\""
		},
		"TutShopFilter5": {
			"id": 933,
			"code": "TutShopFilter5",
			"text": "W dziale \"Relikwie\" możesz zapoznać się z przedmiotami, których kupić się nie da i które można otrzymać za te lub inne zasługi."
		},
		"TutSliceAttack1": {
			"id": 995,
			"code": "TutSliceAttack1",
			"text": "Przeciwnika możesz atakować nie tylko naciskając na sektory, lecz także przesuwając palcem po ekranie we właściwym kierunku."
		},
		"TutSliceAttack2": {
			"id": 996,
			"code": "TutSliceAttack2",
			"text": "Przejedź palcem po ekranie z lewa na prawo, żeby zaatakować w lewej strefie wroga"
		},
		"TutSliceAttack3": {
			"id": 997,
