		"1156": {
			"id": 1156,
			"bot": "236_240_9",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "あの村で起きたことは、話すべきじゃないけど。わたしは内緒で、野イチゴを摘みに行ってたの。村に戻った時には、みんな…違った。すごく違ったの。",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "みんな、まるで別人みたい。まるで、人間のふりをしているみたい。赤ずきんちゃんのオオカミみたいに。大きな声で呼んでも、誰も振り向いてくれない。",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "村の人たちは変わってしまったわ…みんなに襲いかかられて、やっとの思いで逃げたの。",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "そのことを思い出すと、クマちゃんのぬいぐるみが恋しくて泣けちゃうの…わたしのこと、傷つけないよね？あなたに会えてよかった。ママもよかったねって。",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
