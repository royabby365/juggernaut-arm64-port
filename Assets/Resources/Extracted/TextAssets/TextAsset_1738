		},
		"1435": {
			"id": 1435,
			"bot": "278_409_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "あいつらのパワーを感じるのよ。あいつらと比べたら、みんな弱々しすぎて…",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "わたしたちの先に、あそこにいる…クリスタルの生き物…あいつらには魂がないけど、目覚めさせられたことに怒っている…とっても、怒ってるわ…怖くないの？そんなの変よ！",
