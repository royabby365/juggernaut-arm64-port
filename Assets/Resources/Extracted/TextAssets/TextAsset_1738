		"1444": {
			"id": 1444,
			"bot": "278_407_23",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "わたしの心が、なにか不吉なことがやってくるって感じてるの！わたしの英雄… あなたのことがとっても心配。",
					"femaleText": "わたしの心が、なにか不吉なことがやってくるって感じてるの！わたしの守護神… あなたのことがとっても心配だわ。",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "あんな生き物は、今まで見たことがないわ。でも、あんな生物がいるって伝説があるの。クリスタリデスと呼ばれているのだけど、存在したのは何世紀も昔の話で、今は眠っているの…",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "お願いだから、気を付けてね！かわいそうなラドウェイを救えるのは、あなただけなんだからね！",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1452": {
			"id": 1452,
			"bot": "278_411_25",
			"dialogs": {
				"1": {
					"npc": "1186",
