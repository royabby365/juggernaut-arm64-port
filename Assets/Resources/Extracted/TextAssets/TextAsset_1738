		"1738": {
			"id": 1738,
			"bot": "284_488_39",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "サイクロプティカス - 大嫌いよ！アマゾンの敵 - 呪われた敵よ。ここに住んで以来、ずっとあの下劣な生き物と戦っているの。",
