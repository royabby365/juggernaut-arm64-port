////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 scenario(global_snd_mob2_attack);
 play(attack,25);
 react(f,1);
 scenario(template_attack_splash_small);
}

$attack_left {
 sound(local_attack_left,0.2);
 play(attack_right,25);
 scenario(global_smoke_small_legs);
 wait(0.15);
 react(l,1);
 scenario(template_attack_splash_med);
 wait(0.85);
 scenario(global_smoke_small_legs);
}

$attack_right {
 scenario(global_snd_mob2_attack_right);
 play(attack_left,20);
 scenario(global_smoke_small_legs);
 react(l,1);
 scenario(template_attack_splash_med);
 scenario(global_smoke_small_legs);
}

$attack_uppercot {
 scenario(global_snd_mob2_attack_uppercot);
 play(attack_uppercot,10);
 scenario(global_smoke_small_legs);
 wait(0.7);
 scenario(global_smoke_small_legs);
 react(l,1); scenario(template_attack_splash_big);
 scenario(global_smoke_small_legs);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 #ifnotweapon(1);enemyscenario(ifx_blood);ifnotweapon#;
	 #ifweapon(1);enemyscenario(ifx_blood_small);ifweapon#;
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_direct {
 light(0,1.5);
 scenario(global_snd_mob2_direct);
 scenario(global_magic_baf_kabanishe_start);
 play(magic,10);
 scenario(global_magic_direct_prestart_boar);
 wait(0.9);
 react(f,0);
 scenario(global_magic_direct_start_boar);
 scenario(global_magic_direct_fly_kabanishe);
 wait(0.5);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_boar);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_boar);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 light(0,1.5);
 scenario(global_snd_mob2_aoe);
 scenario(global_magic_baf_kabanishe_start);
 play(magic_aoe,15);
 scenario(global_magic_aoe_prestart_boar);
 wait(0.8);
 react(f,0);
 wait(0.35);
 scenario(global_magic_aoe_wave_boar);
 wait(0.2);
 scenario(global_magic_aoe_exp_dog);
 light(1,1,0.3);
}

$magic_baf {
 light(0,1.5);
 scenario(global_snd_mob2_baf);
 scenario(global_magic_baf_kabanishe_start);
 play(magic_baf,23);
 scenario(global_magic_baf_kabanishe);
 light(1,1,0.3);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 sound(local_block,0.3);
 play(block,20);
 vibration(1,2,0);
 scenario(global_react_block);
}

$react_dodge {
 reactfx();
 scenario(global_snd_mob2_dodge);
 play(dodge,12);
 scenario(global_smoke_small_legs);
 wait(2.1);
 scenario(global_smoke_small_legs);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage);
}

$react_dmgf {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 wait(0.35);
 vibration(1,2,0);
 scenario(global_smoke_medium_torso_kabanishe);
}

$react_dmgl {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 step(0,-1,0,3);
 wait(0.35);
 vibration(1,2,0);
 scenario(global_smoke_medium_torso_kabanishe);
 wait(1.2);
 enemyscenario(ifx_step_r);
}

$react_dmgr {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 step(0,1,0,3);
 wait(0.35);
 vibration(1,2,0);
 scenario(global_smoke_medium_torso_kabanishe);
 wait(1.2);
 enemyscenario(ifx_step_l);
}

$react_dmgu {scenario(react_dmgf);}

$react_death { 
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 play(death);
 wait(0.4);
 scenario(global_smoke_medium_torso_kabanishe);
 wait(0.6);
 scenario(global_smoke_medium_torso);
 wait(1);
 scenario(global_react_death);
 fx(rd1,fx_dethfastpatno1,pos_spinecenter);         fxpos(rd1,0,-0.1,0,0);
}

$react_deathf {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_death_force);
 play(death_force);
 scenario(global_smoke_fly);
 vibration(1,2,0);
 wait(0.8);
 scenario(global_smoke_big_torso);
 wait(0.3);
 scenario(global_react_death);
 fx(rdf1,fx_dethfastpatno1,pos_spinecenter);        fxpos(rdf1,0,-0.7,0,0);
}

$react_deathl {scenario(react_deathf);}
$react_deathr {scenario(react_deathf);}
$react_deathu {scenario(react_deathf);}

////////////////////////////////////////////////////////////////////
// INDIVIDUAL EFFECTS
////////////////////////////////////////////////////////////////////

$ifx_step_r {
  step(1,-1,1);
}

$ifx_step_l {
  step(-1,1,1);
}

$ifx_blood {
 scenario(global_react_blood);
}

$ifx_blood_small {
 scenario(global_react_blood_small);
}

$ifx_blood_down_splash {
 fx(0,fx_blooddownsplat_Rd,pos_toe_r);
 wait(0.1);
 fx(0,fx_blooddownsplat_Rd,pos_toe_l);
}

$ifx_fatality_blood_splash {
 fx(0,fx_bloodsplat_Rd,pos_spinecenter);
 fx(fbs1,sfx_flesh_Rd,bottom);           fxpos(fbs1,0,1.55,0,1);
 wait(0.5);
 fx(0,fx_bloodsplat_Rd_2,bottom);
}

$ifx_blood_splash {
 fx(0,fx_bloodsplat_Rd,pos_spinecenter);
}

$ifx_blood_fontan {
 fx(0,fx_sizeblood_rd1,pos_head,1);
 fx(0,fx_sizeblood_rd1,pos_spinecenter,1);
 fx(0,fx_sizeblood_rd1,pos_hand_r,1);
 fx(0,fx_sizeblood_rd1,pos_hand_l,1);
 fx(0,fx_sizeblood_rd1,pos_toe_r,1);
 fx(0,fx_sizeblood_rd1,pos_toe_l,1);
}

$ifx_blood_screen {
 #random(25); fx(0,fx_bloodekran_Rd_L);  random#;
 #random(25); fx(0,fx_bloodekran_Rd_R);  random#;
 #random(50); fx(0,fx_bloodekran_Rd_RD); random#;
 #random(50); wait(0.05);                random#;
 #random(50); fx(0,fx_bloodekran_Rd_LD); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Rd_RU); random#;
 #random(50); wait(0.1);                 random#;
 #random(50); fx(0,fx_bloodekran_Rd_LU); random#;
}

$ifx_fatality_damage {
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
}

$ifx_fatality_fly {
 moveto(0,3,0,1);
 playpart(damage,0.65,10,26);
 playpart(damage,0.65,10,26);
 moveto(0,-3,0,0.07); 
 playpart(death,1,45,80);
}

$ifx_fatality_down_blood {
 playpart(damage,0.75,10,26);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,10,26);
 scenario(ifx_blood_down_splash);
 playpart(damage,0.75,10,26);
 scenario(ifx_blood_down_splash);
}

//////////////////////////////
// TRIGGERS AND OTHER
//////////////////////////////

$onshow {
 scenario(global_onshow);
}

$onidle {
 scenario(global_snd_mob2_idle);
 wait(1);
 scenario(global_smoke_leg_kabanishe);
 wait(0.6);
 scenario(global_smoke_leg_kabanishe);
}

$onhide {
 scenario(global_onhide);
}