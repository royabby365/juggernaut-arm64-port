			"bot": "275_399_14",
			"dialogs": {
				"1": {
					"npc": "1272",
					"maleText": "Pensi che siccome hai saputo affrontare gli altri potrai liberarti anche di me? Sai quante persone ho ucciso? Nessun cimitero potrebbe contenerle tutte!",
					"femaleText": "Pensi che siccome hai saputo affrontare gli altri potrai liberarti anche di me? Sai quante persone ho ucciso? Nessun cimitero potrebbe contenerle tutte!",
					"location": "right"
				},
				"2": {
					"npc": "1272",
