		"1738": {
			"id": 1738,
			"bot": "284_488_39",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Ciclopticus. Li odio! Sono i nemici maledetti delle Amazzoni. Abbiamo combattuto contro queste ignobili creature dai tempi dei tempi.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Ti tendono imboscate, attaccano in gruppo e rubano qualsiasi cosa capiti loro tra le mani. Dalla loro bocca escono solo volgarità. Sono certa che li sistemerai per le feste, mio eroe!",
					"femaleText": "Ti tendono imboscate, attaccano in gruppo e rubano qualsiasi cosa capiti loro tra le mani. Dalla loro bocca escono solo volgarità. Sono certa che li sistemerai per le feste!",
					"location": "left"
				},
				"3": {
					"npc": "1270",
					"maleText": "Guarda, una nuova preda! - A me il primo colpo! No, a me! Facciamolo insieme! Preparati a morire, umano!",
					"location": "right"
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1745": {
			"id": 1745,
			"bot": "284_490_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Quasi tutte le mie sorelle sono diventate possedute, come lo ero io prima di incontrare te, mio redentore. Nobili guerriere trasformate in mostri assetati di sangue. Che fine orribile per la nostra tribù!",
					"femaleText": "Quasi tutte le mie sorelle sono diventate possedute e trasformate in mostri, come lo ero io prima di incontrare te, mia redentrice. Che fine orribile per la nostra tribù!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "È una di loro - Poverina! Attaccala! Forse può guarire come me o almeno porrai fine alla sua sofferenza. Ma fai attenzione! Le Amazzoni sono astute e forti e questa qui ha un demone dentro di lei!",
					"femaleText": "È una di loro - Poverina! Attaccala! Forse può guarire come me o almeno porrai fine alla sua sofferenza.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1748": {
			"id": 1748,
			"bot": "284_489_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Davanti c'è un mostro con artigli giganti!... Così grandi che potrebbero dividere in due una persona! Soltanto tu, e nessun altro, puoi sconfiggere questo mostro, mio eroe!",
					"femaleText": "Davanti c'è un mostro con artigli giganti!... che potrebbero dividere in due una persona! Soltanto tu puoi sconfiggere questo mostro!",
