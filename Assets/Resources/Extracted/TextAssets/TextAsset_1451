			"bot": "279_414_29",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Ho sentito che ci sono dei cinghiali feroci e molto pericolosi da queste parti. Ad ogni modo ho avuto a che fare con maiali ben peggiori nei pub di Branendal!",
