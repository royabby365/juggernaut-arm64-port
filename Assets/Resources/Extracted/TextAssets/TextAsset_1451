		"1156": {
			"id": 1156,
			"bot": "236_240_9",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Probabilmente non dovrei raccontare quello che è accaduto nel villaggio. Sono scappata senza permesso a raccogliere bacche nella foresta. Quando sono tornata, le persone erano diventate cattive. Tanto cattive.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Non erano assolutamente in sé. Erano delle creature che fingevano di essere umani, come il lupo nella favola. Ho gridato, ma nessuno mi ha risposto.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Le persone nel villaggio sono cambiate... Si sono avventate su di me, a malapena sono riuscita a scappare.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Quando ci penso, abbraccio il mio orsacchiotto e mi metto a piangere... Non mi farai del male, vero? Sono così contenta di averti incontrato. Anche la mia mamma lo è.",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1157": {
			"id": 1157,
			"bot": "236_241_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Vuoi sapere dov'è la mia mamma? È qui con me, parla con me. Se le vuoi dire qualcosa, glielo riferisco io.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Perché mi guardi in quel modo? Non mi piace quando le persone mi guardano così... Possono accadere cose orribili! ",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1158": {
			"id": 1158,
			"bot": "236_49_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Fermati! Lo senti? L'uomo delle paludi sta gemendo... La mia mamma me l'ha fatto vedere. Una volta era come tutti gli altri, ma poi è annegato nella palude ed è cambiato. È terribile e vuole ucciderci...",
