			"bot": "278_412_25",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "La terra sta tremando... È un terremoto?",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Non è un terremoto... sono... dei passi! I passi di una creatura gigante... Si stanno avvicinando. Ho paura soltanto a guardare... Oh, misericordia!",
					"location": "left"
