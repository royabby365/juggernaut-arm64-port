			"bot": "236_239_8",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Sapevo che saresti venuto. La mia mamma mi ha detto che avrei trovato qualche amico.... Sono Ana. Vengo dal villaggio vicino... Non voglio più tornarci. Vengo con te.",
					"femaleText": "Sapevo che saresti venuto. La mia mamma mi ha detto che avrei trovato qualche amico.... Sono Ana. Vengo dal villaggio vicino... Non voglio più tornarci. Vengo con te.",
