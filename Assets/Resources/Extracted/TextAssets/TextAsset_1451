		"1388": {
			"id": 1388,
			"bot": "277_401_17",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Non prendere la tua arma, grande guerriera! Sono tornata per ringraziarti, non per attaccarti di nuovo! Sconfiggendomi in combattimento mi hai liberato dallo spirito demoniaco di Sovering che era dentro di me!",
					"femaleText": "Non prendere la tua arma, grande guerriero! Sono tornata per ringraziarti, non per attaccarti di nuovo! Sconfiggendomi in combattimento mi hai liberato dallo spirito demoniaco di Sovering che era dentro di me!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Mi chiamo Arianna e ti devo la vita! Nel rispetto delle leggi della tribù delle Amazzoni ti servirò da subito fino alla fine della mia vita. Dammi un po' di tempo per curare le ferite e ti seguirò fino in capo al mondo!",
					"location": "left"
				},
				"3": {
