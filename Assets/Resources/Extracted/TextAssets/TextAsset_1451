			"minVersion": null,
			"maxVersion": null
		},
		"1753": {
			"id": 1753,
			"bot": "285_498_41",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Il solo pensiero di questo posto mi repelle... Una terribile maledizione affligge queste terre! C'è un antico male che regna qui, un male veramente grande...",
					"location": "left"
				},
				"2": {
					"npc": "1185",
					"maleText": "Ho aspettato così a lungo.... La mia gola è secca. Voglio bere il tuo sangue e placare la mia sete...",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1762": {
			"id": 1762,
			"bot": "285_497_42",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Guarda, ce n'è un altro... Più di qualsiasi altra cosa ho paura dei cadaveri resuscitati! Credo che morirò di disgusto se quella ignobile creatura mi toccherà anche soltanto con una delle sue putride dita...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "È un bene che tu sia qui, mio benefattore... Mi difenderai e salverai il mondo, ne sono certa!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1769": {
			"id": 1769,
			"bot": "285_375_43",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "Ancora vivo? Gli dei devono essere dalla tua parte se il tuo corpo non è stato ancora ridotto in brandelli dagli avvoltoi! O forse combatti davvero bene...",
					"femaleText": "Ancora viva? Gli dei devono essere dalla tua parte se il tuo corpo non è stato ancora ridotto in brandelli dagli avvoltoi! O forse combatti davvero bene...",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "Avverto davvero più forza dentro di te, guerriero. Forse ci servirai a volte, ma ora dobbiamo sbrigarci. La nostra caccia non è ancora finita.",
					"femaleText": "Avverto davvero più forza dentro di te, guerriera. Forse ci servirai a volte, ma ora dobbiamo sbrigarci. La nostra caccia non è ancora finita.",
