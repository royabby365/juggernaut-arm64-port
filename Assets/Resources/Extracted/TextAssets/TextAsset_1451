		"1772": {
			"id": 1772,
			"bot": "285_495_45",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Gli Skelt non sembrano così disgustosi come i corpi marci, ma sono ancora più pericolosi in combattimento. Il demone Sovering probabilmente ha soffiato un po' di vita dentro di loro con il suo respiro nero in modo che potessero distruggerci...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1777": {
			"id": 1777,
			"bot": "285_494_45",
			"dialogs": {
				"1": {
					"npc": "1184",
					"maleText": "Dove stai andando con la spada in mano, umano? Questo è il dominio del mio signore Sovering e tutti i mortali dovrebbero prostrarsi in ginocchio dinanzi a lui e cospargere di sabbia le proprie teste.",
					"location": "right"
				},
				"2": {
					"npc": "1184",
					"maleText": "Ma neanche questo ti salverà, creatura sfacciata! Non ti permetterò di disturbare il riposo del mio signore. Ti ridurrebbe in polvere con il solo sguardo, ma io ti finirò prima che lui ne abbia l'opportunità!",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1782": {
			"id": 1782,
			"bot": "286_492_55",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Il mio cuore batte all'impazzata! Dovrai batterti contro Sovering in persona! Se vincerai, il mondo si sbarazzerà della sua maledizione, se perderai moriremo tutti! Prego gli dei che ti aiutino e che ti facciano forza!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
