		},
		"1452": {
			"id": 1452,
			"bot": "278_411_25",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Combatti brillantemente, mio benefattore! Sai, ho pensato a tutte le disgrazie che hanno afflitto il mondo... Prima il demone Sovering, ora questi giganti di pietra....",
					"femaleText": "Combatti brillantemente, mia benefattrice! Sai, ho pensato a tutte le disgrazie che hanno afflitto il mondo... Prima il demone Sovering, ora questi giganti di pietra....",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Non può essere solo una coincidenza... Ci dev'essere lo zampino di qualcuno dietro a tutta questa malvagità... Qualche mano diabolica ha risvegliato sia il demone che i giganti... Qualcuno che è al tempo stesso un esperto mago nero e un elementalista...",
					"location": "left"
				},
				"3": {
