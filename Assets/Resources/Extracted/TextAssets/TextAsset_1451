		"1474": {
			"id": 1474,
			"bot": "279_415_30",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Hai combattuto bene, mio eroe. Guarda, c'è un altro cinghiale. È strano, non ho mai visto niente di simile...",
