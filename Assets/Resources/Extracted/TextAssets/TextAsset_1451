		"1325": {
			"id": 1325,
			"bot": "276_493_15",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ci sta inseguendo. Li senti i suoi passi? Io sì. Avverto la sua presenza. Sta male, sta soffrendo.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Sta morendo di fame. È abituato a mangiare persone, ma non ha incontrato nessuno per tanto tempo, eccetto ragni e pipistrelli. Ci mangerà..di sicuro!",
