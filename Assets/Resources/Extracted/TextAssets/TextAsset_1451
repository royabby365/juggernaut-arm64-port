		"1398": {
			"id": 1398,
			"bot": "277_403_18",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Perdonami, mio salvatore, non volevo parlarne, ma non riesco più a tenere a freno la mia lingua. Questa... hm... bambina che sta viaggiando con noi.... a Branendal le persone tremano al suo solo pensiero! È posseduta da un demone!",
					"femaleText": "Perdonami, non volevo parlarne, ma non riesco più a tenere a freno la mia lingua. Questa... hm... bambina che sta viaggiando con noi.... a Branendal le persone tremano al suo solo pensiero! È posseduta da un demone!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Ti ha detto di essere fuggita dal suo villaggio? Non crederle! Quel marmocchio ha ucciso la sua gente e ora vuole affondare i suoi artigli nei nostri corpi!",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Perché sta dicendo questo?... Anche tu pensi che abbia fatto qualcosa di sbagliato? Non è vero. Mi sono comportata bene, davvero!...",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1407": {
			"id": 1407,
			"bot": "277_404_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ana è cattiva, Ana è una bugiarda. La mia gente, il mio villaggio.... Ho mentito. In realtà non sono fuggita....",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Mi hanno attaccato loro per primi! Io non volevo, sul serio! Ero soltanto spaventata a morte.... e poi qualcosa è successo.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Poi hanno tutti preso fuoco e sono morti, tutti quanti. Tutta la nostra famiglia, i nostri vicini, l'intero villaggio. Sono stata cattiva, ma la mia mamma mi ha detto che era necessario.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Perché altrimenti mi avrebbero ucciso... Sono tutti diventati cattivi a causa di Sovering. Mi hanno dato la caccia. Ora mi metto a piangere. Ti prego, non mandarmi via...",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1414": {
			"id": 1414,
			"bot": "277_405_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ho pianto tutto il giorno... Mi perdonerai per quello che ho fatto nel villaggio, vero? Ti prego, perdonami e fammi venire con te...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Non ho amici all'infuori di te. Ho soltanto il mio orsacchiotto e la mia mamma che badano a me...",
					"femaleText": "Non ho amici all'infuori di te. Ho soltanto il mio orsacchiotto e la mia mamma che badano a me...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Comincio a dispiacermi per questa bambina. Forse non è così terribile come pensavo... Permettile di restare, mio eroe. Forse ti potrà anche aiutare nel tuo viaggio pieno di insidie.",
					"femaleText": "Comincio a dispiacermi per questa bambina. Forse non è così terribile come pensavo... Permettile di restare, mia signora. Forse ti potrà anche aiutare nel tuo viaggio pieno di insidie.",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1425": {
			"id": 1425,
			"bot": "277_469_20",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Aspetta... So che non hai altra scelta e che devi andare avanti, ma ho così tanta paura per te, mio protettore!.. Perderti sarebbe la cosa più terribile che potrebbe capitarmi....",
					"femaleText": "Aspetta... So che non hai altra scelta e che devi andare avanti, ma ho così tanta paura per te!.. Perderti sarebbe la cosa più terribile che potrebbe capitarmi....",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Perché sono così preoccupata? Credimi, ho ragione di esserlo. Koren cornuto sta arrivando qui. È il campione incontestato dei tornei dei guerrieri che si tenevano prima che avessimo mai sentito parlare di Sovering...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Koren cornuto è così potente che può impugnare una spada lunga quanto una persona come se fosse una piuma!",
					"location": "left"
				},
				"4": {
					"npc": "1186",
					"maleText": "Questa spada può tagliare in due un cavaliere insieme al suo cavallo! Non lo direi se non l'avessi visto con i miei occhi!",
					"location": "left"
				},
				"5": {
					"npc": "1186",
					"maleText": "Koren era in grado di uccidere chiunque con un solo colpo quando era umano. Ora è posseduto da Sovering ed è pieno di potere demoniaco. Tutto quello che ti chiedo è di fare attenzione, per il bene di Radway e per il mio bene....",
					"femaleText": "Koren era in grado di uccidere chiunque con un solo colpo quando era umano. Ora è posseduto da Sovering ed è pieno di potere demoniaco. Tutto quello che ti chiedo è di fare attenzione, per il bene di Radway e per il mio bene....",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1430": {
			"id": 1430,
			"bot": "278_413_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ho fatto un sogno terribile. Mi sono svegliata e ho tremato dalla paura fino alla mattina.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Nel sogno ho visto creature vecchie come il tempo e potenti come montagne... Non esistono armi in grado di trafiggere i loro corpi di cristallo... Mamma dice che era solo un sogno.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1435": {
			"id": 1435,
			"bot": "278_409_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ora riesco a sentire il Loro potere... La gente comune è così debole in confronto a Loro...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Sono lì, davanti a noi... Le creature di cristallo... Sono prive di anima, ma sono arrabbiate per essere state svegliate... Molto, molto arrabbiate... Tu non hai paura? Dovresti!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1444": {
			"id": 1444,
			"bot": "278_407_23",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Nel mio cuore avverto che una disgrazia sta per accadere! Sono così in pensiero per te, mio eroe.",
					"femaleText": "Nel mio cuore avverto che una disgrazia sta per accadere! Sono così in pensiero per te.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Davanti ho visto una creatura mai vista prima, ma ricordo alcune leggende su creature come questa. Si chiamano Cristallidi e si dice che siano vissuti tanti secoli fa, poi si addormentarono...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Ti prego, fai attenzione! Dopo tutto, solo tu puoi salvare la nostra povera Radway!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
