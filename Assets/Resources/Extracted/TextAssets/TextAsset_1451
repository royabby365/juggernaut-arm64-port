		"1731": {
			"id": 1731,
			"bot": "284_486_38",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "Un uomo vivo? In queste terre maledette? Il tuo stomaco non è sventrato. Non sembri posseduto...",
					"femaleText": "Una donna viva? In queste terre maledette? Il tuo stomaco non è sventrato. Non sembri posseduta...",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "Un uomo vivo, non c'è dubbio. Pensavamo che l'unico mortale che potessimo incontrare qui fosse colui che nasconde la sua faccia. Per caso l'hai incontrato durante il tuo viaggio, straniero?",
					"femaleText": "Viva, non c'è dubbio. Pensavamo che l'unico mortale che potessimo incontrare qui fosse colui che nasconde la sua faccia. Per caso l'hai incontrato durante il tuo viaggio, straniera?",
					"location": "left"
				},
				"3": {
					"npc": "1145",
					"maleText": "L'hai incontrato sicuramente, viaggiatore! Crede di poterci sfuggire. Ben presto lo accalappierò. Pagherà per tutto quello che sta succedendo qui!",
					"femaleText": "L'hai incontrato sicuramente, viaggiatrice! Crede di poterci sfuggire. Ben presto lo accalappierò. Pagherà per tutto quello che sta succedendo qui!",
					"location": "left"
				},
				"4": {
					"npc": "1146",
					"maleText": "Il mio compagno ha parlato troppo nella sua rabbia, ma dobbiamo sbrigarci. Non ti tratterremo oltre. Vattene, se ci tieni alla tua vita.",
					"location": "left"
				},
