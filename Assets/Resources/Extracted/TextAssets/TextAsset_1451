		"1872": {
			"id": 1872,
			"bot": "1862_1863_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Mamma dice che non sono felici di vederci qui. Gli abitanti della palude non amano ricevere ospiti.",
					"location": "left"
				},
				"2": {
					"npc": "1868",
					"maleText": "Una persona nelle nostre paludi? Qui non c'è niente per te! Spiriti del pantano, attendete la mia offerta!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1876": {
			"id": 1876,
			"bot": "1862_1864_14",
			"dialogs": {
				"1": {
					"npc": "1869",
					"maleText": "Perché sei venuto nelle nostre terre? Prima nessuno dava fastidio agli abitanti della palude. Soltanto noi Toper, che viviamo nel pantano, regnavamo qui.",
					"location": "right"
				},
				"2": {
					"npc": "1869",
					"maleText": "Qui troverai la tua morte! Il tuo lenzuolo funebre sarà la melma, gli accompagnatori al tuo funerale saranno rane e una collinetta sarà il luogo del tuo sonno eterno!",
					"location": "right"
				},
				"3": {
					"npc": "1869",
					"maleText": "Non vuoi fare la cosa giusta? Allora i miei guerrieri ti trasformeranno in cibo per rane. Preparati!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1880": {
			"id": 1880,
			"bot": "1862_1865_16",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "I grandi hanno detto che se mi fossi comportata male sarei diventata un Toper... Pensi che tutti i Toper una volta fossero bambini cattivi?",
					"location": "left"
				},
				"2": {
					"npc": "1869",
					"maleText": "Come osi entrare nel mio regno e uccidere i miei guerrieri? Erano tutti figli miei! Te ne pentirai amaramente!",
					"location": "right"
				},
				"3": {
					"npc": "1869",
					"maleText": "L'unica possibilità che hai per rimanere in vita è quella di servirmi a vita! È il destino migliore per un umano! No? Allora muori!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1883": {
			"id": 1883,
			"bot": "1862_1866_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Sono molto furbi. Qualcuno si sta avvicinando. Una donna delle paludi è nascosta là dietro. Pensa che nessuno possa vederla, ma la mia mamma vede chiunque. ",
					"location": "left"
				},
				"2": {
					"npc": "1868",
					"maleText": "Ci sono molte ossa umane nelle nostre paludi, ma c'è posto anche per le tue!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1886": {
			"id": 1886,
			"bot": "1862_1867_17",
			"dialogs": {
				"1": {
					"npc": "1869",
					"maleText": "Le erbacce della palude sono rosse per via del sangue dei miei soldati! Sei un avversario forte, umano, ma noi siamo più forti!",
					"location": "right"
				},
				"2": {
					"npc": "1869",
					"maleText": "La palude ti divorerà, gli spiriti balleranno una danza mortale sulla tua tomba. E noi Toper domineremo il mondo!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
