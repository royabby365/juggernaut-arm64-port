}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 sound(local_block,0.2);
 play(block,25);
 vibration(1,2,0);
 scenario(global_react_block);
}

$react_dodge {
 reactfx();
 scenario(global_snd_mob2_dodge);
 scenario(global_dodge_trail);
 play(dodge,36);
 scenario(global_smoke_little_legs);
 wait(0.9);
 scenario(global_smoke_little_legs);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage);
}

$react_dmgf {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 wait(0.35);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(2.25);
 scenario(global_smoke_small_legs);
}

$react_dmgl {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 step(0,-1,0,3);
 wait(0.35);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(2.25);
 scenario(global_smoke_small_legs);
 enemyscenario(ifx_step_r);
}

$react_dmgr {
 wait(0.4);
 reactfx();
 scenario(global_snd_mob2_damage_force);
 play(damage_force);
 scenario(global_smoke_fly);
 step(0,1,0,3);
 wait(0.35);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(2.25);
 scenario(global_smoke_small_legs);
 enemyscenario(ifx_step_l);
}

$react_dmgu {scenario(react_dmgf);}

$react_death  { 
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death);
 play(death);
 wait(1.2);
 scenario(global_smoke_big_torso);
 wait(0.2);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter); fxpos(dfp1,0,0,0,0);
}

$react_deathf {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_death_force);
 play(death_force);
 scenario(global_smoke_fly);
 wait(0.3);
 vibration(1,2,0);
 scenario(global_smoke_big_torso);
 wait(0.8);
 scenario(global_react_death);
 fx(dfp1,fx_dethfastpatno1,pos_spinecenter); fxpos(dfp1,0,-0.05,0,0);
}

$react_deathl {scenario(react_deathf);}
$react_deathr {scenario(react_deathf);}
$react_deathu {scenario(react_deathf);}

