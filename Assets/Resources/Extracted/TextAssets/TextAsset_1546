  scenario(global_magic_direct_expsmall_nelf);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_nelf);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 light(0,2);
 scenario(global_snd_mob2_aoe);
 scenario(global_magic_baf_nelf_start);
 play(magic_aoe,15);
