 scenario(global_snd_mob2_direct);
 scenario(global_magic_baf_nelf_start);
 play(magic,30);
 wait(0.3);
 react(f,0);
 wait(0.2);
 scenario(global_magic_direct_fly_nelf);
 wait(0.22);
