////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 sound(local_attack,0.35);
 play(attack,10);
 react(f,1);
 scenario(template_attack_splash_med);
 scenario(global_smoke_little_legs);
 wait(1);
 scenario(global_smoke_little_legs);
}

$attack_left {
 sound(local_attack_left,0.1);
 play(attack_left,5);
 react(r,1);
 scenario(template_attack_splash_big);
 scenario(global_smoke_little_legs);
 wait(1);
 scenario(global_smoke_little_legs);
}

$attack_right {
 scenario(global_snd_mob2_attack_right);
 play(attack_right,20);
 scenario(global_smoke_little_legs);
 react(l,1);
 scenario(template_attack_splash_big);
 scenario(global_smoke_little_legs);
 wait(0.8);
 scenario(global_smoke_little_legs);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
     enemyscenario(ifx_blood);
 ifnotreact#;
}

$template_attack_splash_med {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 enemyscenario(ifx_blood);
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 enemyscenario(ifx_blood);
 ifnotreact#;
}

