		"1506": {
			"id": 1506,
			"bot": "280_422_28",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "J'ai peur. Non pas des monstres, mais de moi-même. Quelque chose va peut-être se produire. Maman est inquiète. C'est comme ce qui est arrivé dans le village. Je ne peux pas continuer comme ça.",
