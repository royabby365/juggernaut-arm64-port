		},
		"1535": {
			"id": 1535,
			"bot": "1182_1188_31",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Contente de te revoir ! J'étais si seule ici. Je n'ai pas cessé de penser à la manière dont les malheurs sont arrivés. Mais j'ai aussi pensé à la façon dont je peux t'aider... C'est maman qui me l'a suggéré.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Tu vas devoir affronter le démon le plus puissant qui soit : Sovering. Peut-être que si tu commences par me vaincre, tu seras mieux préparé à te battre contre lui.",
					"femaleText": "Tu vas devoir affronter le démon le plus puissant qui soit : Sovering. Peut-être que si tu commences par me vaincre, tu seras mieux préparé à te battre contre lui.",
					"location": "left"
				},
				"3": {
					"npc": "1153",
					"maleText": "Veux-tu t'entraîner avec moi ? Je vais redevenir forte comme je l'étais dans le village... Mais si je te blesse, ne sois pas vexé. C'est d'accord ? Prêt ?",
					"location": "right"
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1540": {
			"id": 1540,
			"bot": "1182_1188_34",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Quoi, tu as eu du mal à venir à bout d'une enfant ? Mais ce n'était qu'un échauffement ! Prêt pour le second round ?",
					"femaleText": "Quoi, tu as eu toutes les peines du monde à venir à bout d'une enfant ? Mais ce n'était qu'un échauffement ! Prêt pour le second round ?",
