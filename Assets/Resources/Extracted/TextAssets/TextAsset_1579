		},
		"1567": {
			"id": 1567,
			"bot": "1182_1190_46",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Tes coups sont puissants, maman se fait parfois du souci pour moi. Mais nous ne pouvons pas arrêter là. Bientôt je vais te montrer ce dont je suis vraiment capable.",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1572": {
			"id": 1572,
			"bot": "1182_1190_49",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Maman dit que tu es celui qui sauvera notre monde. Mais même quelqu'un comme toi a besoin d'un entraînement. Si tu veux, nous pouvons continuer. Je vais te montrer de nouvelles choses.",
					"femaleText": "Maman dit que tu es celui qui sauvera notre monde. Mais même quelqu'un comme toi a besoin d'un entraînement. Si tu veux, nous pouvons continuer. Je vais te montrer de nouvelles choses.",
					"location": "right"
				},
				"2": {
					"npc": "1153",
					"maleText": "Tu me demandes si ma maman, dont je parle si souvent, est encore en vie ? Non. Mais elle n'est pas non plus avec les morts.",
					"location": "right"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1579": {
			"id": 1579,
			"bot": "1182_1191_53",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Je veux que tu battes Sovering. Je le veux, je le veux ! Si tu me bats encore une fois, je te donnerai mon nounours, il t'aidera.",
					"femaleText": "Je veux que tu battes Sovering. Je le veux, je le veux ! Si tu me bats encore une fois, je te donnerai mon nounours, il t'aidera.",
					"location": "right"
				},
				"2": {
					"npc": "1153",
					"maleText": "Arrête de me regarder comme ça... Il va vraiment t'aider. Tu ignores juste ce dont il est capable. C'est maman qui me l'a donné.",
					"location": "right"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1582": {
			"id": 1582,
			"bot": "281_423_42",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Même dans nos jungles, les gens tremblent lorsqu'ils le nom du démon ! Aucun guerrier ordinaire ne peut le battre, mais j'ai foi en toi !",
					"location": "left"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1587": {
			"id": 1587,
			"bot": "282_414_31",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Cette forêt n'inspire rien de bon à maman. Je ne peux pas continuer, mais toi tu le peux. Je vais attendre là. Je serai sage, promis !",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Est-ce que je vais te manquer ? Toi, oui. Reviendras-tu jouer avec moi ? Je t'apprendrai le jeu de la vie et de la mort.",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1594": {
			"id": 1594,
			"bot": "282_476_32",
			"dialogs": {
				"1": {
					"npc": "1268",
					"maleText": "Humain stupide ! Que fais-tu là ? Ici vivent les zvergs, ici, terre des zvergs ! Va t'en !",
					"location": "right"
				},
				"2": {
					"npc": "1268",
					"maleText": "Tu ne veux pas partir ? Quel affront ! Tu vas mourir ! Je vais te tuer et te manger !",
					"location": "right"
				},
				"3": {
					"npc": "1186",
					"maleText": "Maudits zvergs ! Un jour, ils ont tenté d'enlever ma sœur. Nous avons eu toutes les peines du monde à les en empêcher. Ils avaient l'air d'humains, mais ils sont bien pire, et surtout, ils sont repoussants !",
					"femaleText": "Maudits zvergs ! Un jour, ils ont tenté d'enlever ma sœur. Nous avons eu toutes les peines du monde à les en empêcher. Ils ne se lavent pas. Ils sont pires que les humains. Montre-leur ce dont une femme est capable ma sœur !",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1606": {
			"id": 1606,
			"bot": "282_477_33",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Je comprends pourquoi Una a décidé de rester... Plus nous irons loin, mieux je percevrai les dessins diaboliques de Sovering. Il a peut-être réveillé le pouvoir qui sommeille en cette fille pour le retourner contre toi.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Una l'a compris. Elle est restée en retrait pour ne pas nous faire de mal. J'ai le sentiment que tu reverras cette fille, mon héros.",
					"femaleText": "Una l'a compris. Elle est restée en retrait pour ne pas nous faire de mal. J'ai le sentiment que tu reverras cette fille, ma mie.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1619": {
			"id": 1619,
			"bot": "282_478_34",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "Quels sont tes plans, mortel ? Vaincre Sovering. Ton insolence te conduira à ta perte. Ta mort sera atroce ! Arrête avant qu'il ne soit trop tard !",
					"femaleText": "Quels sont tes plans, mortel ? T'attaquer à Sovering. Ton insolence te conduira à ta perte. Ta mort sera atroce ! Arrête avant qu'il ne soit trop tard !",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "Pauvre idiot, ton arme ne te servira à rien. Tu t'attaques à un pouvoir capable de t'aplatir comme une crêpe. Tu es déterminé ? Je t'aurai prévenu...",
					"femaleText": "Pauvre folle, ton arme ne te servira à rien. Tu t'attaques à un pouvoir capable de te réduire en bouillie. Tu es sûre ? Je t'aurai prévenue...",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				},
				"6": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1702": {
			"id": 1702,
			"bot": "282_482_35",
			"dialogs": {
				"1": {
					"npc": "1269",
					"maleText": "Tu es venu pour tuer nos zvergs. Les esprits sont furieux ! Ils ne te le pardonneront jamais ! Ils m'ont conféré ma force. Je vais te donner en sacrifice !",
					"location": "right"
				},
				"2": {
					"npc": "1186",
					"maleText": "Pire qu'un zverg ordinaire, il y a leurs shamans  ! Ils disent conduire une victime à l'autel du sacrifice une fois par jour. En échange, les esprits démoniaques leur confèrent de prodigieux pouvoirs.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1705": {
			"id": 1705,
			"bot": "283_625_47",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Dans ces contrées, dans ce coin secret, vit la matriarche, la mère de tous les zvergs. Nous, les amazones, respectons les femmes, mais celle-ci doit être une créature vraiment immonde.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1708": {
			"id": 1708,
			"bot": "284_483_36",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Ces magnifiques jungles sont mon pays natal. Nulle part ailleurs, les fleurs n'exhalent de telles senteurs et les oiseaux ne chantent comme ceux qui ont enchanté mon enfance.",
					"femaleText": "Ces magnifiques jungles sont mon pays natal. Nulle part ailleurs tu ne trouveras de fleurs aussi belles et de chants d'oiseaux aussi harmonieux.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Tout ce qui est là nous appartient à nous, amazones. Nous avons capturé des hommes. Pour notre plaisir et pour travailler.",
					"femaleText": "Tout ce qui est là nous appartient à nous, amazones. Nous avons capturé des hommes. Pour notre plaisir et pour travailler. Quelle vie merveilleuse, vous ne croyez pas ma mie ?",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1713": {
			"id": 1713,
			"bot": "284_484_36",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "Je vois que tu as fait fi de mes paroles. Tu n'aurais pas dû. De nombreux tas d'os comme toi sont enterrés dans ce pays. Veux-tu les rejoindre ?",
					"femaleText": "Je vois que tu as fait fi de mes paroles. Tu n'aurais pas dû. De nombreux tas d'os comme toi sont enterrés dans ce pays. Veux-tu les rejoindre ?",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "Tu es allé si loin que tu ne t'en tireras pas avec une mort rapide. Tes souffrances feront même grimacer les démons des enfers !",
					"femaleText": "Tu es allé si loin que tu ne t'en tireras pas avec une mort rapide. Tes souffrances feront même grimacer les démons des enfers !",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1720": {
			"id": 1720,
			"bot": "284_485_37",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "Toujours en vie, l'impudent ? Je vais mettre un terme immédiat à tes certitudes ! Maintenant, je t'en conjure, fais demi-tour.",
					"femaleText": "Toujours en vie, l'impudente ? Je vais mettre un terme immédiat à tes certitudes ! Maintenant, je t'en conjure, fais demi-tour.",
					"location": "left"
				},
				"2": {
					"npc": "1154",
					"maleText": "Rebrousse chemin et tu verras peut-être le prochain lever du soleil. Continue et tu seras à jamais plongé dans les ténèbres. Penses-y mortel !",
					"femaleText": "Rebrousse chemin et tu verras peut-être le prochain lever du soleil. Continue et tu seras à jamais plongé dans les ténèbres. Penses-y femme !",
					"location": "left"
				},
				"3": {
					"npc": "1154",
					"maleText": "Qui je suis ? Tu n'as pas besoin de le savoir dans le monde qui t'attend... Et si par un quelconque miracle, tu survis, tu me reverras. Moi et mes frères...",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1731": {
			"id": 1731,
			"bot": "284_486_38",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "Un homme en vie ? Dans ces contrées maudites ? Tu n'as pas été éventré et tu ne sembles pas être possédé...",
					"femaleText": "Une femme en vie ? Dans ces contrées maudites ? Tu n'as pas été éventrée et tu ne sembles pas être possédée...",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "C'est un homme, cela ne fait aucun doute. Nous pensions que le seul que nous aurions rencontré ici aurait été Celui qui cache son visage. Peut-être l'as-tu vu en chemin, étranger ?",
					"femaleText": "En vie, cela ne fait aucun doute. Nous pensions que le seul que nous aurions rencontré ici aurait été Celui qui cache son visage. Peut-être l'as-tu vu en chemin, étranger ?",
