		},
		"1481": {
			"id": 1481,
			"bot": "279_417_32",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Tu tues les sangliers et chasses l'esprit maléfique qui les habite... Mais les esprits sont là... Je les vois. Ils sont avec nous. Et ils sont furieux d'avoir été dérangés.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Les esprits se déplacent. Ils... Ils sont tous entrés dans le corps d'un sanglier ! Maman dit que ça va devenir dangereux ! Cours !",
					"location": "left"
				},
				"3": {
