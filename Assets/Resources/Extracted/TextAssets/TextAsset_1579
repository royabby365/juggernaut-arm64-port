		},
		"1556": {
			"id": 1556,
			"bot": "1182_1190_41",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Tu es fort. Mais maman dit que je suis capable de mieux. On recommence ?",
					"femaleText": "Tu es fort. Mais maman dit que je suis capable de mieux. On recommence ?",
					"location": "right"
				},
				"2": {
