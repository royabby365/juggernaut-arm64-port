			"maxVersion": null
		},
		"1497": {
			"id": 1497,
			"bot": "280_425_26",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Je n'ai pas réussi à décrocher mon regard de ces terres... Je me souviens d'histoires de requins des sables errant dans le désert... Ils peuvent nager dans le sable comme des poissons dans l'océan...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Et si une de ces créatures se faufilait jusqu'à nous... Je vais rester surveiller et... Oh non ! Je sens quelque chose bouger !",
					"location": "left"
				},
				"3": {
