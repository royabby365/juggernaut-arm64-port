		"1738": {
			"id": 1738,
			"bot": "284_488_39",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Cycloptiques. Je les hais ! Ils sont les ennemis jurés des amazones. Nous nous battons contre ces viles créatures depuis que nous vivons ici.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Ils t'ont tendu une embuscade, t'ont attaqué à plusieurs et ont volé tout ce qui n'était pas cloué. Seuls des blasphèmes sortent de leurs bouches. Je suis sûr que tu les remettras à leur place, mon héros !",
					"femaleText": "Ils t'ont tendu une embuscade, t'ont attaqué à plusieurs et ont volé tout ce qui n'était pas cloué. Seuls des blasphèmes sortent de leurs bouches. Remets-les à leur place, mon sauveur !",
					"location": "left"
				},
				"3": {
					"npc": "1270",
					"maleText": "Regarde, une nouvelle proie. Je frappe en premier. Non, moi d'abord ! Prépare-toi à mourir, humain !",
