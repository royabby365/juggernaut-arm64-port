		"1490": {
			"id": 1490,
			"bot": "280_418_26",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Nous sommes arrivés dans le désert, brave guerrier. Il fait si chaud qu'on enlèverait bien quelques épaisseurs !",
					"femaleText": "Nous sommes arrivés dans le désert, brave guerrier. Il fait si chaud qu'on enlèverait bien quelques épaisseurs !",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Je vois des terres à l'horizon... parcourues de coulées de lave et de monstres à cornes... Mais même là-bas, il fait moins chaud que dans ce terrible désert...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Il n'y a pas d'eau, la terre est desséchée sur plusieurs mètres de profondeur. Résultat, les plantes ne se nourrissent pas dans le sol, mais directement des voyageurs. Je crois que je vois une herbe cannibale à l'horizon !",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				},
				"6": {
