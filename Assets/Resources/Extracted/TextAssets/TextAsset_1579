			},
			"minVersion": null,
			"maxVersion": null
		},
		"1320": {
			"id": 1320,
			"bot": "276_124_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Tu es si drôle quand tu te bats ! Tu agites ton épée comme si tu dansais ! Dommage que maman ne me laissera pas t'enseigner notre technique de combat...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1325": {
			"id": 1325,
			"bot": "276_493_15",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Il nous suit. Tu entends ses pas ? Je les entends. Je sens sa présence. Il va mal. Il souffre.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Il meurt de faim. Il est habitué à manger des gens. Cela fait des années qu'il n'a plus rencontré personne, mis à part des araignées et des chauve-souris. Il va nous manger... ça pour sûr !",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1328": {
			"id": 1328,
			"bot": "1181_498_19",
			"dialogs": {
				"1": {
					"npc": "1185",
					"maleText": "De la viande vivante... Chaude... J'avais tellement envie de nourriture chaude... Tu tombes à pic, mortel, je vais me nourrir de ta chair...",
					"location": "right"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1378": {
			"id": 1378,
			"bot": "275_399_14",
			"dialogs": {
				"1": {
					"npc": "1272",
					"maleText": "Tu crois que, parce que tu as eu à faire aux autres, tu vas pouvoir m'acheter ? Il n'existe pas de cimetière qui puisse tous les accueillir !",
					"femaleText": "Tu crois que, parce que tu as eu à faire aux autres, tu vas pouvoir m'acheter ? Il n'existe pas de cimetière qui puisse tous les accueillir !",
					"location": "right"
				},
				"2": {
					"npc": "1272",
					"maleText": "Je vais te tailler en pièces ! Je vais faire un gobelet avec ton crâne, un collier avec tes dents et des flûtes avec tes os !",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
