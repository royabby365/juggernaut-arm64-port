		"1753": {
			"id": 1753,
			"bot": "285_498_41",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Ce lieu me dégoute... Une terrible malédiction plane sur ces terres ! Un mal ancien règne ici, un mal diabolique...",
					"location": "left"
				},
				"2": {
					"npc": "1185",
					"maleText": "J'ai attendu si longtemps... Ma gorge est sèche. Je veux boire ton sang... Étancher ma soif...",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1762": {
			"id": 1762,
			"bot": "285_497_42",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Regarde. En voilà une autre... J'ai une peur bleue des cadavres ressuscités ! Je pense que je vais mourir de dégout si cette créature immonde me touche avec ses doigts putrides.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Heureuse que tu sois là, mon bienfaiteur... Tu vas me défendre et sauver le monde, j'en suis sûre !",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1769": {
			"id": 1769,
			"bot": "285_375_43",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "Toujours en vie ? Les dieux doivent être de ton côté puisque tu n'as pas encore été déchiqueté par les vautours ! Ou peut-être sais-tu vraiment te battre...",
					"femaleText": "Toujours en vie ? Les dieux doivent être de ton côté puisque tu n'as pas encore été déchiqueté par les vautours ! Ou peut-être sais-tu vraiment te battre...",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "Je sens vraiment plus de forces en toi, guerrier. Tu pourrais nous être utile à l'occasion. Mais à présent, nous devons faire vite. Notre partie de chasse n'est pas terminée.",
					"femaleText": "Je sens vraiment plus de forces en toi, guerrier. Tu pourrais nous être utile à l'occasion. Mais à présent, nous devons faire vite. Notre partie de chasse n'est pas terminée.",
