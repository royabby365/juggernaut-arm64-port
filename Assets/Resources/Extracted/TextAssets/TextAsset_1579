		"1872": {
			"id": 1872,
			"bot": "1862_1863_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Maman dit qu'ils n'apprécient pas de nous voir ici. Le peuple des marais n'aime pas recevoir de visiteurs. ",
					"location": "left"
				},
				"2": {
					"npc": "1868",
					"maleText": "Quelqu'un dans nos marais ? Il n'y a rien pour vous ici ! Esprits du bourbier, attendez mon offre !",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1876": {
			"id": 1876,
			"bot": "1862_1864_14",
			"dialogs": {
				"1": {
					"npc": "1869",
					"maleText": "Pourquoi venez-vous ? Avant, personne ne se souciait du marais. Nous autres colosses étions les seuls à habiter le bourbier.",
					"location": "right"
				},
				"2": {
					"npc": "1869",
					"maleText": "C'est la mort que tu vas trouver ici ! Ton linceul sera de la vase, les pleureuses à ton enterrement seront des grenouilles, une butte sera ta pierre tombale.",
					"location": "right"
				},
				"3": {
					"npc": "1869",
					"maleText": "Tu ne veux pas entendre raison ? Alors prépare-toi à être réduit en bouillie par mes guerriers !",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1880": {
			"id": 1880,
			"bot": "1862_1865_16",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Les adultes disent que si je ne suis pas sage, je vais me transformer en colosse. Tu crois qu'ils ont tous été des enfants méchants ?",
					"location": "left"
				},
				"2": {
					"npc": "1869",
					"maleText": "Comment oses-tu fouler le sol de mon royaume et tuer mes guerriers ? Mes enfants ! Tu vas le regretter !",
					"location": "right"
				},
				"3": {
					"npc": "1869",
					"maleText": "Le seul moyen pour toi de rester en vie va être d'entrer à mon service ! Ce qui peut arriver de mieux à un humain, non ? Alors tu vas mourir !",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1883": {
			"id": 1883,
			"bot": "1862_1866_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ils sont très rusés. Une femme du marais se cache là-bas. Elle pense que personne ne peut la voir, mais maman voit tout le monde.",
					"location": "left"
				},
				"2": {
					"npc": "1868",
					"maleText": "Notre marais est plein d'os humains ! Mais tes restes n'auront pas de mal à trouver leur leur place !",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1886": {
			"id": 1886,
			"bot": "1862_1867_17",
			"dialogs": {
				"1": {
					"npc": "1869",
					"maleText": "Les algues du marais sont maculées du sang de mes soldats ! Tu es un adversaire redoutable, humain ! Mais nous sommes plus forts !",
					"location": "right"
				},
				"2": {
					"npc": "1869",
					"maleText": "Le marais va t'engloutir, les esprits seront en transe sur ta tombe. Nous autres colosses sommes les maîtres du monde !",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
