		},
		"1777": {
			"id": 1777,
			"bot": "285_494_45",
			"dialogs": {
				"1": {
					"npc": "1184",
					"maleText": "Où vas-tu, ton sabre à la main, humain ? C'est le domaine de mon seigneur, Sovering, et tous les mortels devraient s'agenouiller devant lui en s'aspergeant la tête de sable.",
					"location": "right"
				},
				"2": {
					"npc": "1184",
					"maleText": "Mais même cela ne te sauvera pas, créature impudente ! Je ne te permettrai pas d'importuner les restes de mon seigneur ! Il te réduira en cendres d'un simple regard, mais je t'achèverai avant même qu'il n'en ait l'occasion.",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1782": {
			"id": 1782,
			"bot": "286_492_55",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Tu vas devoir affronter Sovering en personne ! Si tu gagnes, le monde sera débarrassé d'une malédiction. Si tu perds, nous périrons tous. Je prie les dieux de nous aider et d'être avec toi !",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
