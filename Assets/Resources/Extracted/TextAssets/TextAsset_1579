		"1398": {
			"id": 1398,
			"bot": "277_403_18",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Pardonne-moi, mon sauveur, je ne devrais pas en parler mais je n'en puis plus de me retenir. Cette... hum... fille qui nous accompagne. À Branendal, les gens tremblent rien qu'à entendre son nom. Elle est possédée par le démon !",
					"femaleText": "Pardonne-moi, mon sauveur, je ne devrais pas en parler mais je n'en puis plus de me retenir. Cette... hum... fille qui nous accompagne. À Branendal, les gens tremblent rien qu'à entendre son nom. Elle est possédée par le démon !",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Elle t'a dit qu'elle a fui son village ? Ne va pas croire ça ! La gamine a tué les siens, et maintenant c'est notre peau qu'elle veut avoir !",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Pourquoi est-ce qu'elle dit ça ?... Tu crois que j'ai fait quelque chose de mal ? C'est faux. J'ai été correcte !...",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1407": {
			"id": 1407,
			"bot": "277_404_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Una est mauvaise, Una ment. Les miens, mon village... J'ai menti. En vérité, je n'ai pas fui mon village...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Mais c'est eux qui m'ont attaquée en premier ! Je ne voulais pas ça en réalité ! J'ai eu la peur de ma vie... Et quelque chose s'est passé.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Et ils sont tous morts brûlés. Tous ! Ma famille entière, mes voisins, tout le village... Mais maman a dit que cela devait arriver.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Parce que sinon ils m'auraient tuée... Ils deviennent tous mauvais à cause de Sovering. Ils me pourchassent. Je vais me mettre à pleurer. Ne me chasse pas s'il te plaît...",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1414": {
			"id": 1414,
			"bot": "277_405_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "J'ai pleuré toute la journée... Tu vas me pardonner ce que j'ai fait dans le village, dis ? Pardonne-moi et laisse-moi venir avec toi...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "À part toi, je n'ai pas d'amis. J'ai seulement mon nounours et ma maman pour s'occuper de moi...",
					"femaleText": "À part toi, je n'ai pas d'amis. J'ai seulement mon nounours et ma maman pour s'occuper de moi...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Je commence à avoir de la peine pour cette fillette. Elle n'est peut-être pas aussi terrible que je le pensais... Autorise-la à rester, mon héros. Elle peut peut-être t'être utile dans ton périple.",
					"femaleText": "Je commence à avoir de la peine pour cette fillette. Elle n'est peut-être pas aussi terrible que je le pensais... Autorise-la à rester, ma mie. Elle peut peut-être t'être utile dans ton périple.",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1425": {
			"id": 1425,
			"bot": "277_469_20",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Attends... Je sais que tu n'as pas d'autre choix que d'avancer, mais j'ai si peur pour toi, mon protecteur !... Rien de pire ne pourrait m'arriver que de te perdre...",
					"femaleText": "Attends... Je sais que tu n'as pas d'autre choix que d'avancer, mais j'ai si peur pour toi, mon protecteur !... Rien de pire ne pourrait m'arriver que de te perdre...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Pourquoi je suis si désolé ? Crois-moi, j'ai mes raisons. Le corène à cornes est en route. Il était le champion incontesté des tournois de guerriers qui avaient lieu avant que l'on n'entende parler de Sovering...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Le corène à cornes est si puissant qu'il peut brandir telle une plume, une épée grande comme un humain !",
					"location": "left"
				},
				"4": {
					"npc": "1186",
					"maleText": "Cette épée peut couper un cavalier et son cheval en deux ! Je ne dirais pas cela si je ne l'avais pas vu de mes propres yeux !",
					"location": "left"
				},
				"5": {
					"npc": "1186",
					"maleText": "Le corène était capable de tuer n'importe qui d'un seul coup lorsqu'il était humain. Maintenant, il est possédé par Sovering et son pouvoir démoniaque. Je te demande juste d'être prudent. Pour Radway, pour moi...",
					"femaleText": "Le corène était capable de tuer n'importe qui d'un seul coup lorsqu'il était humain. Maintenant, il est possédé par Sovering et son pouvoir démoniaque. Je te demande juste d'être prudent. Pour Radway, pour moi...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1430": {
			"id": 1430,
			"bot": "278_413_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "J'ai fait un terrible cauchemar. Je me suis réveillée en nage avec la peur au ventre.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Dans mon rêve, j'ai vu des créatures aussi puissantes que des montagnes... Les armes ne transpercent pas leurs corps de cristal... Maman dit que ce n'était qu'un rêve.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1435": {
			"id": 1435,
			"bot": "278_409_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Je ressens Leur pouvoir à présent... Les gens sont si chétifs en comparaison...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Elles sont là, devant nous... Les créatures de cristal... Elles n'ont pas d'âme, mais Elles sont furieuses d'avoir été réveillées... Terriblement furieuses... Tu n'as pas peur ? Tu devrais pourtant !",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1444": {
			"id": 1444,
			"bot": "278_407_23",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "J'ai le pressentiment qu'il va arriver malheur ! Je me fais du souci pour toi, mon héros.",
					"femaleText": "J'ai le pressentiment qu'il va arriver malheur ! Je me fais du souci pour toi, mon protecteur.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "J'ai vu une créature que je n'ai jamais vue auparavant. Mais je me souviens de certaines légendes sur des créatures de ce genre. Ce sont des cristallides. On dit qu'elles ont vécu il y a des siècles, et qu'un beau jour, elles se sont endormies...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Fais attention à toi ! Tu es le seul qui puisses sauver Radway !",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1452": {
			"id": 1452,
			"bot": "278_411_25",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Tu te bats admirablement bien, mon bienfaiteur ! Tu sais, j'ai pensé aux malheurs qui ont frappé le monde... D'abord le démon Sovering, puis maintenant ces géants de pierre...",
					"femaleText": "Tu te bats admirablement bien, mon bienfaiteur ! Tu sais, j'ai pensé aux malheurs qui ont frappé le monde... D'abord le démon Sovering, puis maintenant ces géants de pierre...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Cela ne peut être une simple coïncidence... Il y a quelqu'un derrière tout ça... Une main diabolique a réveillé le démon et les géants... Un être connaissant la magie noire, et élémentaliste en même temps...",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1457": {
			"id": 1457,
			"bot": "278_412_25",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Le sol tremble... Est-ce un tremblement de terre ?",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Non... Ce sont... des pas ! Les pas de quelqu'un de très grand... Il s'approche. Que vais-je découvrir ? Par pitié !",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1465": {
			"id": 1465,
			"bot": "279_414_29",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "J'ai entendu dire qu'il y a des sangliers particulièrement dangereux dans le coin. J'ai cependant déjà eu à faire à des porcs bien pires dans les pubs de Branendal.",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1474": {
			"id": 1474,
			"bot": "279_415_30",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Beau combat, mon héros. Regarde, un autre sanglier. Bizarre, je n'en ai jamais vu de la sorte...",
					"femaleText": "Beau combat, mon protecteur. Regarde, un autre sanglier. Bizarre, je n'en ai jamais vu de la sorte...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Tout cela est dû aux glands du chêne qui pousse là-bas. Ses racines vont puiser de l'énergie en enfer... Les porcs mangent les glands qui en tombent.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Ils sont donc mauvais, très mauvais. Vite, cachons-nous !",
					"location": "left"
				},
				"4": {
					"location": ""
				},
