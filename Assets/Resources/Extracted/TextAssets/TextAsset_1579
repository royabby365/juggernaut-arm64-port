		"1147": {
			"id": 1147,
			"bot": "52_125_5",
			"dialogs": {
				"1": {
					"npc": "1270",
					"maleText": "Cycloptiques : Hourra ! Une personne vivante qui respire ! Je vais te mordre la jambe ! Je vais te cracher dans les yeux ! Je vais t'arracher l'oreille ! Hourra ! Tu ne peux nous échapper !",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1155": {
			"id": 1155,
			"bot": "236_239_8",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Je savais que tu viendrais. Maman m'a dit que j'aurai des amis... Je suis Una... Je suis du village voisin... Je n'y retournerai jamais. Je viens avec toi.",
					"femaleText": "Je savais que tu viendrais. Maman m'a dit que j'aurai des amis... Je suis Una... Je suis du village voisin... Je n'y retournerai jamais. Je viens avec toi.",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1156": {
			"id": 1156,
			"bot": "236_240_9",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Je ne devrais probablement pas raconter ce qui s'est passé dans le village. Je me suis échappé pour aller cueillir des baies dans la forêt. Et quand je suis rentré, les gens étaient mauvais, très mauvais.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Ils n'étaient pas comme d'habitude. Ils avaient l'air de faire semblant d'être des humains, comme le loup du conte de fées. J'ai appelé, mais personne n'a répondu.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Les villageois ont changé... Il se sont jetés sur moi ! Cela a été difficile de leur échapper.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Quand j'y repense, je serre mon nounours et je pleure. Je crois que tu ne me feras pas de mal. Heureusement que je t'ai rencontré. Maman dit aussi que j'ai eu de la chance.",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1157": {
			"id": 1157,
			"bot": "236_241_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Tu me demandes où est ma maman ? Elle est là, à me parler. Si tu veux lui dire quelque chose, je lui transmets ton message.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Pourquoi est-ce que tu me regardes comme ça ? Je n'aime pas que l'on me regarde comme ça... Des choses terribles peuvent arriver !",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1158": {
			"id": 1158,
			"bot": "236_49_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Stop ! Tu entends ? L'homme du marais gémit... Maman me l'a montré. Autrefois, il était comme tout le monde, jusqu'au jour où il s'est noyé dans le marais. Il est hideux et veut notre mort  à tout prix...",
					"location": "left"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1159": {
			"id": 1159,
			"bot": "275_398_14",
			"dialogs": {
				"1": {
					"npc": "1271",
					"maleText": "Donne tes affaires ! Je ne te le demanderai pas deux fois ! Si tu les déposes là, je te laisse sortir. Si tu traînes, tu ramperas à quatre pattes. Et si tu refuses, tu signes ton arrêt de mort !",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1317": {
			"id": 1317,
			"bot": "276_369_12",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "J'aime marcher comme ça avec toi. J'ai l'impression que nous faisons une promenades et que je suis un enfant ordinaire.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Maman dit que je te fais peur. Est-ce que tu as vraiment peur d'une petite fille ?",
					"femaleText": "Maman dit que je te fais peur. Est-ce que tu as vraiment peur d'une petite fille ?",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				},
				"5": {
