		"1515": {
			"id": 1515,
			"bot": "280_426_29",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Mon héros, je dois dire que j'ai été injuste avec cette fille... Una. C'est une enfant, elle est très mûre pour son âge. Elle serait une excellente amazone.",
					"femaleText": "Mon protecteur, je dois dire que j'ai été injuste avec cette fille... Una. C'est une enfant, elle est très mûre pour son âge. Elle serait une excellente amazone.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Mais elle porte des forces maléfiques en elle. Plus nous approcherons du repaire de Sovering, plus Una changera... et cela empirera.",
					"femaleText": "Mais elle porte des forces maléfiques en elle. Plus nous approcherons du repaire de Sovering, plus Una changera... et cela empirera.",
