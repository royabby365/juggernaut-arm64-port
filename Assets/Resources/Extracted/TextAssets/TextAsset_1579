		"1547": {
			"id": 1547,
			"bot": "1182_1188_38",
			"dialogs": {
				"1": {
					"npc": "1153",
					"maleText": "Maman dit que tes pouvoirs grandissent. Tout comme les miens. On remet ça ?",
					"location": "right"
				}
			},
			"minVersion": null,
