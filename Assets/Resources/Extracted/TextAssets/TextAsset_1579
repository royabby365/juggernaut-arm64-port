			"bot": "285_495_45",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Les squelettes ne sont pas aussi repoussants que les cadavres pourris, mais ils sont plus dangereux au combat. Sovering leur a probablement insufflé de la vie pour qu'ils puissent nous détruire.",
					"location": "left"
