		"1383": {
			"id": 1383,
			"bot": "277_400_16",
			"dialogs": {
				"1": {
					"npc": "1187",
					"maleText": "Agenouille-toi devant Sovering, misérable créature !",
					"femaleText": "Agenouille-toi devant Sovering, misérable créature !",
					"location": "right"
				},
				"2": {
					"npc": "1187",
					"maleText": "Le seigneur te voit à travers mes yeux, et il te demande de t'agenouiller ! Si tu résistes, il me confèrera une grande force et je te taillerai en pièces !",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1388": {
			"id": 1388,
			"bot": "277_401_17",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Ne te rue pas sur ton arme, guerrier ! Je suis revenu pour te remercier, pas pour t'attaquer ! En me battant au combat, tu as extirpé de mon être l'esprit maléfique de Sovering !",
					"femaleText": "Ne te rue pas sur ton arme, guerrier ! Je suis revenu pour te remercier, pas pour t'attaquer ! En me battant au combat, tu as extirpé de mon être l'esprit maléfique de Sovering !",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Je m'appelle Ariana et je te dois la vie ! Conformément aux lois amazones, je te servirai jusqu'à la fin de mes jours. Laisse-moi le temps de soigner mes blessures et je te suivrai jusqu'au bout du monde !",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1391": {
			"id": 1391,
			"bot": "277_402_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Je n'aime pas cette femme que tu as emmenée avec nous. L'amazone. Débarrasse-toi d'elle, tu entends !!",
					"femaleText": "Je n'aime pas cette femme que tu as emmenée avec nous. L'amazone. Débarrasse-toi d'elle, tu entends !!",
					"location": "left"
				},
				"2": {
					"location": ""
