		},
		"TutFirstMagicBook": {
			"id": 948,
			"code": "TutFirstMagicBook",
			"text": "Büyü Kitabı'nı kullanarak bildiğin büyüleri geliştirebilir ve yeni büyüler öğrenebilirsin. Bunun için Büyülü Kafataslarına ve belli bir büyü becerisine ihtiyacın var. Becerini, dövüşte büyü yaparak arttırabilirsin."
		},
		"TutFirstMobAttack": {
			"id": 947,
			"code": "TutFirstMobAttack",
			"text": "Bu bölgeye asabi bir canavar saldırdı. Onu bir an önce yok etmelisin. Aksi halde yerli halkın hayatı tehlikeye girer."
		},
		"TutFirstMoneyPile": {
			"id": 922,
			"code": "TutFirstMoneyPile",
			"text": "Özgürleştirilmiş bölgelerde yaşayanlar, senin için para toplarlar. Nüfus ne kadar fazlaysa o kadar çok para alırsın. Nüfus, zamanla kendi kendine artar. Özgür bölgelere düzenli aralıklarla uğrayarak senin için toplanan altınları tahsil et."
		},
		"TutGotLevel": {
			"id": 934,
			"code": "TutGotLevel",
			"text": "Seviyen yükseldi. Artık üç yeni nesneye erişimin var. Dükkana gidip bir kemer, kolluk ve göğüslük al. Bunlar seni daha güçlü yapacak. İleride Lider ile yapacağın dövüşte bunlara ihtiyacın olacak."
		},
		"TutImmBattle": {
			"id": 907,
			"code": "TutImmBattle",
			"text": "Düşmanın dirençli olduğu bir büyü kullandın. Başka bir büyü kullan. Düşmanın dirençli olduğu büyüyü, isminin yanında görebilirsin."
		},
		"TutImmZ": {
			"id": 908,
			"code": "TutImmZ",
			"text": "Belli bir büyünün işlemediği bir düşmanla karşılaştın. Bu büyü, canavarın isminin yanında, parantez içinde gösterilir. O yüzden dövüşürken başka bir çeşit büyü kullanmayı dene. Büyü Kitabı'nı kullanarak yeni büyüler öğrenebilirsin."
		},
		"TutLocationScarab": {
			"id": 924,
			"code": "TutLocationScarab",
			"text": "Bir bölgeyi canavarlardan temizledikten sonra gizli hazine sandıkları arayabilirsin. Bu sandıkların içinde büyülü madalyonlar, yüzükler, küpeler ve başka yararlı nesneler bulabilirsin."
		},
		"TutMagicBookButton": {
			"id": 990,
			"code": "TutMagicBookButton",
			"text": "\"Büyü\" becerisini elde ederek aynı zamanda Büyü Kitabı'na da erişim kazandın."
		},
		"TutPlayerDefeat": {
			"id": 923,
			"code": "TutPlayerDefeat",
			"text": "Bir dövüşü kaybedersen tekrar deneyebilirsin. Eğer düşmanı yenemiyorsan dövüşü sonlandırıp dükkana git. Buradan zırh ve mühimmat alarak kendini güçlendir."
		},
		"TutResurrection": {
			"id": 834,
			"code": "TutResurrection",
			"text": "Kombine vuruşlarla düşmanın ruhunu ele geçirebilirsin. Bu, Ank denen özel bir maddede gizlidir. Ank, zaferden sonra düşmanı diriltir ve ona \nkanlı bir idama\n yaşatır."
		},
		"TutSearchTreasure": {
			"id": 837,
			"code": "TutSearchTreasure",
			"text": "Tarla Böceklerini kullanarak hazine arayabilirsin. Bunun için böceği bölgede gezdirerek yaydığı ışığı gözle. Hazineye yaklaştıkça daha çok ışık yayar. Hazinenin üzerindeyken kanatlarını çırpmaya başlar. Burayı kazabilirsin."
		},
		"TutShop": {
			"id": 914,
			"code": "TutShop",
			"text": "Dükkanda, biriktirdiğin altınları harcayabilirsin. \"Önerilen\" bölümünde seviyene uygun, üzerindekilerden daha iyi zırhlar bulabilirsin. Burada aynı zamanda dövüşlerde çok işine yarayacak her tür mühimmat da satın alabilirsin."
		},
		"TutShopFilter2": {
