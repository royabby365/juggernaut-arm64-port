			"text": "Oyunda vuruşlar sırayla yapılır. Sen vurduktan sonra düşman cevap verir. Vuruş için birkaç saniyen var. Bu süreyi, yukarıdaki kırmızı göstergeden takip edebilirsin."
		},
		"TutEndChests": {
			"id": 916,
			"code": "TutEndChests",
			"text": "Burada gizli olan tüm hazineleri kazdın. Diğer özgürleştirilmiş bölgelerde daha fazla hazine bulabilirsin."
		},
		"TutEpicItemPuton": {
			"id": 1201,
			"code": "TutEpicItemPuton",
			"text": "Efsanevi hale dönüştürebileceğin epik bir nesne kazandın. Bunun için gerekli miktarda efsanevi puanı nesneye uygula."
		},
		"TutEye": {
			"id": 818,
			"code": "TutEye",
			"text": "Öfken arttıkça öfke ile beslenen Kaos Gözü'nün dikkatini daha çok çekersin. Ne kadar çok öfke toplarsan onu o kadar sık görürsün. Bütün öfkeni sömürmeden Kaos Gözü'nü yok etmelisin."
		},
		"TutEye_2": {
			"id": 823,
			"code": "TutEye_2",
			"text": "Kaos Gözü'nü yok etmek için patlayınca kadar üzerine dokun."
		},
		"TutFallingStarPhrase1": {
			"id": 1244,
			"code": "TutFallingStarPhrase1",
			"text": "Dövüşte bazen kayan bir yıldız görebilirsin. Bunu yakalayabilirsen dövüşün sonunda ek efsanevi puan kazanırsın."
		},
		"TutFallingStarPhrase2": {
			"id": 1245,
			"code": "TutFallingStarPhrase2",
