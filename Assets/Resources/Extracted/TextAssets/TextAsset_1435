				"2": {
					"npc": "1186",
					"maleText": "Siempre atacan en grupo tendiendo emboscadas y roban todo lo que no esté bien atado. Y solo saben decir blasfemias. ¡Estoy segura de que los pondrás en su lugar, mi héroe!",
					"femaleText": "Siempre atacan en grupo tendiendo emboscadas y roban todo lo que no esté bien atado. Y solo saben decir blasfemias. ¡Ponlos en su lugar, mi salvadora!",
					"location": "left"
				},
				"3": {
					"npc": "1270",
					"maleText": "Mira, ¡una presa! ¡Me pido atacar primero! ¡No, yo! ¡Ataquemos juntos! ¡Prepárate a morir, humano!",
					"location": "right"
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1745": {
			"id": 1745,
			"bot": "284_490_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Casi todas mis hermanas están poseídas, como yo antes de conocerte. Nobles guerreras transformadas en monstruos. ¡Qué fin más terrible para nuestra tribu!",
					"femaleText": "Casi todas mis hermanas están poseídas y se han transformado en monstruos, como yo antes de conocerte. ¡Qué fin más terrible para nuestra tribu!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Ahí hay una, ¡pobre! Lucha contra ella, quizás pueda curarse igual que yo; si no al menos pondrás fin a su sufrimiento. ¡Pero cuidado! Las amazonas son astutas y fuertes, ¡y esta lleva un demonio en su interior!",
					"femaleText": "Ahí hay una, ¡pobre! Lucha contra ella, quizás pueda curarse igual que yo; si no al menos pondrás fin a su sufrimiento.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1748": {
			"id": 1748,
			"bot": "284_489_40",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Ante nosotros se halla un monstruo de garras enormes... ¡tanto que podría rajar a alguien a la mitad! ¡Solo tú puedes vencerlo, mi héroe!",
					"femaleText": "Ante nosotras se halla un monstruo de garras enormes... ¡tanto que podría rajar a alguien a la mitad! ¡Solo tú puedes vencerlo, mi protectora!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1753": {
			"id": 1753,
			"bot": "285_498_41",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "El mero aspecto de este lugar me revuelve el estómago... ¡Sobre este lugar pesa una maldición! Un mal antiguo reina aquí, un mal inmenso...",
					"location": "left"
				},
				"2": {
					"npc": "1185",
					"maleText": "Llevo tanto esperando... Tengo la garganta reseca. Quiero beber tu sangre para saciar mi sed...",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1762": {
			"id": 1762,
			"bot": "285_497_42",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Mira, ahí hay otro... ¡Temo a los cadáveres resucitados más que a nada! Creo que me moriría de asco si una de esas criaturas me tocase con sus pútridos dedos...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Me alegro de que estés aquí, mi benefactor... Me defenderás y salvarás el mundo, ¡estoy segura!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1769": {
			"id": 1769,
			"bot": "285_375_43",
			"dialogs": {
				"1": {
					"npc": "1145",
					"maleText": "¿Aún vivo? ¡Los dioses te acompañan si los buitres aún no están destripando tu cadáver! O quizás peleas bien realmente...",
					"femaleText": "¿Aún viva? ¡Los dioses te acompañan si los buitres aún no están destripando tu cadáver! O quizás peleas bien realmente...",
					"location": "left"
				},
				"2": {
					"npc": "1146",
					"maleText": "Siento más fuerza en ti, guerrero. Quizás nos resultes útil en algún momento, pero ahora tenemos prisa, nuestra caza no ha terminado.",
					"femaleText": "Siento más fuerza en ti, guerrera. Quizás nos resultes útil en algún momento, pero ahora tenemos prisa, nuestra caza no ha terminado.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1772": {
			"id": 1772,
			"bot": "285_495_45",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Los skelts no son tan asquerosos como los cadáveres putrefactos, pero son más peligrosos en combate. Probablemente Sovering les insufló vida, y por eso pueden destruirnos...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1777": {
			"id": 1777,
			"bot": "285_494_45",
			"dialogs": {
				"1": {
					"npc": "1184",
					"maleText": "¿Adónde vas con la espada desenvainada, mortal? Este es el dominio de mi señor Sovering, y todos los humanos deberían arrastrarse de rodillas hasta él, con la cabeza bien gacha.",
					"location": "right"
				},
				"2": {
					"npc": "1184",
					"maleText": "¡Pero ni eso te salvará, criatura insolente! No te permitiré interrumpir el descanso de mi señor. Él te reduciría a cenizas con una simple mirada, ¡pero yo me encargaré de ti antes de llegar a eso!",
					"location": "right"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1782": {
			"id": 1782,
			"bot": "286_492_55",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "¡Mi corazón se estremece! ¡Te enfrentarás al mismísimo Sovering! Si ganas, librarás al mundo de su maldición, pero si pierdes, ¡todos falleceremos! ¡Suplico ayuda a los dioses!",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1856": {
			"id": 1856,
			"bot": "1181_373_20",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Este es un mal sitio. Vayámonos.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "¿Oyes eso? Es como el ruidito de ratones. Y se acerca...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1858": {
			"id": 1858,
			"bot": "1181_1189_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Huele raro, como ese gato que se ahogó en el río.",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1872": {
			"id": 1872,
			"bot": "1862_1863_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Mamá dice que no se alegran de vernos. A la gente de la ciénaga no le gustan las visitas.",
					"location": "left"
				},
				"2": {
					"npc": "1868",
					"maleText": "¿Una persona en las ciénagas? ¡Aquí no se te ha perdido nada! ¡Espíritus del cenagal, he aquí mi ofrenda!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1876": {
			"id": 1876,
			"bot": "1862_1864_14",
			"dialogs": {
				"1": {
					"npc": "1869",
					"maleText": "¿A qué has venido a esta tierra? Antes a nadie le interesaba la ciénaga, y solo los toperes que vivimos en ella mandábamos aquí.",
					"location": "right"
				},
				"2": {
					"npc": "1869",
					"maleText": "¡Aquí llega tu muerte! Tu única mortaja será el barro y no habrá más que ranas llorando en tu funeral.",
					"location": "right"
				},
				"3": {
					"npc": "1869",
					"maleText": "¿No quieres hacer lo correcto? Mis guerreros te convertirán en comida de gusanos, ¡prepárate!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1880": {
			"id": 1880,
			"bot": "1862_1865_16",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Los mayores decían que si me portaba mal, me convertiría en toper... ¿Crees que todos esos eran niños malos?",
					"location": "left"
				},
				"2": {
					"npc": "1869",
					"maleText": "¿Cómo osas pasearte así por mi reino y matar a mis guerreros? ¡Son mis hijos! ¡Te arrepentirás!",
					"location": "right"
				},
				"3": {
					"npc": "1869",
					"maleText": "Solo conservarás tu vida si te conviertes en mi siervo, ¡qué mejor destino para un humano! ¿No? ¡Entonces morirás!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1883": {
			"id": 1883,
			"bot": "1862_1866_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Son muy astutos. Hay alguien cerca. Una mujer de la ciénaga está allí escondida. Cree que nadie la ve. Pero mamá puede ver a todos.",
					"location": "left"
				},
				"2": {
					"npc": "1868",
					"maleText": "Ya hay muchos huesos humanos en nuestra ciénaga, ¡pero aún queda sitio para los tuyos!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1886": {
			"id": 1886,
			"bot": "1862_1867_17",
			"dialogs": {
				"1": {
					"npc": "1869",
					"maleText": "La sangre derramada de mis soldados ha tornado roja la ciénaga... ¡Eres fuerte, pero nosotros lo somos más!",
					"location": "right"
				},
				"2": {
					"npc": "1869",
					"maleText": "La ciénaga te tragará y los espíritus danzarán de alegría sobre tu tumba. ¡Y los toperes dominaremos el mundo!",
					"location": "right"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		},
		"1888": {
			"id": 1888,
			"bot": "275_395_12",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "En la aldea decían cosas malas de la mina. Decían que los salteadores se ocultan ahí. ¿Y si es verdad? ¿No tienes miedo?",
					"location": "left"
				}
			},
			"minVersion": "2.1",
			"maxVersion": null
		}
	}
