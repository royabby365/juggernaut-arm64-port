			"dialogs": {
				"1": {
					"npc": "1270",
					"maleText": "Ciclópticos: ¡Qué bien! ¡Una persona viva! ¡Te morderé la pierna! ¡Te escupiré en el ojo! ¡Te arrancaré las orejas! ¡Qué divertido! ¡Qué bien lo voy a pasar!",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
