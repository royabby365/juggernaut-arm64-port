			},
			"minVersion": null,
			"maxVersion": null
		},
		"1474": {
			"id": 1474,
			"bot": "279_415_30",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Gran combate, mi héroe. Mira, hay otro jabalí. Es extraño, nunca he visto nada como esto...",
					"femaleText": "Gran combate, mi protectora. Mira, hay otro jabalí. Es extraño, nunca he visto nada como esto...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Todo se debe a las bellotas de ese roble. Es un roble maligno, con raíces que llegan hasta el mismísimo infierno... Y los cerdos comen sus bellotas...",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Por eso también son malos... ¡muy malos! ¡Escondámonos!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
