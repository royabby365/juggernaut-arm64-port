		"1398": {
			"id": 1398,
			"bot": "277_403_18",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Disculpa, mi salvador, no quería decir nada, pero no puedo seguir mordiéndome la lengua. La... niña que viaja con nosotros... en Branendal la gente tiembla solo con pensar en ella. ¡Esta poseída por un demonio!",
					"femaleText": "Disculpa, mi salvador, no quería decir nada, pero no puedo seguir mordiéndome la lengua. La... niña que viaja con nosotros... en Branendal la gente tiembla solo con pensar en ella. ¡Esta poseída por un demonio!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "¿Te dijo que se escapó de su aldea? ¡No la creas! La chiquilla mató a su pueblo, ¡y ahora quiere hacernos lo mismo!",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "¿Por qué dice eso?... ¿Tú también crees que hice algo malo? No es cierto. Me he portado bien, de verdad...",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1407": {
			"id": 1407,
			"bot": "277_404_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Uma es mala, es una mentirosa. Mi gente, mi aldea... Mentí. En realidad no me escapé...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "¡Pero ellos me atacaron primero! ¡Yo no quería, de verdad! Pero nunca había tenido tanto miedo... y algo ocurrió...",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Y todos ardieron y murieron. Murieron. Toda nuestra familia, vecinos, toda la aldea... Me porté mal. Pero mamá dice que tenía que ser así.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Porque si no me habrían matado... Sovering los volvió malos a todos. Me persiguieron. Voy a ponerme a llorar. Por favor no me eches...",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1414": {
			"id": 1414,
			"bot": "277_405_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Llevo llorando todo el día... Me perdonarás por lo que pasó en la aldea, ¿verdad? Por favor, perdóname y déjame ir contigo...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Además de ti, no tengo amigos. Solo tengo a mi osito y a mamá que me cuida...",
					"femaleText": "Además de ti, no tengo amigos. Solo tengo a mi osito y a mamá que me cuida...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Empiezo a tener lástima de la niña. Quizás no sea tan terrible como pensaba... Déjala quedarse, mi héroe. Tal vez hasta te ayude en tu peligroso camino.",
					"femaleText": "Empiezo a tener lástima de esta niña. Quizás no sea tan terrible como pensaba... Déjala quedarse, mi señora. Tal vez hasta te ayude en tu peligroso camino.",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1425": {
			"id": 1425,
			"bot": "277_469_20",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Espera... sé que no tienes más opción que continuar tu camino, pero tengo tanto miedo por ti, mi protector... Nada sería peor que perderte...",
					"femaleText": "Espera... sé que no tienes más opción que continuar tu camino, pero tengo tanto miedo por ti, mi protectora... Nada sería peor que perderte...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "¿Que por qué me preocupo tanto? Créeme, tengo motivos. Koren el Astado se dirige hacia aquí. Fue el campeón indiscutible de los torneos de guerreros celebrados antes de saber siquiera quién era Sovering...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "¡Koren el Astado es tan poderoso que puede blandir una espada del tamaño de un hombre como si fuera una pluma!",
					"location": "left"
				},
				"4": {
					"npc": "1186",
					"maleText": "Esta espada puede partir en dos a un caballero, ¡junto con su caballo! Y no lo afirmaría si no lo hubiese visto con mis propios ojos.",
					"location": "left"
				},
				"5": {
					"npc": "1186",
					"maleText": "Cuando era humano, Koren podía matar a cualquiera con un solo espadazo. Ahora está poseído por Sovering y lleno de poder demoníaco. Solo te pido cautela. Hazlo por Radway, y por mí...",
					"femaleText": "Cuando era humano, Koren podía matar a cualquiera con un solo espadazo. Ahora está poseído por Sovering y lleno de poder demoníaco. Solo te pido cautela. Hazlo por Radway, y por mí...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1430": {
			"id": 1430,
			"bot": "278_413_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Tuve un sueño horrible. Me desperté y seguí temblando hasta la mañana.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "En el sueño vi a criaturas tan viejas como el tiempo y tan poderosas como montañas... Ningún arma puede perforar sus cuerpos de cristal... Mamá dice que solo era un sueño.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1435": {
			"id": 1435,
			"bot": "278_409_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ahora siento Su poder... La gente es tan frágil en comparación con Ellos...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Están ahí delante... Las criaturas de cristal... No tienen alma, pero están enfadadas porque las han despertado... Muy, muy enfadadas... ¿No tienes miedo? ¡Deberías!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1444": {
			"id": 1444,
			"bot": "278_407_23",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "¡En mi corazón siento que la desgracia se aproxima! Estoy tan preocupada por ti, mi héroe.",
					"femaleText": "¡En mi corazón siento que la desgracia se aproxima! Estoy muy preocupada por ti, mi protectora.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Más adelante vi una criatura que no había visto nunca, pero recuerdo leyendas sobre seres como esos. Se llaman cristálidas, y se dice que vivieron hace siglos, pero se durmieron...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "¡Por favor, ten cuidado! Después de todo, ¡solo tú puedes salvar Radway!",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1452": {
			"id": 1452,
			"bot": "278_411_25",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "¡Peleas muy bien, mi salvador! Yo he estado pensando en todas las desgracias que han caído sobre el mundo... Primero el demonio Sovering, luego los gigantes de piedra...",
					"femaleText": "¡Peleas muy bien, mi salvadora! Yo he estado pensando en todas las desgracias que han caído sobre el mundo... Primero el demonio Sovering, luego los gigantes de piedra...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "No puede ser una coincidencia... Tiene que haber alguien detrás de tantas vilezas... Algún canalla despertó al demonio y a los gigantes... Alguien que sea al mismo tiempo un hábil mago negro y un elementalista...",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1457": {
			"id": 1457,
			"bot": "278_412_25",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "El suelo tiembla... ¿Es un terremoto?",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "No es un terremoto... Son... ¡pisadas! Las pisadas de alguien muy grande... Y se acercan... Me da miedo hasta mirar... ¡clemencia!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1465": {
			"id": 1465,
			"bot": "279_414_29",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "He oído que por esta zona hay jabalís muy fieros y peligrosos. Aún así, ¡ya me las he visto con cerdos peores en las tabernas de Branendal!",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
