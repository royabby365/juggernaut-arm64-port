		"1320": {
			"id": 1320,
			"bot": "276_124_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Luchas de una forma tan graciosa moviendo la espada como si bailases. Es una pena que mamá no me deje enseñarte lo que sé de pelear...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1325": {
			"id": 1325,
			"bot": "276_493_15",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Nos sigue. ¿Oyes sus pisadas? Yo las oigo. Siento su presencia. No está bien. Está sufriendo.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Tiene mucha hambre. Antes comía gente. Pero hace tiempo que no encuentra a nadie, solo arañas y murciélagos. Nos va a comer... ¡seguro!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1328": {
			"id": 1328,
			"bot": "1181_498_19",
			"dialogs": {
				"1": {
					"npc": "1185",
					"maleText": "Carne viva... En las profundidades me moría por tener comida caliente... Apareces justo a tiempo, mortal... Me alimentaré de ti...",
					"location": "right"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1378": {
			"id": 1378,
			"bot": "275_399_14",
			"dialogs": {
				"1": {
					"npc": "1272",
					"maleText": "¿Crees que por haber vencido a los demás también podrás conmigo? ¿Sabes a cuánta gente he matado yo? ¡No existe el cementerio en el que quepan todos!",
					"femaleText": "¿Crees que por haber vencido a los demás también podrás conmigo? ¿Sabes a cuánta gente he matado yo? ¡No existe el cementerio en el que quepan todos!",
					"location": "right"
				},
				"2": {
					"npc": "1272",
					"maleText": "¡Voy a despedazarte! ¡Me haré un cáliz con tu calavera, un collar con tus dientes y flautas con tus huesos!",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
