			"bot": "284_485_37",
			"dialogs": {
				"1": {
					"npc": "1154",
					"maleText": "¿Aún vives, loco? ¡Esa imprudente determinación no te durará mucho! Escúchame, te lo digo por tu bien, ¡da la vuelta!",
					"femaleText": "¿Aún vives, loca? ¡Esa imprudente determinación no te durará mucho! Escúchame, te lo digo por tu bien, ¡da la vuelta!",
