		},
		"1155": {
			"id": 1155,
			"bot": "236_239_8",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Sabía que vendrías. Mamá me dijo que tendría amigos... Soy Uma. Vivo en la aldea próxima...pero no voy a volver nunca allí. Voy a ir contigo.",
					"femaleText": "Sabía que vendrías. Mamá me dijo que tendría amigos... Soy Uma. Vivo en la aldea próxima...pero no voy a volver nunca allí. Voy a ir contigo.",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1156": {
			"id": 1156,
			"bot": "236_240_9",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Supongo que no debería contar lo que pasó en la aldea. Salí sin permiso para recoger moras en el bosque. Y cuando regresé, la gente se había vuelto mala. Muy mala.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "No eran ellos mismo. Eran como seres que imitaban a personas, igual que en el cuento del lobo disfrazado. Grité, pero nadie me contestó.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "La gente de la aldea cambió... Se abalanzaron sobre mí, me escapé por los pelos.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Cuando lo recuerdo, abrazo a mi osito y lloro... Tú no me harás daño, ¿verdad? Me alegra haberte encontrado. Mamá dice que es una suerte.",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1157": {
			"id": 1157,
			"bot": "236_241_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "¿Que dónde está mi mamá? Está aquí, habla conmigo. Si quieres decirle algo, yo le transmitiré tus palabras.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "¿Por qué me miras así? No me gusta cuando la gente me mira así... ¡pueden pasar cosas horribles!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1158": {
			"id": 1158,
			"bot": "236_49_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Para. ¿Lo oyes? El hombre del pantano gime... Mamá me lo mostró. Antes era igual que el resto de la gente, pero entonces se ahogó en el pantano y cambió. Es terrorífico, y quiere matarnos...",
					"location": "left"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1159": {
			"id": 1159,
			"bot": "275_398_14",
			"dialogs": {
				"1": {
					"npc": "1271",
					"maleText": "¡Entrega tus posesiones! ¡No te lo repetiré! Si me las entregas te dejaré marchar; si no lo haces inmediatamente, saldrás de aquí arrastrándote, y si te niegas, ¡no vivirás para contarlo!",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				},
				"4": {
