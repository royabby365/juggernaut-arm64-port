		},
		"1317": {
			"id": 1317,
			"bot": "276_369_12",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Me gusta ir así contigo. Es como si estuviésemos dando un paseo y yo fuese una niña normal.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Mamá dice que te asusto. ¿De verdad te da miedo una niña pequeña?",
					"femaleText": "Mamá dice que te asusto. ¿De verdad te da miedo una niña pequeña?",
					"location": "left"
