			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "¡Esta hermosa jungla es mi tierra natal! En ningún otro sitio es tan dulce el olor de las flores y el canto de los pájaros. ¡Y no encontrarás fruta más sabrosa que la de aquí!",
					"femaleText": "¡Esta hermosa jungla es mi tierra natal! En ningún otro sitio es tan dulce el olor de las flores y el canto de los pájaros.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Todo esto nos pertenecía a las amazonas. Capturábamos a hombres, por placer y para que nos sirviesen.",
					"femaleText": "Todo esto nos pertenecía a las amazonas. Capturábamos a hombres, por placer y para que nos sirviesen. Una vida estupenda, ¿no crees?",
