				},
				"2": {
					"npc": "1154",
					"maleText": "Retírate y puede que vivas para ver otro amanecer. Continúa y te sumergirás en el crepúsculo eterno. ¡Reflexiona, mortal!",
					"femaleText": "Retírate y puede que vivas para ver otro amanecer. Continúa y te sumergirás en el crepúsculo eterno. ¡Reflexiona, mujer!",
					"location": "left"
