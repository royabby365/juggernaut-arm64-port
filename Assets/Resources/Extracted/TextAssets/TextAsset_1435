		"1383": {
			"id": 1383,
			"bot": "277_400_16",
			"dialogs": {
				"1": {
					"npc": "1187",
					"maleText": "¡Arrodíllate ante Sovering, criatura miserable!",
					"femaleText": "¡Arrodíllate ante Sovering, criatura miserable!",
					"location": "right"
				},
				"2": {
					"npc": "1187",
					"maleText": "El señor puede ver con mis ojos, y quiere verte arrodillado. Si te resistes, el señor me llenará con su fuerza y poder, ¡y te haré pedazos!",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1388": {
			"id": 1388,
			"bot": "277_401_17",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "¡No te apresures tanto a sacar el arma! He regresado para darte las gracias, ¡no para atacarte! Al ganarme en el combate, expulsaste de mí al espíritu demoníaco de Sovering.",
					"femaleText": "¡No te apresures tanto a sacar el arma! He regresado para darte las gracias, ¡no para atacarte! Al ganarme en el combate, expulsaste de mí al espíritu demoníaco de Sovering.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Me llamo Ariana, ¡y te debo la vida! Según las leyes de la tribu amazona, a partir de ahora debo servirte hasta el fin de mis días. Dame algo de tiempo para curarme las heridas, ¡y te seguiré hasta el fin del mundo!",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1391": {
			"id": 1391,
			"bot": "277_402_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "No me gusta esa mujer que ahora también va contigo. La amazona. Deshazte de ella. Por favor. ¿Me escuchas? ¡Échala, échala, échala!",
					"femaleText": "No me gusta esa mujer que ahora también va contigo. La amazona. Deshazte de ella. Por favor. ¿Me escuchas? ¡Échala, échala, échala!",
					"location": "left"
				},
				"2": {
