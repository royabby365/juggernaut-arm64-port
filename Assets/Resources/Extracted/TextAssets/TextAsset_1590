// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 wait(0.1);
 reactfx();
 scenario(global_snd_mob2_block);
 play(block,15);
 vibration(1,2,0);
 scenario(global_react_block);
}

$react_dodge {
 reactfx();
 scenario(global_snd_mob2_dodge);
 play(dodge,10);
 scenario(global_smoke_ring1);
}

$react_dmg  {
 wait(0.5);
 reactfx();
 scenario(global_snd_mob2_damage);
 play(damage);
}

$react_dmgf {
 wait(0.5);
