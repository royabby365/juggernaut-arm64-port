  scenario(global_magic_direct_expsmall_dragonfly);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_dragonfly);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe {
 light(0,2);
 scenario(global_snd_mob2_aoe);
