//-----MAIN ATTACKS-----//

$step_l {
 scenario(ifx_step_l);
 wait(0.7);
 enemyscenario(ifx_step_l);
}

$step_r {
 scenario(ifx_step_r);
 wait(0.7);
 enemyscenario(ifx_step_r);
}

$attack {
 scenario(global_snd_mob2_attack);
 play(attack,15);
 react(f,1);
 scenario(template_attack_splash_small);
}

$attack_left {
 scenario(global_snd_mob2_attack_left);
