		"1378": {
			"id": 1378,
			"bot": "275_399_14",
			"dialogs": {
				"1": {
					"npc": "1272",
					"maleText": "Du denkst wohl, dass du mit mir auch fertig wirst? Weißt du, wieviele Menschen ich getötet habe? Der größte Friedhof der Welt könnte sie nicht aufnehmen!",
					"femaleText": "Du denkst wohl, dass du mit mir auch fertig wirst? Weißt du, wieviele Menschen ich getötet habe? Der größte Friedhof der Welt könnte sie nicht aufnehmen!",
					"location": "right"
				},
				"2": {
					"npc": "1272",
					"maleText": "Ich reiße dich in Stücke! Aus deinem Schädel mache ich einen Krug und aus deinen Zähnen eine Kette!",
