		"1391": {
			"id": 1391,
			"bot": "277_402_17",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Diese Frau gefällt mir nicht, die mit uns geht. Die Amazone. Jage sie fort. Hörst du? Fort-fort-fort!",
					"femaleText": "Diese Frau gefällt mir nicht, die mit uns geht. Die Amazone. Jage sie fort. Hörst du? Fort-fort-fort!",
