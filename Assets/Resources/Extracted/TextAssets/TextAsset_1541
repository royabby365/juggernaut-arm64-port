		"1388": {
			"id": 1388,
			"bot": "277_401_17",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Greif nicht gleich zur Waffe, Krieger! Ich komme zurück, um zu danken, nicht, um anzugreifen! Als du mich besiegtest, hast du Soverings dämonisches Wesen aus mir vertrieben!",
					"femaleText": "Greif nicht gleich zur Waffe, Kriegerin! Ich komme zurück, um zu danken, nicht, um anzugreifen! Als du mich besiegtest, hast du Soverings dämonisches Wesen aus mir vertrieben!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Ich heiße Ariana und verdanke dir mein Leben! Nach dem Gesetz der Amazonen werde ich dir bis zum Tod dienen. Lass mich etwas erholen, danach werde ich mit dir bis ans Ende der Welt gehen!",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
