				"1": {
					"npc": "1187",
					"maleText": "Auf die Knie vor Sovering, Elender!",
					"femaleText": "Auf die Knie vor Sovering, Elende!",
					"location": "right"
				},
				"2": {
					"npc": "1187",
					"maleText": "Mein Herr sieht dich durch mich und befiehlt, dass du dich vor ihm verneigst! Solltest du das nicht tun, dann erfüllt er mich mit mächtiger Kraft, die dich in Stücke reißt!",
