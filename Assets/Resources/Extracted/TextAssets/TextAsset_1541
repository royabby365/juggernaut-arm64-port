		"1320": {
			"id": 1320,
			"bot": "276_124_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Du kämpfst so lustig, als ob du mit dem Schwert Tanzen würdest! Schade, dass meine Mama noch nicht erlaubt, dir unsere Kampfkunst beizubringen... ",
					"location": "left"
				}
