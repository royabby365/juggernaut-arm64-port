		"1325": {
			"id": 1325,
			"bot": "276_493_15",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Er folgt uns. Hörst du seine Schritte? Ich höre sie. Ich kann ihn spüren. Er leidet...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Er hat Hunger. Er frisst gern Menschen, hat aber lange keine mehr getroffen, nur Spinnen und Fledermäuse. Er wird uns fressen... Bestimmt!..",
