			"bot": "276_369_12",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Mir gefällt, neben dir zu gehen. Als ob wir spazieren gehen und ich einfach ein Kind bin.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Mama sagt, dass ich dir Angst mache. Fürchtest du dich wirklich vor einem kleinen Mädchen?",
					"femaleText": "Mama sagt, dass ich dir Angst mache. Fürchtest du dich wirklich vor einem kleinen Mädchen?",
