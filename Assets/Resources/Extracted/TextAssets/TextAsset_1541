		"1155": {
			"id": 1155,
			"bot": "236_239_8",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ich wusste, dass du kommst. Mama sagte, dass ich bestimmt noch Freundinnen haben werde... Ich bin Una und komme aus dem Dorf in der Nähe... Dorthin werde ich nicht zurückgehen. Ich komme mit dir.",
					"femaleText": "Ich wusste, dass du kommst. Mama sagte, dass ich bestimmt noch Freundinnen haben werde... Ich bin Una und komme aus dem Dorf in der Nähe... Dorthin werde ich nicht zurückgehen. Ich komme mit dir.",
					"location": "left"
				},
				"2": {
