		"1398": {
			"id": 1398,
			"bot": "277_403_18",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Verzeih, mein Retter, ich wollte nicht darüber reden, kann aber nicht mehr schweigen. Vor diesem... ähm... Mädchen, dass mit uns geht, haben alle Branentaler Angst! Sie ist von einem Dämon besessen!",
					"femaleText": "Verzeih, meine Retterin, ich wollte nicht darüber reden, kann aber nicht mehr schweigen. Vor diesem... ähm... Mädchen, dass mit uns geht, haben alle Branentaler Angst! Sie ist von einem Dämon besessen!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Hat sie dir erzählt, sie wäre aus ihrem Dorf geflohen? Glaub ihr nicht! Das Monster vernichtete ihre Familie und hat es auch mit uns vor!",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Warum spricht sie so?.. Denkst du auch, dass ich unrecht getan habe? Alles gelogen! Ich hebe mich gut verhalten, ganz ehrlich!..",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1407": {
			"id": 1407,
			"bot": "277_404_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Una ist böse, eine Lügnerin. meine Familie, mein Dorf... Ich habe gelogen. In Wahrheit bin ich nicht geflohen...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Sie fielen als erste über mich her! Ich wollte es nicht, ehrlich! Ich hatte einfach Angst... Wie noch nie... Etwas ist geschehen.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Dann sind sie verbrannt und gestorben. Alle. Meine Familie, die Nachbarn, alle... Ich habe Schlimmes getan, doch Mama sagt, das wäre nötig.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Weil sie mich sonst getötet hätten... Sie alle sind wegen Sovering schlecht geworden. Sie haben mich gehetzt. Ich weine gleich. jage mich bitte nicht fort...",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1414": {
			"id": 1414,
			"bot": "277_405_19",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ich weine heute den ganzen Tag... Wirst du mir vergeben, was ich im Dorf getan habe? Vergebe mir bitte und lass mich mit dir gehen...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Außer dir habe ich niemanden. Nur mein Bärchen und meine Mama begleiten mich...",
					"femaleText": "Außer dir habe ich niemanden. Nur mein Bärchen und meine Mama begleiten mich...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Das Mädchen tat mir leid. Vielleicht ist sie nicht so schrecklich, wie ich dachte... Erlaube ihr zu bleiben, mein Held. Vielleicht wird sie dir auf dieser schweren Reise eine Hilfe sein.",
					"femaleText": "Das Mädchen tat mir leid. Vielleicht ist sie nicht so schrecklich, wie ich dachte... Erlaube ihr zu bleiben, Herrin. Vielleicht wird sie dir auf dieser schweren Reise eine Hilfe sein.",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1425": {
			"id": 1425,
			"bot": "277_469_20",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Warte... Ich weiß, dass es für dich keinen anderen Weg gibt, als vorwärts, doch ich fürchte um dich, mein Retter!... Dich zu verlieren wäre furchtbar!",
					"femaleText": "Warte... Ich weiß, dass es für dich keinen anderen Weg gibt, als vorwärts, doch ich fürchte um dich, mein Retter!... Dich zu verlieren wäre schrecklich!",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Warum ich mich so fürchte? Glaube mir, ich habe meine Gründe. Der Einhörnige Koren ist hierher unterwegs - der ungeschlagene Turniersieger, der die besten Krieger besiegte, als wir noch nichts von Sovering wussten...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Einhörniger Koren ist so mächtig, dass er mit Leichtigkeit ein mannshohes Schwert schwingen kann! ",
					"location": "left"
				},
				"4": {
					"npc": "1186",
					"maleText": "Damit ist er in der Lage, einen Reiter samt Pferd zu halbieren! Ich würde dir so etwas nicht erzählen, wenn ich es nicht selbst gesehen hätte!",
					"location": "left"
				},
				"5": {
					"npc": "1186",
					"maleText": "Koren konnte zu Lebzeiten jeden Gegner mit der bloßen Faust töten. Jetzt ist er von Sovering besessen und voll dämonischer Macht. Ich bitte dich, sei vorsichtig. Radtwege zuliebe. Und mir...",
					"femaleText": "Koren konnte zu Lebzeiten jeden Gegner mit der bloßen Faust töten. Jetzt ist er von Sovering besessen und voll dämonischer Macht. Ich bitte dich, sei vorsichtig. Radtwege zuliebe. Und mir...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1430": {
			"id": 1430,
			"bot": "278_413_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ich hatte einen furchtbaren Traum. Ich schreckte zittern auf und lag bis zum Morgen wach.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Darin sah ich Wesen, so alt, wie die Welt und so mächtig, wie Berge... Ihre Kristallkörper sind unverletzbar... Mama sagt, dass es kein kein Traum war.",
					"location": "left"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1435": {
			"id": 1435,
			"bot": "278_409_22",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ich spüre jetzt ihre Kraft... Menschen sind im Vergleich zu ihnen so schwach...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Sie sind vor uns... Wesen aus Kristall... Sie besitzen keine Seele, sind aber böse, weil man sie geweckt hat... Sehr böse... Keine Angst? Solltest du haben.",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1444": {
			"id": 1444,
			"bot": "278_407_23",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Mein Herz schmerzt in Erwartung der Tragödie! Ich fürchte um dich, mein Held. ",
					"femaleText": "Mein Herz schmerzt in Erwartung der Tragödie! Ich fürchte um dich, Gebieterin.",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Vor uns sehe ich unbekannte Wesen, die mir nur aus Legenden bekannt sind. Man nennt sie Kristallide und es heißt, sie hätten vor Jahrhunderten gelebt und wären dann eingeschlafen...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Pass bitte auf dich auf! Nur du kannst unser unglückliches Radtwege retten!..",
					"location": "left"
				},
				"4": {
					"location": ""
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1452": {
			"id": 1452,
			"bot": "278_411_25",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Du bist ein hervorragender Krieger, mein Retter! Ich muss oft daran denken, wieviel Übel diese Insel heimsucht... Zuerst der Dämon Sovering, dann diese Steinriesen...",
					"femaleText": "Du bist ein hervorragender Krieger, meine Retterin! Ich muss oft daran denken, wieviel Übel diese Insel heimsucht... Zuerst der Dämon Sovering, dann diese Steinriesen...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Das kann kein Zufall sein... Dahinter muss jemand stecken... Irgendeine Hand des Bösen hat den Dämon und die Riesen erweckt... Es muss ein hervorragender Schwarzmagier und Elementalist sein...",
					"location": "left"
				},
				"3": {
