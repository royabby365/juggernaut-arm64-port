		"1474": {
			"id": 1474,
			"bot": "279_415_30",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Guter Kampf, mein Held! Schau, da ist noch eines dieser seltsamen Wildschweine...",
					"femaleText": "Guter Kampf, meine Heldin! Schau, da ist noch eines dieser seltsamen Wildschweine...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Daran sind die Eicheln schuld. Die Eiche ist böse, ihre Wurzeln reichen bis in die Hölle... Und die Schweine haben von seinen Früchten genascht...",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Deswegen sind auch sie böse... Sehr, sehr böse! Lass uns irgendwo verstecken!",
					"location": "left"
				},
