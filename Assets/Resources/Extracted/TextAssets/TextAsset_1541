			"bot": "278_412_25",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Die Erde zittert... Ein Erdbeben?",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Es ist kein Erdbeben... Es sind... Schritte! Schritte eines Riesen... Er kommt näher. Ich möchte gar nicht hinsehen... Gütiger Himmel!",
