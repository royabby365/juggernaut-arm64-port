			"dialogs": {
				"1": {
					"npc": "1270",
					"maleText": "Zykloptiken: Freude, Freude! Ein lebender Mensch! - Ich beiße dir ins Bein! - Ich sauge am Auge! - Ich reiß dein Ohr ab! Freude! Ein Mensch!",
