				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1156": {
			"id": 1156,
			"bot": "236_240_9",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Ich mag nicht drüber reden, was im Dorf passiert ist. Ich bin ohne Erlaubnis weggegangen, um Beeren zu sammeln. Als ich zurück kam, waren alle Menschen auf einmal böse. Sehr böse.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Sie waren außer sich. Als ob sich Wölfe für Menschen ausgeben würden, wie im Märchen. Ich habe geschrien, doch keiner hat mir geantwortet.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Die Dörfler waren wie verhext... Sie haben sich auf mich gestürzt, ich konnte knapp fliehen.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Wenn ich daran denke, umarme ich meinen Bären und weine... Du wirst mir nichts tun, oder?... Ich freue mich, dass ich dich getroffen habe. Auch Mama sagt, dass es gut ist.",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1157": {
			"id": 1157,
			"bot": "236_241_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Du fragst, wo meine Mama ist? Sie ist hier, spricht nur mit mir. Wenn du ihr etwas sagen willst, gebe ich es weiter.",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Warum schaust du mich so an? Das mag ich nicht... Es könnten schlimme Dinge geschehen!",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1158": {
			"id": 1158,
			"bot": "236_49_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Halt! Hörst du? Der Sumpfmensch stöhnt... Mama hat ihn mir gezeigt. Er ist früher normal gewesen, ertrank im Sumpf und veränderte sich. Er ist schrecklich und möchte uns töten...",
					"location": "left"
