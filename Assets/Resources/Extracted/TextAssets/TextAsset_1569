		"1147": {
			"id": 1147,
			"bot": "52_125_5",
			"dialogs": {
				"1": {
					"npc": "1270",
					"maleText": "独眼人：有趣，有趣！是活生生的人！我要咬你的腿！我要弄盲你双眼！我要拔掉你的耳朵！有趣，有趣！準备受死吧！",
					"location": "right"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1155": {
			"id": 1155,
			"bot": "236_239_8",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "我知道你会来，妈妈跟我说过我会有朋友...我叫优娜，是从附近的村庄来的...我不会再回去那裡了。我要跟你走。",
					"femaleText": "我知道你会来，妈妈跟我说过我会有朋友...我叫优娜，是从附近的村庄来的...我不会再回去那裡了。我要跟你走。",
					"location": "left"
				},
				"2": {
					"location": ""
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1156": {
			"id": 1156,
			"bot": "236_240_9",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "我想我不应该讲村裡发生了什麼事。我偷偷的去了森林摘野莓，当我回来的时候，所有人都变坏了，变得很坏。",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "他们完全不一样了，都只是在假装当人，就跟《小红帽》裡的大野狼一样。我喊过他们，但没人回应我。",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "村裡的人都变了...他们衝向了我，我差点就逃不掉了。",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "一想起这件事我就会抱着熊宝宝哭...你不会伤害我的吧？可以遇到你真好。妈妈都说这很好。",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1157": {
			"id": 1157,
			"bot": "236_241_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "你问我妈妈在哪？她在这，她会和我说话。如果你有话要跟她说，我会帮你传话。",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "你為什麼这样看着我？我不喜欢人家这样看着我...会发生恐怖的事！",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1158": {
			"id": 1158,
			"bot": "236_49_10",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "停下来，你听到吗？沼泽那人在呻吟...妈妈让带我见过他，他以前和其他人一样，可是在沼泽淹死后就不一样。他很可怕，想把我们都杀掉...",
					"location": "left"
				},
				"2": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1159": {
			"id": 1159,
			"bot": "275_398_14",
			"dialogs": {
				"1": {
					"npc": "1271",
					"maleText": "交出你身上的东西！我只会讲一次！依我的说话做，我就让你活着离开。不过够胆放慢手脚的话，我就要你爬出去。如果你不听话，就準备受死吧！",
					"location": "right"
				},
				"2": {
