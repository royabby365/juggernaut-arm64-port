			"minVersion": null,
			"maxVersion": null
		},
		"1378": {
			"id": 1378,
			"bot": "275_399_14",
			"dialogs": {
				"1": {
					"npc": "1272",
					"maleText": "你以為你应付到其他人，你就可以应付我吗？你知道有多少人死在我的手下吗？多得没坟墓够地方埋葬他们！",
					"femaleText": "你以為你应付到其他人，你就可以应付我吗？你知道有多少人死在我的手下吗？多得没坟墓够地方埋葬他们！",
					"location": "right"
				},
				"2": {
					"npc": "1272",
					"maleText": "我要把你碎尸万段！把你的头造成酒碗、把你的牙串成项鍊、把你的骨头造成笛子！",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
