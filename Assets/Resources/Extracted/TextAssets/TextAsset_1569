		"1320": {
			"id": 1320,
			"bot": "276_124_13",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "你战斗的方式真奇怪，挥剑挥得像跳舞一样！真可惜妈妈不让我教你我们战斗的一套...",
					"location": "left"
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1325": {
			"id": 1325,
			"bot": "276_493_15",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "他在跟着我们，你听到他的脚步吗？我听到他们。我感到他的存在，他不舒服，他在受苦。",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "他饿荒了。他一直都是吃人，可是他很久没见过人了，只有蜘蛛和蝙蝠。他会吃了我们...一定会！",
					"location": "left"
				},
				"3": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
		"1328": {
			"id": 1328,
			"bot": "1181_498_19",
			"dialogs": {
				"1": {
					"npc": "1185",
					"maleText": "活生生的肉...暖暖的...我真的很希望吃点暖的东西...人类，你来得正是时候...就让我吃了你吧...",
					"location": "right"
				},
				"2": {
					"location": ""
