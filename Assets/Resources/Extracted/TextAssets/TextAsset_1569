		"1383": {
			"id": 1383,
			"bot": "277_400_16",
			"dialogs": {
				"1": {
					"npc": "1187",
					"maleText": "杂鱼，见到索伐灵大人还不下跪！",
					"femaleText": "杂鱼，见到索伐灵大人还不下跪！",
					"location": "right"
				},
				"2": {
					"npc": "1187",
					"maleText": "大人可以透过我的眼睛看到你，你要你跪下！你够胆反抗的话，他就会赐我力量，让我把你碎尸万段！",
					"location": "right"
				},
				"3": {
					"location": ""
				},
				"4": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
