			"maxVersion": null
		},
		"1317": {
			"id": 1317,
			"bot": "276_369_12",
			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "我喜欢这样跟着你走，这样好像小孩子跟大人散步那样。",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "妈妈说我吓到你了，你真的害怕一个小女孩吗？",
					"femaleText": "妈妈说我吓到你了，你真的害怕一个小女孩吗？",
					"location": "left"
				},
				"3": {
					"location": ""
