
////////////////////////////////////////////////////////////////////
// ATTACKS
////////////////////////////////////////////////////////////////////

//-----MAIN ATTACKS-----//

$attack {
 play(attack,10);
 scenario(global_sound_attack_firefly);
 react(f,1);
 scenario(template_attack_splash_small);
}

$attack_left {
 play(attack_left,5);
 scenario(global_sound_attack);
 react(r,1);
 scenario(template_attack_splash_medium);
}

$attack_right {
 play(attack_right,5);
 scenario(global_sound_attack);
 react(l,1);
 scenario(template_attack_splash_medium);
}

$attack_force {
 play(attack_force,15);
 scenario(global_sound_attack_firefly);
 react(f,1);
 scenario(template_attack_splash_big);
}

$attack_uppercot {
 play(attack_uppercot,10);
 scenario(global_sound_attack_firefly);
 react(f,1);
 scenario(template_attack_splash_big);
}

//-----TEMPLATES-----//

$template_attack_splash_small {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_small);
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_medium {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_med);
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

$template_attack_splash_big {
 #ifnotreact(1,1); 
	 enemyscenario(global_attack_splash_big);
	 #random(0); wait(0.3); pause(8,0.2); random#;
 ifnotreact#;
}

////////////////////////////////////////////////////////////////////
// MAGIC
////////////////////////////////////////////////////////////////////

$magic_energyball {
 light(0,1.5);
 scenario(global_magic_direct_prestart_ffboss);
 play(magic_attack,40);
 react(f,0);
 wait(0.3);
 scenario(global_sound_attack);
 scenario(global_magic_direct_start_ffboss);
 scenario(global_magic_direct_fly_ffboss);
 wait(0.15);
 #ifreact(0,1);
  scenario(global_magic_direct_expsmall_ffboss);
 ifreact#; 
 #ifnotreact(0,1);
  scenario(global_magic_direct_exp_ffboss);
 ifnotreact#;
 light(1,1,0.3);
}

$magic_aoe_energy {
 light(0,2);
 scenario(global_magic_aoe_prestart_ffboss);
 scenario(global_sound_attack);
 play(magic_aoe,22);
 wait(1.2);
 scenario(global_sound_attack);
 react(f,0);
 wait(0.3);
 scenario(global_magic_aoe_wave_ffboss);
 wait(0.2);
 scenario(global_magic_aoe_exp_ffboss);
 light(1,0.5,0);
}

$magic_baf_energy {
 light(0,1.5);
 play(magic_baf,45);
 scenario(global_sound_attack);
 scenario(global_magic_baf_ffboss);
 light(1,1,0.3);
}

////////////////////////////////////////////////////////////////////
// REACTIONS
////////////////////////////////////////////////////////////////////

$react_block {
 reactfx();
 play(block,20);
 scenario(global_sound_attack);
 vibration(1,2,0);
 scenario(global_react_block);
} 

$react_dodge {
 reactfx();
 play(dodge);
 sound(local_dodge);
 wait(1.3);
 fx(sm1,fx_movesmoke1,bottom);
}

$react_dmg {
 wait(0.3);
 reactfx();
 scenario(global_sound_damage);
 play(damage);
}

$react_dmgf {
 wait(0.3);
 reactfx();
 scenario(global_sound_damage);
 play(damage_force);
 wait(0.2);
 fx(sm1,fx_movesmoke1,bottom);  fxpos(sm1,-1,0,0,1);
 vibration(1,2,0);
}

$react_dmgl {
 wait(0.3);
 reactfx();
 scenario(global_sound_damage);
 play(damage_force);
 step(0,-1,0,3);
 wait(0.2);
 fx(sm1,fx_movesmoke1,bottom);  fxpos(sm1,-1,0,0,1);
 vibration(1,2,0);
 wait(1.2);
 enemyscenario(ifx_step_r);
}

$react_dmgr {
 wait(0.3);
 reactfx();
 scenario(global_sound_damage);
 play(damage_force);
 step(0,1,0,3);
 wait(0.2);
 fx(sm1,fx_movesmoke1,bottom);  fxpos(sm1,-1,0,0,1);
 vibration(1,2,0);
 wait(1.2);
 enemyscenario(ifx_step_l);
}

$react_dmgu {
 wait(0.3);
 reactfx();
 scenario(global_sound_damage);
 play(damage_uppercot);
 vibration(1,2,0);
 wait(0.8);
 fx(sm1,fx_movesmoke1,bottom);  fxpos(sm1,-0.5,0,0,1);
}

$react_death  { 
 wait(0.5);
 reactfx();
 scenario(global_sound_attack);
 play(death,80);
 sound(local_death);
 wait(0.5);
 fx(gd1,fx_firefly29spawn,pos_spinecenter);
 destroy(effects);
 destroy(bone_add);
}

$react_deathf {
 wait(0.3);
 reactfx();
 scenario(global_sound_attack);
 play(death_force);
 wait(1);
 fx(sm1,fx_movesmoke1,bottom);  fxpos(sm1,-1.5,0,0,1);
 vibration(1,2,0);
 wait(0.5);
 sound(local_death);
 wait(0.5);
 fx(gd1,fx_firefly29spawn,pos_spinecenter);
 wait(0.5);
 destroy(effects);
 destroy(bone_add);
}

$react_deathl { scenario(react_death); }
$react_deathr { scenario(react_death); }
$react_deathu { scenario(react_death); }

////////////////////////////////////////////////////////////////////
// INDIVIDUAL EFFECTS
////////////////////////////////////////////////////////////////////

$ifx_step_r {
  step(0,-1);
}

$ifx_step_l {
  step(0,1);
}

$ifx_fatality_fly {
 moveto(0,3,0,1);
 playpart(damage,0.65,10,30);
 playpart(damage,0.65,10,30);
 moveto(0,-3,0,0.1); 
 playpart(death,1,50,100);
}

$ifx_fatality_down_blood {
 playpart(damage,0.75,10,30);
 playpart(damage,0.75,10,30);
 playpart(damage,0.75,10,30);
}

////////////////////////////////////////////////////////////////////
// TRIGGERS AND OTHER
////////////////////////////////////////////////////////////////////

$onshow {
 scenario(global_onshow);
}

$onidle {
 sound(local_idle);
}

$onhide {
 scenario(global_onhide);
}