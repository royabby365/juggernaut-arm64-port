		"1425": {
			"id": 1425,
			"bot": "277_469_20",
			"dialogs": {
				"1": {
					"npc": "1186",
					"maleText": "Bekle! İleri gitmekten başka seçeneğin olmadığını biliyorum ama senin için endişeleniyorum koruyucum! Seni kaybetmek tam bir kabus olur...",
					"femaleText": "Bekle! İleri gitmekten başka seçeneğin olmadığını biliyorum ama senin için endişeleniyorum koruyucum! Seni kaybetmek tam bir kabus olur...",
					"location": "left"
				},
				"2": {
					"npc": "1186",
					"maleText": "Neden mi bu kadar endişeliyim? İnan bana haksız yere değil. Boynuzlu Koren geliyor. O, Sovernig'ten haberimiz bile yokken yapılan turnuvaların tartışmasız galibi idi...",
					"location": "left"
				},
				"3": {
					"npc": "1186",
					"maleText": "Boynuzlu Koren o kadar kuvvetlidir ki, kılıcı bir tüy sallıyormuş gibi kullanır!",
					"location": "left"
				},
				"4": {
					"npc": "1186",
					"maleText": "Bu kılıç, bir biniciyi atıyla beraber ikiye ayırabilir! Kendi gözlerimle gördüm!",
					"location": "left"
				},
				"5": {
					"npc": "1186",
					"maleText": "Koren insan iken herkesi tek vuruşta öldürebiliyordu. Artık Sovernig ve onun şeytani güçlerinin kontrolü altında. Senden tek isteğim dikkatli olman. Benim için, Radvaya için...",
					"femaleText": "Koren insan iken herkesi tek vuruşta öldürebiliyordu. Artık Sovernig ve onun şeytani güçlerinin kontrolü altında. Senden tek isteğim dikkatli olman. Benim için, Radvaya için...",
					"location": "left"
				}
			},
