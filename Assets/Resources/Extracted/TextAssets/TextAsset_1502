			"dialogs": {
				"1": {
					"npc": "1152",
					"maleText": "Köyde neler olduğunu söylemesem daha iyi. İzin almadan kaçtım, ormanda böğürtlen toplamak için. Döndüğümde insanlar kötüleşmişti. Çok kötülerdi...",
					"location": "left"
				},
				"2": {
					"npc": "1152",
					"maleText": "Bambaşka bir şey olmuşlardı. İnsanmış gibi davranıyorlardı ama peri masallarındaki kurtlar gibiydiler. Çok bağırdım ama sesimi duyan olmadı.",
					"location": "left"
				},
				"3": {
					"npc": "1152",
					"maleText": "Köyün insanları çok değişmişti... Bana saldırdılar. Canımı zor kurtardım.",
					"location": "left"
				},
				"4": {
					"npc": "1152",
					"maleText": "Bunlar aklıma geldikçe oyuncak ayıcığıma sarılıp hıçkırarak ağlıyorum... Beni incitmeyeceksin değil mi? Sana rastladığım için mutluyum. Annem de bunun iyi olduğunu söylüyor.",
					"location": "left"
				},
				"5": {
					"location": ""
				}
			},
			"minVersion": null,
			"maxVersion": null
		},
